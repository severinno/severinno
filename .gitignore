# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets NEVER tracked (rotated via scripts/rotate-secrets.mjs)
.env*
# ...mas os templates .example são seguros e devem continuar rastreáveis
!.env.glitchtip.example
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Temp files created by setup.sh / check-health.sh
.tmp/

# Two-phase commit temp files (fix-two-phase.py)
fix-two-phase.py
*.fix-tmp
*.fix-orig

# Geo benchmark output — transient artifacts, compare against version-controlled baseline
docs/benchmarks/geo-latest.json

# Geo metrics snapshots — runtime performance data, regenerated on each server start
docs/benchmarks/metrics/

# Runtime data directory (cache, temp files, generated assets)
data/

# Freebuff Desktop — local app state, not project source
.freebuff/

# Playwright test artifacts — generated on every E2E run
test-results/

# AI agent skills and configurations
.agents/
# Freebuff agent tool outputs (act binary, lint/tsc reports) — never commit
tool-results/

# Lighthouse CI generated reports (lighthouserc.json outputDir) — never commit
lhci-reports/

# Runtime artifacts — process IDs and error logs regenerated on each run
*.pid
.zscripts/dev.pid
mini-services/realtime/service.pid
mini-services/realtime/realtime.err
/dev.err
/dev2.err

# Scratch/debug files at repo root (removed from tracking in 08/2026)
/output.txt
/verify-screenshot.png
/test-prisma7.mjs
# Duplicado da raiz — o baseline versionado é docs/benchmarks/geo-benchmark.json
/geo-benchmark.json

# Python bytecode (check_crlf.py / check_blob_crlf.py compile cache)
__pycache__/
*.pyc
