# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Temp files created by setup.sh / check-health.sh
.tmp/

# Two-phase commit temp files (fix-two-phase.py)
fix-two-phase.py
*.fix-tmp
*.fix-orig

# Geo benchmark output — transient artifacts, compare against version-controlled baseline
docs/benchmarks/geo-latest.json

# Geo metrics snapshots — runtime performance data, regenerated on each server start
docs/benchmarks/metrics/

# Runtime data directory (cache, temp files, generated assets)
data/

# Freebuff Desktop — local app state, not project source
.freebuff/

# Playwright test artifacts — generated on every E2E run
test-results/

# AI agent skills and configurations
.agents/