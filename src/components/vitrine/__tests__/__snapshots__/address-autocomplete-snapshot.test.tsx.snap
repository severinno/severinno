      autocomplete="off"
      class="h-12 border-0 bg-transparent pr-16 pl-10 text-left shadow-none focus-visible:ring-0"
      placeholder="CEP, cidade ou endereço…"
      role="combobox"
      value="Av. Paulista"
    />
    <span
      class="absolute top-1/2 right-2.5 flex -translate-y-1/2 items-center gap-0.5"
    >
      <button
        aria-label="Usar localização atual"
