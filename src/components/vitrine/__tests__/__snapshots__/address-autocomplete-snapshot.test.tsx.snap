          >
            São Paulo, SP
          </p>
        </div>
        <span
          aria-label="Alta relevância"
          class="shrink-0 self-center text-[11px] text-amber-500"
          title="Alta relevância"
        >
          ★
        </span>
      </button>
      <button
        aria-selected="false"
