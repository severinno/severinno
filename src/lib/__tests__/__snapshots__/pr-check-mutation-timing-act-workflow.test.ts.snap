// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pr-check.yml — job mutation-coord-timing-act-guard (sintaxe YAML + snapshot) > parseia como YAML válido e o job casa com o snapshot da estrutura 1`] = `
{
  "name": "Mutation coord timing (act, budget 240/mediana 4)",
  "permissions": {
    "contents": "read",
    "packages": "read",
  },
  "runs-on": "self-hosted",
  "steps": [
    {
      "uses": "actions/checkout@v4",
      "with": {
        "fetch-depth": 0,
      },
    },
    {
      "id": "changes",
      "name": "Detect mutation-timing relevant changes",
      "run": "set -euo pipefail
if ! git diff --name-only origin/main...HEAD > /tmp/pr-diff.txt 2>/tmp/pr-diff.err; then
  echo "::error::não foi possível calcular o diff origin/main...HEAD"
  cat /tmp/pr-diff.err
  exit 1
fi
if grep -qE '^(\\.github/workflows/seed-guards\\.yml|scripts/measure-mutation-timing\\.mjs|scripts/test-mutation-timing-budget\\.sh|scripts/test-mutation-coord-update\\.sh|scripts/seed-e2e-count\\.ts|scripts/check-e2e-counts\\.mjs)' /tmp/pr-diff.txt; then
  echo "changed=true" >> "$GITHUB_OUTPUT"
  echo "  ✅ PR toca o contrato coordenado — rodando act benchmark"
else
  echo "changed=false" >> "$GITHUB_OUTPUT"
  echo "  ℹ️ PR não toca o contrato coordenado — guard pulado"
fi
",
    },
    {
      "if": "steps.changes.outputs.changed == 'true'",
      "name": "Validate BUN_VERSION variable",
      "run": "set -euo pipefail
if [ -z "\${{ vars.BUN_VERSION }}" ]; then
  echo "::error::Repository variable BUN_VERSION não definida — crie em Settings → Secrets and variables → Actions (ex.: gh variable set BUN_VERSION 1.3.14)."
  exit 1
fi
echo "  ✅ BUN_VERSION=\${{ vars.BUN_VERSION }}"
",
    },
    {
      "if": "steps.changes.outputs.changed == 'true'",
      "name": "Install act (v0.2.89)",
      "run": "set -euo pipefail
curl -fsSL -o /tmp/act.tar.gz \\
  "https://github.com/nektos/act/releases/download/v0.2.89/act_Linux_x86_64.tar.gz"
tar -xzf /tmp/act.tar.gz -C /tmp act
/tmp/act --version
",
    },
    {
      "id": "act",
      "if": "steps.changes.outputs.changed == 'true'",
      "name": "Run act -j mutation-coord-update (imagem custom)",
      "run": "set +e
printf '{"workflow_call": {}}' > /tmp/wfc-event.json
timeout 900 /tmp/act -b \\
  -W .github/workflows/seed-guards.yml \\
  -j mutation-coord-update \\
  --eventpath /tmp/wfc-event.json \\
  -P "ubuntu-latest=\${{ env.IMAGE_REGISTRY }}/\${{ env.IMAGE_NAMESPACE }}/ubuntu-bun:\${{ vars.BUN_VERSION }}" \\
  --var "BUN_VERSION=\${{ vars.BUN_VERSION }}" \\
  --secret "GITHUB_TOKEN=\${{ github.token }}" \\
  > /tmp/act-mutation.log 2>&1
ACT_EXIT=$?
echo "ACT_EXIT=\${ACT_EXIT}" >> "$GITHUB_OUTPUT"
echo "  act exit: \${ACT_EXIT} (o guard decide o verdict)"
echo "  log: /tmp/act-mutation.log ($(wc -l < /tmp/act-mutation.log) linhas)"
",
    },
    {
      "if": "steps.changes.outputs.changed == 'true'",
      "name": "Guard mutation coord timing (act log, 240/mediana 4)",
      "run": "node scripts/measure-mutation-timing.mjs \\
  --act-log /tmp/act-mutation.log \\
  --max 240 \\
  --warn-median 4 \\
  --warn-margin 0.2 \\
  --act-exit "\${{ steps.act.outputs.ACT_EXIT }}" \\
  --json /tmp/mutation-timing-act.json
",
    },
    {
      "name": "Summary",
      "run": "if [ "\${{ steps.changes.outputs.changed }}" = "true" ]; then
  echo "✅ Mutation coord budget validated via act on the custom image (PR sem seed-guards na default)."
else
  echo "ℹ️ Skipped — PR does not touch the coordinated contract (seed-guards.yml/measure script)."
fi
",
    },
  ],
  "timeout-minutes": 25,
}
`;
