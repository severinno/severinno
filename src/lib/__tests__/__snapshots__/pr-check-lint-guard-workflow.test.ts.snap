// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pr-check.yml — job lint-guard (sintaxe YAML + snapshot) > parseia como YAML válido e o job casa com o snapshot da estrutura 1`] = `
{
  "name": "Lint Guard (prettier + eslint zero)",
  "runs-on": "self-hosted",
  "steps": [
    {
      "uses": "actions/checkout@v4",
    },
    {
      "name": "Restore Bun cache",
      "uses": "actions/cache@v4",
      "with": {
        "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
        "path": "~/.bun",
      },
    },
    {
      "name": "Setup Bun",
      "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
      "shell": "bash",
    },
    {
      "name": "Cache node_modules",
      "uses": "actions/cache@v4",
      "with": {
        "key": "bun-\${{ vars.BUN_VERSION }}-\${{ hashFiles('bun.lock') }}",
        "path": "node_modules",
        "restore-keys": "bun-\${{ vars.BUN_VERSION }}-",
      },
    },
    {
      "name": "Install deps",
      "run": "bun install --frozen-lockfile",
    },
    {
      "name": "Check lint (prettier + eslint zero)",
      "run": "bun run lint",
    },
    {
      "name": "Lint scope (o lint cobre o que o hook julga)",
      "run": "node scripts/check-lint-scope.mjs",
    },
    {
      "name": "Gerado dentro do lint (todo gerador formatado)",
      "run": "node scripts/check-generated-format.mjs",
    },
    {
      "name": "Mutation test — o guard do gerado MORDE (fixtures)",
      "run": "bash scripts/test-mutation-generated-format.sh",
    },
    {
      "name": "Summary",
      "run": "echo "✅ All files formatted (prettier) and zero eslint warnings/errors."",
    },
  ],
}
`;
