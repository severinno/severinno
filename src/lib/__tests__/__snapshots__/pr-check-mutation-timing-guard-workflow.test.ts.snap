// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`pr-check.yml — job mutation-coord-timing-guard (sintaxe YAML + snapshot) > parseia como YAML válido e o job casa com o snapshot da estrutura 1`] = `
{
  "if": "always()",
  "name": "Mutation coord timing (drift 50%/teto 240)",
  "needs": "seed-guards",
  "permissions": {
    "actions": "read",
    "contents": "read",
  },
  "runs-on": [
    "self-hosted",
    "docker",
  ],
  "steps": [
    {
      "uses": "actions/checkout@v4",
    },
    {
      "env": {
        "GH_TOKEN": "\${{ github.token }}",
      },
      "id": "measure",
      "name": "Medir tempo do step mutation test (drift relativo vs mediana)",
      "run": "node scripts/measure-mutation-timing.mjs \\
  --run "\${{ github.run_id }}" \\
  --repo "\${{ github.repository }}" \\
  --max 240 \\
  --fail-drift "\${{ vars.MUTATION_TIMING_DRIFT_MAX || '50' }}" \\
  --window 4 \\
  --json /tmp/mutation-timing.json
",
    },
    {
      "if": "always()",
      "name": "Upload timing JSON (artifact)",
      "uses": "actions/upload-artifact@v4",
      "with": {
        "if-no-files-found": "ignore",
        "name": "mutation-coord-timing-pr",
        "path": "/tmp/mutation-timing.json",
      },
    },
    {
      "if": "always()",
      "name": "Summary",
      "run": "{
  echo '## ⏱️ Mutation coord — budget de payload (PR, 240/mediana drift)'
  echo ''
  if [ -f /tmp/mutation-timing.json ]; then
    node -e "
      const r = require('/tmp/mutation-timing.json');
      if (r.found) {
        console.log('| Campo | Valor |');
        console.log('|---|---|');
        console.log('| Step | ' + r.stepName + ' |');
        console.log('| Duração | **' + r.durationSecs + 's** (duro ' + (r.budgetSecs ?? 'n/a') + 's / soft ' + (r.warnSecs ?? 'n/a') + 's) |');
        if (typeof r.driftPct === 'number') {
          console.log('| Atual vs mediana | **' + r.durationSecs + 's vs ' + r.driftMedianSecs + 's** (janela ' + (r.driftWindow ?? 'n/a') + ' runs anteriores) |');
          console.log('| Drift relativo | **' + r.driftPct.toFixed(1) + '%** (threshold ' + r.driftMaxPct + '%) |');
        }
        console.log('| Conclusão | ' + r.conclusion + ' |');
        console.log('| Run | ' + r.runId + ' |');
        if (r.zone === 'fail') console.log('| Budget | ❌ **EXCEDIDO** (faixa dura) — regressão de overhead |');
        else if (r.zone === 'warn') console.log('| Budget | ⚠️ faixa SOFT (::warning::) — observa o drift antes do gate |');
        else console.log('| Budget | ✅ dentro do limite |');
      } else {
        console.log('⚠ Medição falhou: ' + (r.error || 'sem detalhes'));
      }
    "
  else
    echo '⚠ Medição não produziu JSON — veja o passo "Medir tempo do step mutation test".'
  fi
} >> "$GITHUB_STEP_SUMMARY"
",
    },
  ],
  "timeout-minutes": 5,
}
`;
