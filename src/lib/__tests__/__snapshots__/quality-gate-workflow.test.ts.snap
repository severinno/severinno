// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`quality-gate.yml — sintaxe YAML + snapshot > parseia como YAML válido (js-yaml não lança) e casa com o snapshot 1`] = `
{
  "jobs": {
    "barrel-lint": {
      "name": "Barrel Lint",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "name": "Barrel imports + script headers",
          "run": "node scripts/barrel-lint.mjs",
        },
      ],
    },
    "cache-manifest": {
      "name": "Cache Manifest",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "name": "Validate cache manifest against route handlers",
          "run": "npx tsx scripts/validate-cache-manifest.ts",
        },
      ],
    },
    "coverage-badge": {
      "name": "Coverage Badge",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "name": "Generate coverage badge SVG",
          "run": "npx tsx scripts/coverage-badge.ts --save",
        },
        {
          "name": "Upload badge artifact",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "badge-coverage",
            "path": "docs/badge-coverage.svg",
            "retention-days": 1,
          },
        },
      ],
    },
    "coverage-gaps": {
      "name": "Coverage Gaps",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "name": "Validate all API routes have test coverage",
          "run": "npx tsx scripts/coverage-gaps.ts --ci",
        },
      ],
    },
    "security-audit": {
      "name": "Security Audit",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "name": "Audit dependencies for known vulnerabilities",
          "run": "bun run security:audit",
        },
      ],
    },
  },
  "name": "Quality Gate",
  "on": {
    "workflow_call": null,
  },
}
`;
