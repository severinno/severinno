// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ci.yml — sintaxe YAML + snapshot > parseia como YAML válido (js-yaml não lança) e casa com o snapshot 1`] = `
{
  "concurrency": {
    "cancel-in-progress": true,
    "group": "\${{ github.workflow }}-\${{ github.ref }}",
  },
  "env": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/severinno_test",
    "NODE_VERSION": 22,
    "REDIS_URL": "redis://localhost:6379",
    "SESSION_SECRET": "ci-session-secret-at-least-32-characters-long",
  },
  "jobs": {
    "build": {
      "name": "Build",
      "needs": [
        "lint",
        "typecheck",
        "utf8-check",
        "quality-gate",
        "test",
      ],
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "run": "bun run db:generate",
        },
        {
          "env": {
            "BUILD_STANDALONE": "true",
            "SKIP_TYPESCRIPT_CHECK": "true",
          },
          "run": "bun run build",
        },
        {
          "name": "Check bundle size budget",
          "run": "bash scripts/check-bundle-size.sh",
        },
        {
          "uses": "actions/upload-artifact@v4",
          "with": {
            "name": "standalone-build",
            "path": ".next/standalone/",
            "retention-days": 3,
          },
        },
      ],
    },
    "lighthouse": {
      "if": "github.event_name == 'pull_request'",
      "name": "Lighthouse Audit",
      "needs": [
        "build",
      ],
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "run": "bun run db:generate",
        },
        {
          "env": {
            "DATABASE_URL": "\${{ env.DATABASE_URL }}",
            "PORT": 3456,
            "REDIS_URL": "\${{ env.REDIS_URL }}",
            "SESSION_SECRET": "\${{ env.SESSION_SECRET }}",
            "SKIP_TYPESCRIPT_CHECK": "true",
          },
          "name": "Start server",
          "run": "bun run build &
sleep 5
bun run start -- -p 3456 &
sleep 10
",
        },
        {
          "env": {
            "LHCI_GITHUB_APP_TOKEN": "\${{ secrets.LHCI_GITHUB_APP_TOKEN }}",
          },
          "name": "Lighthouse CI",
          "run": "npx lhci autorun",
        },
      ],
    },
    "lint": {
      "name": "Lint",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "run": "bun run lint",
        },
      ],
    },
    "quality-gate": {
      "uses": "./.github/workflows/quality-gate.yml",
    },
    "test": {
      "name": "Tests",
      "runs-on": "self-hosted",
      "services": {
        "postgres": {
          "env": {
            "POSTGRES_DB": "severinno_test",
            "POSTGRES_PASSWORD": "postgres",
            "POSTGRES_USER": "postgres",
          },
          "image": "postgis/postgis:16-3.4-alpine",
          "options": "--health-cmd pg_isready --health-interval 10s --health-timeout 5s --health-retries 5",
          "ports": [
            "5432:5432",
          ],
        },
        "redis": {
          "image": "redis:7-alpine",
          "options": "--health-cmd "redis-cli ping" --health-interval 10s --health-timeout 5s --health-retries 5",
          "ports": [
            "6379:6379",
          ],
        },
      },
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "run": "bun run db:generate",
        },
        {
          "env": {
            "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/severinno_test",
          },
          "run": "bun run test:run",
        },
        {
          "name": "Generate coverage badge",
          "run": "npx tsx scripts/coverage-badge.ts --save",
        },
        {
          "if": "github.ref == 'refs/heads/main' && github.event_name == 'push'",
          "name": "Commit updated badge (push to main only)",
          "run": "git config user.name "github-actions[bot]"
git config user.email "github-actions[bot]@users.noreply.github.com"
git add docs/badge-coverage.svg
if git diff --cached --quiet; then
  echo "No changes to badge — skipping commit"
else
  git commit -m "chore: update coverage badge [skip ci]"
  git push
fi
",
        },
      ],
    },
    "typecheck": {
      "name": "TypeCheck",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Restore Bun cache",
          "uses": "actions/cache@v4",
          "with": {
            "key": "bun-\${{ vars.BUN_VERSION }}-\${{ runner.os }}-\${{ runner.arch }}",
            "path": "~/.bun",
          },
        },
        {
          "name": "Setup Bun",
          "run": "bash scripts/setup-bun-ci.sh "\${{ vars.BUN_VERSION }}"",
          "shell": "bash",
        },
        {
          "run": "bun install --frozen-lockfile",
        },
        {
          "run": "bun run db:generate",
        },
        {
          "name": "Type check",
          "run": "bun run typecheck",
        },
      ],
    },
    "utf8-check": {
      "uses": "./.github/workflows/utf8-check.yml",
    },
  },
  "name": "CI/CD",
  "on": {
    "pull_request": {
      "branches": [
        "main",
      ],
    },
    "push": {
      "branches": [
        "main",
        "develop",
      ],
    },
  },
}
`;
