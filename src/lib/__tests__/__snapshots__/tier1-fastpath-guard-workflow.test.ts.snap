// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tier1-fastpath-guard.yml — sintaxe YAML + snapshot > parseia como YAML válido (js-yaml não lança) e casa com o snapshot da estrutura 1`] = `
{
  "concurrency": {
    "cancel-in-progress": true,
    "group": "tier1-fastpath-\${{ github.ref }}",
  },
  "env": {
    "BUN_VERSION": "\${{ vars.BUN_VERSION }}",
    "IMAGE_NAMESPACE": "\${{ vars.IMAGE_NAMESPACE || github.repository_owner }}",
    "IMAGE_REGISTRY": "\${{ vars.IMAGE_REGISTRY || 'git.severinno.com' }}",
  },
  "jobs": {
    "guard": {
      "name": "Tier-1 Fastpath (act -j check, imagem custom)",
      "runs-on": "self-hosted",
      "steps": [
        {
          "uses": "actions/checkout@v4",
        },
        {
          "name": "Validate BUN_VERSION variable",
          "run": "set -euo pipefail
if [ -z "\${BUN_VERSION}" ]; then
  echo "::error::Repository variable BUN_VERSION não definida — crie em Settings → Secrets and variables → Actions (ex.: gh variable set BUN_VERSION 1.3.14)."
  exit 1
fi
echo "  ✅ BUN_VERSION=\${BUN_VERSION}"
",
        },
        {
          "name": "Install act (v0.2.89)",
          "run": "set -euo pipefail
curl -fsSL -o /tmp/act.tar.gz \\
  "https://github.com/nektos/act/releases/download/v0.2.89/act_Linux_x86_64.tar.gz"
tar -xzf /tmp/act.tar.gz -C /tmp act
/tmp/act --version
",
        },
        {
          "id": "act",
          "name": "Run act -j check (imagem custom)",
          "run": "set +e
timeout 900 /tmp/act -b \\
  -W .github/workflows/pr-check.yml \\
  -j check \\
  -P "ubuntu-latest=\${IMAGE_REGISTRY}/\${IMAGE_NAMESPACE}/ubuntu-bun:\${BUN_VERSION}" \\
  --var "BUN_VERSION=\${BUN_VERSION}" \\
  --secret "GITHUB_TOKEN=\${{ github.token }}" \\
  > /tmp/act-check.log 2>&1
ACT_EXIT=$?
echo "ACT_EXIT=\${ACT_EXIT}" >> "$GITHUB_OUTPUT"
echo "  act exit: \${ACT_EXIT} (o guard decide o verdict)"
echo "  log: /tmp/act-check.log ($(wc -l < /tmp/act-check.log) linhas)"
",
        },
        {
          "name": "Guard tier-1 fast path (threshold 5s)",
          "run": "node scripts/check-tier1-fastpath.mjs \\
  --log /tmp/act-check.log \\
  --threshold 5 \\
  --version "\${{ env.BUN_VERSION }}" \\
  --act-exit "\${{ steps.act.outputs.ACT_EXIT }}"
",
        },
        {
          "if": "failure()",
          "name": "Upload act log (on failure)",
          "uses": "actions/upload-artifact@v4",
          "with": {
            "if-no-files-found": "ignore",
            "name": "act-check-tier1-log",
            "path": "/tmp/act-check.log",
          },
        },
      ],
      "timeout-minutes": 30,
    },
  },
  "name": "Tier-1 Fastpath Guard (act)",
  "on": {
    "schedule": [
      {
        "cron": "15 6 * * 1",
      },
    ],
    "workflow_dispatch": null,
  },
  "permissions": {
    "actions": "write",
    "contents": "read",
    "packages": "read",
  },
}
`;
