// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`benchmark-scheduled.yml — job mutation-coord-timing (sintaxe YAML + snapshot) > parseia como YAML válido e o job casa com o snapshot da estrutura 1`] = `
{
  "if": "always() && github.event.schedule == '0 3 * * 0'",
  "name": "Mutation coord timing (re-medição semanal)",
  "needs": "seed-guards",
  "permissions": {
    "actions": "read",
    "contents": "read",
  },
  "runs-on": "ubuntu-latest",
  "steps": [
    {
      "uses": "actions/checkout@v4",
    },
    {
      "env": {
        "GH_TOKEN": "\${{ github.token }}",
      },
      "id": "measure",
      "name": "Medir tempo do step mutation test (budget 240/mediana 4)",
      "run": "node scripts/measure-mutation-timing.mjs \\
  --run "\${{ github.run_id }}" \\
  --repo "\${{ github.repository }}" \\
  --max 240 \\
  --warn-median 4 \\
  --warn-margin 0.2 \\
  --json /tmp/mutation-timing.json
",
    },
    {
      "if": "always()",
      "name": "Upload timing JSON (artifact)",
      "uses": "actions/upload-artifact@v4",
      "with": {
        "if-no-files-found": "ignore",
        "name": "mutation-coord-timing",
        "path": "/tmp/mutation-timing.json",
      },
    },
    {
      "if": "always()",
      "name": "Summary",
      "run": "{
  echo '## ⏱️ Mutation coord — tempo real'
  echo ''
  if [ -f /tmp/mutation-timing.json ]; then
    node -e "const r=require('/tmp/mutation-timing.json');if(r.found){console.log('| Step | '+r.stepName+' |');console.log('| Duração | **'+r.durationSecs+'s** |');console.log('| Conclusão | '+r.conclusion+' |')}else{console.log('⚠ Medição falhou')}"
  else
    echo '⚠ Medição não produziu JSON'
  fi
} >> "$GITHUB_STEP_SUMMARY"
",
    },
  ],
  "timeout-minutes": 5,
}
`;
