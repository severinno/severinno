{
  "name": "severinno",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "rm -rf .next && bun run dev",
    "dev:kill-port": "kill -9 $(lsof -ti:3000) 2>/dev/null; exit 0",
    "dev:watch:clean": "npm run dev:kill-port && npm run dev:clean",
    "dev:log": "mkdir -p .next && bun run dev 2>&1 | tee -a .next/dev-server-$(date +%Y%m%d).log",
    "build": "next build",
    "build:analyze": "node scripts/analyze-bundle.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "search:reindex": "node scripts/search-reindex.mjs",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "qa": "node scripts/qa.mjs",
    "qa:parallel": "node scripts/qa.mjs --parallel",
    "qa:sequential": "node scripts/qa.mjs --sequential",
    "check:direct-rtl-import": "node scripts/check-direct-rtl-import.mjs",
    "check:ts-nocheck": "node scripts/check-ts-nocheck.mjs",
    "check:seed-hooks": "node scripts/check-seed-hooks.mjs",
    "check:workflow-refs": "node scripts/check-workflow-refs.mjs",
    "check:workflow-refs:internal": "node scripts/check-workflow-refs.mjs --pkg-internal",
    "check:no-setup-bun": "node scripts/check-no-setup-bun.mjs",
    "check:bun-mirror": "node scripts/check-bun-mirror.mjs",
    "check:e2e-counts": "node scripts/check-e2e-counts.mjs",
    "check:seed-count-literals": "node scripts/check-seed-count-literals.mjs",
    "check:encoding-guards-badge": "node scripts/check-encoding-guards-badge.mjs",
    "check:readme-repro-marker": "node scripts/check-readme-repro-marker.mjs",
    "check:readme-anchors": "node scripts/check-readme-anchors.mjs",
    "check:readme-anchors:reverse": "node scripts/check-readme-anchors.mjs --reverse",
    "check:readme-toc": "node scripts/check-readme-toc.mjs",
    "check:readme-images": "node scripts/check-readme-images.mjs",
    "check:sentinel-producer": "node scripts/check-sentinel-producer.mjs",
    "check:crlf": "bash scripts/check-crlf.sh --ci",
    "check:crlf-scope": "node scripts/check-crlf-scope.mjs",
    "check:utf8-scope": "node scripts/check-utf8-scope.mjs",
    "check:blob-crlf": "bash scripts/check-blob-crlf.sh --ci",
    "check:single-line-out-assign": "bash scripts/check-single-line-out-assign.sh --ci",
    "test:validate-all-text-alert": "bash scripts/validate-all-text-alert.sh",
    "audit:blob-crlf-history": "bash scripts/audit-blob-crlf-history.sh",
    "audit:blob-crlf-history:all-text": "bash scripts/audit-blob-crlf-history.sh --all-text",
    "audit:secret-leaks": "node scripts/audit-secret-leaks.mjs",
    "check:secret-leaks-baseline": "node scripts/check-secret-leaks-baseline.mjs",
    "audit:secret-leaks:update-baseline": "node scripts/check-secret-leaks-baseline.mjs --update",
    "check:readme-reverse-baseline": "node scripts/check-readme-reverse-baseline.mjs",
    "audit:readme-reverse:update-baseline": "node scripts/check-readme-reverse-baseline.mjs --update",
    "check:jsdom-baseline": "node scripts/check-jsdom-baseline.mjs",
    "audit:jsdom-baseline:update": "node scripts/check-jsdom-baseline.mjs --update",
    "normalize:crlf": "bash scripts/normalize-crlf.sh",
    "check:unused-deps": "node scripts/check-unused-deps.mjs",
    "check:mutation-count": "node scripts/check-mutation-count.mjs",
    "test:mutation-unused-deps": "bash scripts/test-mutation-unused-deps.sh",
    "test:mutation-mutation-count": "bash scripts/test-mutation-mutation-count.sh",
    "check:bun-audit-baseline": "node scripts/check-bun-audit-baseline.mjs",
    "audit:bun-audit:update-baseline": "node scripts/check-bun-audit-baseline.mjs --update",
    "security:audit": "node scripts/check-bun-audit-baseline.mjs",
    "secrets:rotate": "node scripts/rotate-secrets.mjs",
    "secrets:rotate:apply": "node scripts/rotate-secrets.mjs --apply",
    "secrets:check": "node scripts/rotate-secrets.mjs --check",
