    "db:generate": "prisma generate",
    "db:setup": "bash scripts/db-setup.sh",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:prod": "bun prisma/seed-prod.ts",
    "db:seed:prod:dry": "bun prisma/seed-prod.ts --dry-run",
    "db:migrate": "prisma migrate deploy",
    "db:category:rename": "node scripts/migrate-category-rename.mjs",
    "db:reset": "prisma migrate reset",
    "consumer": "bun src/queue/consumer.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:snapshots": "vitest run src/components/admin/__tests__/*snapshot*",
    "test:snapshot-update": "vitest run --update",
    "test:admin": "vitest run src/components/admin/__tests__",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:guards": "vitest run --config vitest.config.unit.ts cli.test.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:perf": "playwright test e2e/performance.spec.ts",
    "e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:a11y": "bash scripts/test-e2e-a11y.sh",
    "db:search:index": "bun --conditions=react-server scripts/search-index.ts",
    "db:search:reset": "bun --conditions=react-server scripts/search-index.ts --delete",
    "db:search:refresh": "bun --conditions=react-server scripts/search-index.ts --refresh",
    "db:migrate-pg": "bun scripts/migrate-sqlite-to-postgres.ts",
    "test:postgis": "bun scripts/test-postgis.ts",
    "test:seed-prod-e2e": "bash scripts/test-seed-prod-e2e.sh",
    "test:seed-dev-e2e": "bash scripts/test-seed-dev-e2e.sh",
    "test:mutation-seed-dev-e2e": "bash scripts/test-mutation-seed-dev-e2e.sh",
    "test:mutation-coord-update": "bash scripts/test-mutation-coord-update.sh",
    "test:mutation-bun-literal": "bash scripts/test-mutation-bun-literal.sh",
    "test:mutation-bun-removal": "bash scripts/test-mutation-bun-removal.sh",
    "test:mutation-guards": "bash scripts/test-mutation-guards.sh",
    "test:mutation-hooks-symmetry": "bash scripts/test-mutation-hooks-symmetry.sh",
    "test:mutation-readme-anchors": "bash scripts/test-mutation-readme-anchors.sh",
