    "benchmark:geo": "node scripts/run-benchmark.mjs --type geo",
    "benchmark:geo:json": "node scripts/run-benchmark.mjs --type geo --json",
    "benchmark:geo:save": "node scripts/run-benchmark.mjs --type geo --save",
    "benchmark:geo:baseline": "node scripts/run-benchmark.mjs --type geo --baseline",
    "benchmark:geo:compare": "node scripts/run-benchmark.mjs --type geo --json --compare",
    "benchmark:cache": "node scripts/run-benchmark.mjs --type cache",
    "benchmark:cache:json": "node scripts/run-benchmark.mjs --type cache --json",
    "benchmark:cache:save": "node scripts/run-benchmark.mjs --type cache --save",
    "benchmark:cache:baseline": "node scripts/run-benchmark.mjs --type cache --baseline",
    "benchmark:cache:compare": "node scripts/run-benchmark.mjs --type cache --json --compare",
    "benchmark:multi-cache": "node scripts/benchmark-multi-cache.mjs",
    "benchmark:all": "node scripts/run-benchmark.mjs --type all",
    "benchmark:all:json": "node scripts/run-benchmark.mjs --type all --json",
    "benchmark:all:compare": "node scripts/run-benchmark.mjs --type all --json --compare",
    "benchmark:all:skip-db": "node scripts/run-benchmark.mjs --type all --json --skip-db",
    "benchmark:all:quick": "node scripts/run-benchmark.mjs --type all --json --skip-db",
    "repro:setup-bun": "bash scripts/act-repro-setup-bun.sh",
    "bench:act-startup": "bash scripts/act-startup-bench.sh",
    "bench:encoding-guards": "bash scripts/bench-encoding-guards.sh",
    "benchmark:gist": "node scripts/run-benchmark.mjs --type gist",
    "benchmark:gist:json": "node scripts/run-benchmark.mjs --type gist --json",
    "benchmark:gist:save": "node scripts/run-benchmark.mjs --type gist --save",
    "benchmark:gist:compare": "node scripts/run-benchmark.mjs --type gist --json --compare",
    "benchmark:pipeline": "node scripts/run-benchmark.mjs --type pipeline",
    "benchmark:pipeline:json": "node scripts/run-benchmark.mjs --type pipeline --json",
    "benchmark:pipeline:save": "node scripts/run-benchmark.mjs --type pipeline --save",
    "benchmark:pipeline:compare": "node scripts/run-benchmark.mjs --type pipeline --json --compare",
    "benchmark:real:save": "node scripts/run-benchmark.mjs --type real --save",
    "benchmark:real:compare": "node scripts/run-benchmark.mjs --type real --json --compare",
    "compare:geo": "node scripts/compare-benchmarks.mjs docs/benchmarks/geo-baseline.json docs/benchmarks/geo-latest.json",
    "compare:cache": "node scripts/compare-benchmarks.mjs --filter cache docs/benchmarks/cache-baseline.json docs/benchmarks/cache-latest.json",
    "fuzz": "bash scripts/run-fuzz.sh",
    "fuzz:ci": "node scripts/run-all-fuzz.mjs --json",
    "barrel-lint": "node scripts/barrel-lint.mjs",
    "scan-icons": "node scripts/scan-lucide-icons.mjs",
    "scan-icons:save": "node scripts/scan-lucide-icons.mjs --save",
    "docs:generate": "bun scripts/generate-openapi.ts",
    "analyze": "ANALYZE=true bun run build",
    "docker:build": "docker build -t severinno:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "health": "curl -f http://localhost:3000/api/health",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
