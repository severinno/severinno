    "test:mutation-jsdom-baseline": "bash scripts/test-mutation-jsdom-baseline.sh",
    "test:mutation-bun-audit-baseline": "bash scripts/test-mutation-bun-audit-baseline.sh",
    "test:migrate-category-rename-e2e": "bash scripts/test-migrate-category-rename-e2e.sh",
