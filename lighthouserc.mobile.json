{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/categoria/limpeza",
        "http://localhost:3000/u/carlos-encanador"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 2.625
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --headless"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 5500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.25 }],
        "total-blocking-time": ["error", { "maxNumericValue": 1200 }],
        "speed-index": ["warn", { "maxNumericValue": 6000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports-mobile"
    }
  }
}
