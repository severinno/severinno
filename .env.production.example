# =============================================================================
# Severinno Marketplace — Variáveis de Ambiente para PRODUÇÃO
# =============================================================================
# INSTRUÇÕES DE USO NO SERVIDOR:
# 1. Copie este arquivo para .env.production.local:
#    cp .env.production.example .env.production.local
# 2. Substitua todos os placeholders <MUDE_AQUI_*> pelos valores reais do VPS.
# 3. NUNCA comite arquivos .env.production.local ou segredos reais no Git.
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# ── Origem das imagens OCI (FONTE ÚNICA) ─────────────────────────────────────
# Host e namespace das imagens da aplicação (app, worker, realtime) e dos
# mirrors de toolchain. O mesmo valor é a repo variable IMAGE_REGISTRY nos
# workflows — trocar de registry é mudar UMA coisa, não caçar referências.
#
# GHCR (default histórico, sem as variáveis o comportamento não muda):
#   IMAGE_REGISTRY=ghcr.io
#   IMAGE_NAMESPACE=severinno
# Registry OCI embutido do Gitea/Forgejo (sem cota de GHCR):
#   IMAGE_REGISTRY=git.severinno.cloud
#   IMAGE_NAMESPACE=severinno
#   docker login git.severinno.cloud    # uma vez, na VPS
# Guard: `bun run check:registry-source`.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=severinno

# ── Domínio & Aplicação (PWA, URLs Canônicas e WebSockets) ───────────────────
NEXT_PUBLIC_APP_URL=https://severinno.com.br
NEXT_PUBLIC_SITE_URL=https://severinno.com.br
NEXT_PUBLIC_WS_URL=wss://severinno.com.br
REALTIME_URL=http://realtime:3003
NEXT_PUBLIC_REALTIME_URL=wss://severinno.com.br

# ── Criptografia de Sessão & Cookies (mínimo 32 caracteres) ──────────────────
# Gerar com: openssl rand -base64 32
SESSION_SECRET=<MUDE_AQUI_SESSION_SECRET_MIN_32_CHARS>

# ── Banco de Dados (PostgreSQL 16 + PostGIS) ─────────────────────────────────
# DATABASE_URL aponta para o PgBouncer (pooler de conexões na porta 6432)
DATABASE_URL=postgresql://severinno:<MUDE_AQUI_POSTGRES_PASSWORD>@pgbouncer:6432/severinno?schema=public&sslmode=disable
# DIRECT_URL conecta direto no PostgreSQL 5432 (necessário para Prisma Migrate)
DIRECT_URL=postgresql://severinno:<MUDE_AQUI_POSTGRES_PASSWORD>@postgres:5432/severinno?schema=public&sslmode=disable

# ── Cache Distribuído & Rate Limit (Redis 7) ─────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Fila de Mensagens Assíncronas (RabbitMQ 4) ──────────────────────────────
RABBITMQ_URL=amqp://severinno:<MUDE_AQUI_RABBITMQ_PASS>@rabbitmq:5672

# ── Armazenamento de Arquivos S3 (MinIO ou AWS S3 / Cloudflare R2) ───────────
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_ACCESS_KEY=severinno
S3_SECRET_KEY=<MUDE_AQUI_S3_SECRET_KEY>
S3_BUCKET=severinno-production-uploads
S3_PUBLIC_URL=https://s3.severinno.com.br

# ── Roteamento Geoespacial OSRM ──────────────────────────────────────────────
OSRM_BASE_URL=http://osrm:5000

# ── Notificações Push (VAPID / Web Push PWA) ────────────────────────────────
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<MUDE_AQUI_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<MUDE_AQUI_VAPID_PRIVATE_KEY>
VAPID_SUBJECT=mailto:admin@severinno.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<MUDE_AQUI_VAPID_PUBLIC_KEY>

# ── Email Transacional SMTP (Hostinger / SendGrid / SES) ─────────────────────
SMTP_HOST=smtp.hostinger.com.br
SMTP_PORT=465
SMTP_USER=severinno@severinno.com.br
SMTP_PASS=<MUDE_AQUI_SMTP_PASS>
SMTP_FROM=severinno@severinno.com.br

# ── Gateway de Pagamento Lytex (PIX Dinâmico / Escrow) ───────────────────────
LYTEX_ENV=production
LYTEX_BASE_URL=https://api-pay.lytex.com.br
LYTEX_CLIENT_ID=<MUDE_AQUI_LYTEX_CLIENT_ID>
LYTEX_CLIENT_SECRET=<MUDE_AQUI_LYTEX_CLIENT_SECRET>
LYTEX_PARTNER_ID=<MUDE_AQUI_LYTEX_PARTNER_ID_OPCIONAL>
PAYMENT_WEBHOOK_SECRET=<MUDE_AQUI_PAYMENT_WEBHOOK_SECRET>

# ── WhatsApp API (Evolution API — Automações e Alertas) ─────────────────────
EVOLUTION_API_URL=https://whatsapp.severinno.com.br
EVOLUTION_API_KEY=<MUDE_AQUI_EVOLUTION_API_KEY>
EVOLUTION_INSTANCE=severinno-prod

# ── Inteligência Artificial (Chat Copilot & Diagnóstico Visual) ──────────────
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=<MUDE_AQUI_GROQ_API_KEY>

# ── Cron Jobs & Endpoints de Manutenção ─────────────────────────────────────
# Token para proteger chamadas aos endpoints /api/cron/*
CRON_SECRET=<MUDE_AQUI_CRON_SECRET>

# ── Monitoramento de Erros & APM (GlitchTip / Sentry) ────────────────────────
SENTRY_DSN=https://<MUDE_AQUI_KEY>@glitchtip.severinno.com.br/<MUDE_AQUI_ID>
NEXT_PUBLIC_SENTRY_DSN=https://<MUDE_AQUI_KEY>@glitchtip.severinno.com.br/<MUDE_AQUI_ID>
OTEL_ENABLED=true
OTEL_SERVICE_NAME=severinno-production
