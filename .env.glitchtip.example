# =============================================================================
# .env.glitchtip — GlitchTip Self-Hosted (Sentry-compatible)
# =============================================================================
# Variaveis para o perfil GlitchTip do Docker Compose.
# Copie para .env.glitchtip, preencha os valores reais, e suba:
#
#   docker compose -f docker-compose.prod.yml --profile glitchtip \
#     --env-file .env.glitchtip up -d
#
# Para gerar senhas fortes:
#   openssl rand -base64 32
#
# Setup inicial apos subir:
#   ./scripts/glitchtip-setup.sh create-admin    # Cria admin
#   ./scripts/glitchtip-setup.sh create-project   # Cria projeto + DSN
# =============================================================================


# ═══════════════════════════════════════════════════════════════════════════════
# 1. DOMAIN — Dominio onde o GlitchTip sera acessado
# ═══════════════════════════════════════════════════════════════════════════════
# Precisa de um registro DNS apontando para o mesmo IP do servidor.
# Ex: glitchtip.severinno.com.br → <IP_DO_VPS>

GLITCHTIP_DOMAIN=https://glitchtip.severinno.com.br


# ═══════════════════════════════════════════════════════════════════════════════
# 2. DATABASE — PostgreSQL do GlitchTip
# ═══════════════════════════════════════════════════════════════════════════════
# NOTA: A senha real e resolvida via Docker Secret
# (./secrets/glitchtip_db_password.secret). O valor abaixo e usado para
# interpolacao do Docker Compose e para o entrypoint do GlitchTip
# (imagem third-party que NAO suporta _FILE).

GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=<MUDE_AQUI_SENHA_DO_POSTGRES_GLITCHTIP>
GLITCHTIP_DB_NAME=glitchtip

# Pool de conexoes (maximo de conexoes simultaneas)
# Default: 10
GLITCHTIP_DB_POOL=10


# ═══════════════════════════════════════════════════════════════════════════════
# 3. SECRET KEY — Django Secret Key
# ═══════════════════════════════════════════════════════════════════════════════
# Chave usada pelo Django para criptografia de sessoes, CSRF, etc.
# IMPORTANTE: NUNCA compartilhe ou commite o valor real!
# Gerar: openssl rand -base64 64
#
# ⚠️  LIMITACAO: O GlitchTip usa imagem third-party (glitchtip/glitchtip:v5.2)
#     que NAO suporta Docker Secrets no entrypoint. Esta senha PRECISA ser
#     definida aqui (nao via secret).

GLITCHTIP_SECRET_KEY=<MUDE_AQUI_MINIMO_64_CARACTERES>


# ═══════════════════════════════════════════════════════════════════════════════
# 4. STORAGE — S3 (MinIO) para source maps e cold storage
# ═══════════════════════════════════════════════════════════════════════════════
# GlitchTip usa MinIO interno para armazenar source maps e artifacts.
# A senha real (GLITCHTIP_S3_SECRET_KEY) e resolvida via Docker Secret
# (./secrets/glitchtip_s3_secret_key.secret).

GLITCHTIP_S3_ACCESS_KEY=glitchtip_storage
GLITCHTIP_S3_SECRET_KEY=<MUDE_AQUI>
GLITCHTIP_S3_BUCKET=glitchtip-storage


# ═══════════════════════════════════════════════════════════════════════════════
# 5. EMAIL — Configuracao de email do GlitchTip
# ═══════════════════════════════════════════════════════════════════════════════
# Usado para enviar convites, alerts, recovery de senha.
# Opcional — se vazio, o GlitchTip nao envia emails.

GLITCHTIP_FROM_EMAIL=noreply@severinno.com.br
GLITCHTIP_EMAIL_URL=smtp://<USER>:<PASS>@<HOST>:<PORT>/?ssl=true


# ═══════════════════════════════════════════════════════════════════════════════
# 6. WORKER — Concorrencia do Celery
# ═══════════════════════════════════════════════════════════════════════════════

GLITCHTIP_CONCURRENCY=4


# ═══════════════════════════════════════════════════════════════════════════════
# 7. DSN — Publico (para configurar no .env.production)
# ═══════════════════════════════════════════════════════════════════════════════
# Apos rodar ./scripts/glitchtip-setup.sh create-project, voce recebera um DSN.
# Copie-o para as variaveis abaixo no .env.production:
#
#   NEXT_PUBLIC_GLITCHTIP_DSN=https://<KEY>@glitchtip.severinno.com.br/<ID>
#   GLITCHTIP_DSN=https://<KEY>@glitchtip.severinno.com.br/<ID>
#   SENTRY_DSN=https://<KEY>@glitchtip.severinno.com.br/<ID>
#
# Nao preencher aqui — preencher em .env.production apos setup!


# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. Secrets que PRECISAM ser arquivos .secret fisicos:
#    - ./secrets/glitchtip_db_password.secret     (lido via _FILE)
#    - ./secrets/glitchtip_s3_secret_key.secret   (lido via _FILE)
#    - ./secrets/glitchtip_secret_key.secret      (template apenas — NÃO usado)
#
# 2. ⚠️  LIMITACAO CONHECIDA (imagem third-party):
#    Os servicos glitchtip-web, glitchtip-worker e glitchtip-migrate usam
#    a imagem oficial glitchtip/glitchtip:v5.2 (Django). Esta imagem:
#      - NAO usa o entrypoint customizado (scripts/docker-entrypoint.sh)
#      - NAO suporta variaveis *_FILE para ler secrets
#    Por isso, GLITCHTIP_DB_PASSWORD, GLITCHTIP_SECRET_KEY e
#    GLITCHTIP_S3_SECRET_KEY sao passadas como env vars aqui.
#
# 3. Melhoria futura:
#    Fazer fork da imagem glitchtip/glitchtip para adicionar suporte
#    a _FILE no entrypoint, ou usar Docker configs + env_file gerado.
# =============================================================================
