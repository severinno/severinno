set -eu

# ── Agregação dos guards paralelos ────────────────────────────────────────
# `wait pid1 pid2 ...` devolve o status de APENAS UM dos PIDs — o ÚLTIMO da
# lista. Medido nas duas cascas que o husky usa (dash via `sh -e` e bash via
# Git for Windows): `(exit 3) & a=$!; (exit 0) & b=$!; wait $a $b` sai 0.
# Ou seja: um guard que NÃO seja o último da fase podia reprovar e o commit
# seguia — o comentário prometia "fail immediately if any exits non-zero" e o
# código não cumpria. Aqui esperamos cada PID e devolvemos o PRIMEIRO status
# não-zero, de modo que o exit code do hook seja o do guard que reprovou,
# seja qual for a posição dele na fase.
wait_all() {
  _status=0
  for _pid in "$@"; do
    _code=0
    wait "$_pid" || _code=$?
    if [ "$_code" -ne 0 ] && [ "$_status" -eq 0 ]; then
      _status=$_code
    fi
  done
  return "$_status"
}

# ============================================================================
# Pre-commit hook — Severinno Marketplace
#
# Structured in 3 phases for maximum parallelism:
#   Phase A — Staged-only guards (parallel, ~2s)
#   Phase B — Global guards (parallel, ~3s)
#   Phase C — Sequential checks (state-dependent, ~5s)
#
# Total estimated: ~8-12s (down from ~15-30s serial)
# ============================================================================

# ── Phase A: Staged guards (parallel) ─────────────────────────────────────
# These guards inspect only git diff --cached (staged changes) and are
# completely independent of each other — safe to run in parallel.
#
# A fase INTEIRA vive numa FUNCAO pelo mesmo motivo da fase B: ela roda DUAS
# vezes quando o remedio entra — uma para MEDIR (e o veredito do commit) e outra
# para REVALIDAR, com o remendo ja no INDICE. E o que impede um gate SEM FIXER de
# custar ao operador a classe que a maquina remenda: o remendo entra no indice e
# quem diz se a fase passou e a FASE, rodada de novo (o teste de completude cobra
# cada comando AQUI dentro — um guard que ficasse fora faria a reexecucao medir
# outra fase).
fase_a() {
  node scripts/check-bun-mirror.mjs --staged &
  PID_BUN=$!

  node scripts/check-mutation-jobs.mjs --staged &
  PID_MUT=$!

  node scripts/check-unused-deps.mjs --staged &
  PID_DEPS=$!

  node scripts/check-mutation-timing-contract.mjs --staged &
  PID_TIMING=$!

  # O CONTRATO DE MERGE do commit — RECORTE --staged, declarado em HOOK_DECLARED do
  # check-hook-ci-parity. Ele roda SO quando o INDICE toca o manifesto, a declaracao
  # da reaplicacao ou um workflow (nos outros commits sao um `git diff --cached
  # --name-only` e um aviso, ~30ms).
  #
  # POR QUE ELE ESTA AQUI: renomear o `name:` de um required check MUDA o contexto
  # que a forja exige, e a forja continua exigindo o ANTIGO — o PR passa a esperar
  # para sempre por um check que nunca mais roda. Esse rename era invisivel no
  # hook: `required-checks` estava em HOOK_NOT_RUN com a justificativa de que a
  # paridade de gates pegaria o efeito, e ela NAO pega (a classificacao de um gate
  # e pelo job/comando; renomear o `name:` nao muda classificacao nenhuma). Sem
  # este guard o commit saia daqui e a divergencia so aparecia no CI — ou, num PR
  # cuja base nao e `main`, no cron semanal.
  node scripts/check-required-checks.mjs --staged &
  PID_REQCHECKS=$!

  # Aguarda os CINCO e agrega os status deles (wait_all — topo).
  #
  # O `||` NAO existe mais nesta linha, e nao por descuido: dentro da funcao o
  # status de `wait_all` e o RETORNO dela, e o `set -e` esta desligado na chamada
  # (`fase_a || FASE_A=$?`) — quem registra o veredito e o call site.
  wait_all $PID_BUN $PID_MUT $PID_DEPS $PID_TIMING $PID_REQCHECKS
}

# Sintaxe dos corpos `run:` — RECORTE --staged, declarado em HOOK_DECLARED do
# check-hook-ci-parity: julga os workflows do INDICE, lendo o conteudo do
# commit (`git show :path`), nao o working tree. O corpo quebrado nasce de uma
# reescrita mecanica em massa ANTES do commit e e o COMMIT que o carrega; a
# arvore pode ter WIP que nao faz parte dele. A varredura inteira (480 corpos
# das duas forjas) continua sendo o veredito do CI.
#
# O gate de sintaxe e o SEXTO guard da fase e fica FORA do `wait_all` de
# proposito: o `wait_all` devolve o PRIMEIRO status nao-zero, entao ele diz QUE a
# fase falhou, nao QUAL guard falhou — e o de sintaxe tem o seu proprio veredito
# abaixo (com o remedio). Ele e lancado ANTES da fase A para correr em paralelo
# com ela, como sempre correu.
# A captura do PID e DEFENSIVA (`${!:-}`) e a espera e CONDICIONAL por causa da
# mutacao que mede esta linha: com a chamada acima apagada nao ha job nenhum, e o
# `$!` de um shell sob `set -u` e "variavel nao associada" — o hook morreria por
# INFRA e recusaria o commit por um motivo que nao e o veredito do gate. A prova do
# doctor leria isso como "a prova nao mede esta linha" (unavailable) em vez do que a
# mutacao significa (o defeito PASSA sem o gate). Medido: `bash -uc 'x=$!'` sai 127
# e `x="${!:-}"` sai 0 — e com o job iniciado as duas formas dao o MESMO PID, entao
# o caminho de producao e identico ao de sempre (`wait` no PID do gate, e o status
# DELE e o veredito). Com a chamada QUEBRADA em vez de apagada — o script renomeado,
# por exemplo — o job existe, o `wait` ve o 127 e o hook BLOQUEIA: onde importa, o
# fail-closed continua de pe.
PID_RUNSYNTAX=""
node scripts/check-workflow-run-syntax.mjs --staged &
PID_RUNSYNTAX="${!:-}"

FASE_A=0
fase_a || FASE_A=$?

SINTAXE=0
if [ -n "$PID_RUNSYNTAX" ]; then
  wait "$PID_RUNSYNTAX" || SINTAXE=$?
fi

# A falha dos cinco SEM REMEDIO NAO encerra o hook aqui.
#
# Ela bloqueia o commit — isso nao mudou —, mas quem diz ISSO e o veredito
# explicito no bloco do remedio, DEPOIS da oferta. O que mudou, e por que: o MESMO
# indice pode carregar uma classe que os guards donos sabem remendar (o corpo
# `run:` que deixou de fazer parsing, o CR/CRLF, o blob do indice, o byte
# invalido, o caminho tipado de um comando de hook, o pipe quieto sob pipefail) e
# o remedio mede cada uma com o DONO dela, independentemente das fases. Encerrar
# aqui — o que este hook fazia — fazia a oferta depender do guard que reprovou: um
# gate SEM FIXER custava ao operador o remendo de um defeito que a maquina
# remenda, e ele so descobria isso re-rodando o commit depois de consertar o
# primeiro a mao.
#
# A fase B continua NAO rodando quando a fase A reprova: o custo dela (~3s) nao e
# pago por um commit que ja esta bloqueado (o comentario da fase B diz por que).
# Quem a mede, se o remedio remediar, e o fim do bloco do remedio.

# ── Phase B: Global guards (parallel) ─────────────────────────────────────
# Encoding guards, barrel lint, and prettier check are read-only and
# independent — safe to run in parallel.
#
# A fase INTEIRA vive numa FUNCAO porque ela roda DUAS vezes quando o remedio
# entra: uma para MEDIR (e o veredito do commit) e outra para REVALIDAR, com o
# remendo ja no INDICE. A re-execucao e o que impede o remedio de declarar verde
# uma fase que tem outro gate vermelho: o remedio so LEVANTA a falha que ele
# mediu; quem diz se a fase passou e a FASE, rodada de novo.
#
# O `wait_all` (topo) devolve o PRIMEIRO status nao-zero e fecha a funcao — o
# retorno dela E o codigo da fase. Chamada em `fase_b || FASE_B=$?`, o `set -e`
# fica DESLIGADO dentro da funcao (a invocacao e parte de uma lista `||`), que e
# o que faz o status voltar em vez de encerrar o hook no meio da medicao.
#
fase_b() {
  bash scripts/run-encoding-guards.sh &
  PID_ENCODING=$!

  bun run barrel-lint &
  PID_BARREL=$!

  # Allowlist de PII em payload de usuário + fonte única do client Prisma.
  # Espelha o job `pii-allowlist-guard` do pr-check.yml (e o check:* do CI) —
  # falha AQUI evita abrir o PR já sabendo que o gate vai recusar. Read-only e
  # rápido (~2s), por isso entra na fase paralela.
  bun run check:pii-allowlist &
  PID_PII=$!

  # Fonte única do registry OCI (imagens da app + mirrors). Node puro, read-only,
  # <1s — falha aqui evita abrir um PR que reintroduz `ghcr.io` hardcoded e
  # quebra o flip de uma variável. Espelha o step do pr-check.yml.
  bun run check:registry-source &
  PID_REGISTRY=$!

  # Paridade de gates entre a forja (dona do merge) e o espelho do GitHub.
  # Node puro, read-only: falha se um invariante do CORE existir em só uma das
  # pipelines — o modo silencioso de achar que o PR foi verificado.
  bun run check:forge-parity &
  PID_FORGE=$!

  # Escopo dos guards: nenhum script pode cravar um diretório de forja (é o que
  # garante que a pipeline dona do merge não volte a ficar fora da cobertura).
  bun run check:forge-workflow-scope &
  PID_SCOPE=$!

  # Paridade hook ↔ CI: cada comando DESTE arquivo tem de ser o MESMO comando do
  # CI (ou um recorte com decisao escrita). O caso real: o pre-push rodava
  # `bunx tsc --noEmit` SEM o heap de 4GB do script `typecheck` — o mesmo commit
  # estourava a memoria no push e passava no merge. Node puro, ~0.05s: falha aqui
  # evitando um commit cujo veredito local nao e o do CI.
  node scripts/check-hook-ci-parity.mjs &
  PID_HOOKPARITY=$!

  # Os COMANDOS que os hooks executam: cada caminho citado (script de node/bash,
  # entrada do package.json, binario de bun x, arquivo de source) tem de EXISTIR.
  # Um caminho com erro de digitacao num hook nao e "um script que nao roda": e um
  # PASSO que nunca roda — e o sintoma nunca diz o nome dele. A linha e a MESMA do
  # CI (o comando canonico do CORE), entao este passo nao precisa de declaracao no
  # check-hook-ci-parity. Node puro, read-only, <0.1s.
  node scripts/check-hook-commands.mjs &
  PID_HOOKCMD=$!

  # A classe SIGPIPE (`PRODUTOR | grep -q PADRAO` sob `set -o pipefail`): o grep
  # quieto fecha o stdin no PRIMEIRO casamento, o produtor leva SIGPIPE e a soma
  # do pipeline vira 141 — de forma INTERMITENTE, porque depende do TAMANHO da
  # saida (acima do buffer do pipe), e com a mensagem apontando para a assercao
  # que ACHOU o texto. O caso real deste repositorio: 216 ocorrencias em 47
  # arquivos, 95 delas nos mutation tests, que ficavam vermelhos em ~1 de cada 3
  # execucoes.
  #
  # POR QUE ELE ENTROU NO HOOK (antes so rodava no CI): o guard dono TEM o
  # remedio mecanico (`--fix` -> herestring, com `--dry-run` publicando o patch
  # no PR), e a OFERTA do pre-commit nao o cobria — nao por falta de remendo, mas
  # porque o hook nunca invocava o guard. Quem introduz a cicatriz (uma reescrita
  # mecanica de scripts) corrigia a mao exatamente a linha que a maquina remenda.
  # Custo MEDIDO desta invocacao: ~0,14s (varredura inteira: 129 scripts + 33
  # workflows) — o mesmo comando do CI, sem recorte, entao nao ha decisao de
  # escopo a declarar (o `--staged` nao existiria aqui: metade do escopo sao
  # corpos `run:` de workflow, e o veredito e do ESTADO da arvore, como o das
  # outras guardas globais desta fase).
  node scripts/check-pipefail-sigpipe.mjs &
  PID_PIPEFAIL=$!

  # As CONDIÇÕES de cada passo do retrato arquivado (`.woodpecker.yml`) contra os
  # gatilhos e os `if:` dos workflows da forja. Node puro, read-only, **0,05s**
  # MEDIDO nesta árvore — e o defeito MUDA por commit: quem edita o `on:`/o `if:`
  # de um workflow da forja, ou o `when:` de um passo do retrato, sai daqui com
  # os dois lados divergindo. O comando é o MESMO do CI (as duas pipelines), sem
  # recorte, então não há decisão de escopo a declarar — e é o mesmo argumento do
  # `pipefail-sigpipe` acima: o gate é barato, muda por commit e já tem a classe
  # inteira no CI.
  node scripts/check-archived-pipeline.mjs &
  PID_ARQUIVO=$!

  # Prettier check STAGED — feedback de formatação ANTES do lint-staged
  (
    STAGED_FORMAT=$(git diff --cached --name-only --diff-filter=ACMR | grep -vE '\.(png|jpg|gif|svg|ico|webp|pdf|lock|snap)$' || true)
    if [ -n "$STAGED_FORMAT" ]; then
      bun x prettier --check --ignore-unknown $STAGED_FORMAT
    fi
  ) &
  PID_PRETTIER=$!

  wait_all $PID_ENCODING $PID_BARREL $PID_PRETTIER $PID_PII $PID_REGISTRY $PID_FORGE $PID_SCOPE $PID_HOOKPARITY $PID_HOOKCMD $PID_PIPEFAIL $PID_ARQUIVO
}

FASE_B=0
FASE_B_MEDIDA=0
if [ "$FASE_A" -eq 0 ]; then
  FASE_B_MEDIDA=1
  fase_b || FASE_B=$?
fi

# ── O REMEDIO: UMA pergunta para TODAS as classes de defeito MECANICO ─────
#
# Quando QUALQUER metade fica vermelha — a fase A, o gate de sintaxe ou a fase B
# —, o remedio e oferecido UMA VEZ: ele detecta cada classe com o guard DONO e
# remenda so o que ele conhece (a cicatriz de `run:`, o CR/CRLF do working tree, o
# CRLF do blob do indice, o byte 0x97 do utf8, o caminho tipado de um comando de
# hook e o pipe quieto sob pipefail), levando o remendo ao INDICE com a guarda de
# WIP. Sem este passo o operador consertava a mao exatamente o que a maquina
# remenda — com a chance de introduzir um erro NOVO na mesma linha.
#
# POR QUE A FASE A ENTRA NO `if`: a oferta nao pode depender de QUEM reprovou. O
# remedio nao mede o veredito das fases — ele mede as CLASSES, cada uma com o
# guard dono dela —, entao um gate sem fixer nao tem como deixar a oferta
# invisivel: a oferta e das classes presentes no indice, e o veredito da fase que
# reprovou continua bloqueando o commit (abaixo, e nao antes da oferta).
#
# A ORDEM (depois da medicao) importa de verdade, e por dois motivos:
#   - os guards ja terminaram e a saida assentou: um prompt competindo com guards
#     escrevendo e um prompt que ninguem le;
#   - `run-encoding-guards.sh` para no PRIMEIRO guard que falha (`set -e`), entao
#     a fase B nao diz se o defeito que sobrou e CRLF, blob ou utf8 — o remedio
#     mede cada classe com o guard dela, independentemente.
#
# O remedio pergunta no TERMINAL DE CONTROLE (o git liga o fd 0 do hook em
# /dev/null, e ele abre o /dev/tty justamente por isso): e este o ramo do fluxo
# real — a pergunta acontece num `git commit`, sim. SEM TERMINAL ele NAO pergunta:
# imprime o caminho a mao e mantem o commit bloqueado (fail-closed, exit 1 do
# remedio). E o caso de CI e de sessao sem tty de controle (o /dev/tty nao abre).
# Por isso ele e declarado LOCAL em HOOK_DECLARED: nao existe passo equivalente no
# CI — o CI cobra o MESMO veredito pelos gates (sintaxe e encoding), sem o caminho
# de quem opera.
#
# `REMEDIO` NASCE 1 ("nao provou nada") e o `&&` o vira 0 SO com exit 0: e o
# unico jeito de distinguir "o remedio aplicou e revalidou" de "a chamada sumiu"
# — o `|| VAR=$?` registra o FRACASSO, nunca o sucesso. O `|| true` mantem o
# `set -e` fora do caminho: o veredito e o de baixo, com o exit do GATE/FASE.
if [ "$FASE_A" -ne 0 ] || [ "$SINTAXE" -ne 0 ] || [ "$FASE_B" -ne 0 ]; then
  REMEDIO=1
  node scripts/pre-commit-remedy.mjs && REMEDIO=0 || true

  if [ "$REMEDIO" -ne 0 ]; then
    # O veredito da falha e o do GATE/FASE, nao o do remedio — e este ramo e a
    # REDE do caso perigoso: com a chamada acima ausente (ou sem terminal),
    # `REMEDIO` fica 1 e o commit com o defeito NAO passa.
    #
    # A ORDEM (fase A, sintaxe, fase B) e a mesma de antes para os dois casos que
    # ja existiam, com a fase A na frente: ela e a unica das tres que ja encerrava
    # o hook neste ponto, e o codigo que o operador ve tem de continuar sendo o do
    # guard do indice. A sintaxe vem depois dela porque e o veredito mais
    # especifico dos dois que sobraram.
    if [ "$FASE_A" -ne 0 ]; then
      exit "$FASE_A"
    fi
    if [ "$SINTAXE" -ne 0 ]; then
      exit "$SINTAXE"
    fi
    exit "$FASE_B"
  fi

  # O remedio so LEVANTA a falha que ele mediu: quem declara a fase VERDE e a
  # FASE, rodada de novo — com o remendo ja no INDICE e o mesmo instrumento do
  # veredito original (o `fase_a` inteiro, o `--staged` do gate e o `fase_b`
  # inteiro). Sem esta reexecucao, um remendo verde esconderia um gate IRMAO que
  # continua vermelho, e o remedio passaria a dar o veredito de uma fase que ele
  # NAO mede. A regra e uma so: reexecuta o que estava VERMELHO — nem mais (pagar
  # o instrumento de um veredito que ja e verde), nem menos.
  if [ "$FASE_A" -ne 0 ]; then
    fase_a
  fi
  if [ "$SINTAXE" -ne 0 ]; then
    node scripts/check-workflow-run-syntax.mjs --staged
  fi
  if [ "$FASE_B" -ne 0 ]; then
    fase_b
  fi

  # A fase B que NAO chegou a ser medida (a fase A reprovou e o hook pulou o custo
  # dela) e medida AGORA, com o remendo no indice: nenhuma fase pode ficar sem
  # medicao. Se ela reprovar, o `set -e` encerra o hook com o codigo dela — e o
  # remedio da classe que ela apontar e oferecido na rodada seguinte (uma pergunta
  # por rodada continua sendo o contrato da oferta).
  if [ "$FASE_B_MEDIDA" -eq 0 ]; then
    fase_b
  fi
fi

# ── Phase C: Sequential checks (state-dependent) ─────────────────────────
# These checks may modify files (lint-staged) or depend on the full project
# state (typecheck), so they run sequentially.

bun x lint-staged

# Direct RTL import check — impede import de @testing-library/react
# em arquivos .test.* (devem usar @/__tests__/test-utils)
bun run check:direct-rtl-import

# Type check — rejeita commit se houver erros de tipo no projeto
bun run typecheck

# Snapshot guard — roda testes de snapshot quando .snap ou *snapshot*.test.tsx
# forem alterados (staged), impedindo snapshots obsoletos de entrar no commit
STAGED_SNAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.snap$|snapshot[^/]*\.test\.tsx$' || true)
if [ -n "$STAGED_SNAP" ]; then
  echo "📸 Arquivos de snapshot alterados — rodando bun test:snapshots..."
  bun test:snapshots
fi
