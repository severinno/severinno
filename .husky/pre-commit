set -euo pipefail

# Encoding gate unico (UTF-8 + VPS ASCII + ASCII-safe proof + baseline): o
# mesmo gate que o CI roda em PR (pr-check.yml / utf8-check.yml) - um byte
# non-ASCII num .sh/hook nunca chega nem ao git add. Custo medido ~1.4s
# (batched, 2 spawns node + 1 python) - node+python3, sem rede.
bash scripts/verify-encoding.sh --dry-run --ci src/

# Docs corruption audit (informational - NEVER blocks): varre todos os .md,
# .css e .html sob git (a superficie completa, nao so src/) com
# scan-non-ascii.mjs --utf8 --report, emitindo warnings em stderr mas SEMPRE
# exit 0. NAO substitua por `bash scripts/check-utf8.sh --ext md --ci`: esse
# comando so varre src/ + dirs fixos, que tem ZERO .md - e --ci seria
# bloqueante. Esta auditoria e informativa e varre a superficie real (75
# .md, 1 .css, 0 .html hoje). Custo medido < 1s.
bash scripts/check-docs-encoding.sh

node scripts/scan-lucide-icons.mjs --check

# Auto-heal do .next/types stale (2026-08): quando o next instalado muda de versao (package.json
# ^16.1.1 -> bun install resolve 16.1.3), o surface de types gerado por uma versao anterior
# importa membros que o next novo nao exporta mais (TS2305 em TODO o .next/types) e o tsc abaixo
# falharia em todo commit ate o cache ser limpo. Deteccao por mtime (instalacao mais nova que a
# geracao = stale); --fix remove SO .next/types + .next/dev/types (regenerados no proximo dev/build).
# Custo <10ms; CI nao precisa (checkout fresco, sem .next).
node scripts/check-next-types.mjs --fix

# Guard de integridade do node_modules (2026-08, sec. 8.5 do gates-proofs.md):
# o `bun install` COMUM confia no layout existente e NAO repara node_modules
# divergente (reportou "no changes" com react/react-dom duplicados -> 114
# testes vermelhos por invalid hook call, nao por regressao). Compara a versao
# instalada de react/react-dom com a resolucao do bun.lock e falha com o
# comando de cura (install limpo) quando divergem. Custo <10ms; o CI nao
# precisa (checkout fresco instala do lock).
node scripts/check-node-modules-integrity.mjs

# Guard do Gate 3 do pre-push (2026-08, sec. 8.4 do gates-proofs.md): trava a
# decisao "Gate 3 mapeado, NAO a suite completa" contra regressao ANTES do
# commit - se alguem voltar o pre-push-gates.sh/.husky/pre-push a rodar
# test:unit/vitest run, este guard falha aqui (nao so no push net / CI).
# NOTA: o guard valida o WORKING TREE desses 2 arquivos - uma edicao em
# andamento deles falha todo commit ate terminar (mesma semantica do
# verify-encoding.sh). Custo medido ~0.13s puro / ~0.17s via hook (secao
# 11.9); o push net (guard-gates.yml) continua sendo a rede no push.
node scripts/scan-push-full-suite.mjs

# Guard do veredito RECUSADO da 11.7 (2026-08): o lint-staged nao pode voltar
# a rodar o eslint por um loader bun (bun/bunx) sem uma secao numerada 11.x
# com 'ADOTADO' + re-mediacao datada no gates-proofs.md (a reversao do
# veredito documentada). Tambem trava o gate eslint do lint-staged contra
# remocao/troca. Custo ~0.1s (boot node - espelho do scan-push-full-suite).
node scripts/scan-lint-staged-loader.mjs

# Typecheck e lint-staged em PARALELO (jobs independentes): medicao 2026-08-09 (secao 11.8 do
# gates-proofs.md) - o shim eslintd (11.6) reduziu o lint de ~8.5s para ~1s warm, entao o teto
# do paralelo e o proprio tempo do lint: sequencial ~25.6s vs paralelo ~23.8s (~1.6-1.8s de
# ganho, ~6%). O lint comeca PRIMEIRO (fix em ~1s) para os fixes cairem antes de o tsc ler a
# maioria dos arquivos - a janela de raca (eslint --fix reescreve staged enquanto o tsc le)
# fica estreita, mas NAO e zero: nao materializou em ~6 runs (amostra pequena, secao 11.8).
# Typecheck: nenhum commit pode quebrar o build (tsc --noEmit --incremental - mesmo gate do CI).
# NOTA: o incremental (tsconfig.tsbuildinfo, gitignored) deixa o gate ~17-24s WARM; o primeiro
# run apos clone limpo ou mudanca no tsconfig e ~55s (cold) - nao desative o gate por causa disso.
bun x lint-staged &
LINT_PID=$!
LINT_EXIT=0
TSC_EXIT=0
bun run typecheck || TSC_EXIT=$?
wait "$LINT_PID" || LINT_EXIT=$?
if [ "$LINT_EXIT" -ne 0 ] || [ "$TSC_EXIT" -ne 0 ]; then
  exit 1
fi

# Testes unitarios das areas tocadas: roda o vitest (unit config) so nos testes
# mapeados dos arquivos staged (skip quando nao ha testes nas areas tocadas).
bun run pre-commit:test