set -euo pipefail

# Bun guard STAGED — detecta cache keys/literais velhos no que está STAGED
# (git diff --cached) ANTES do guard global: se o commit introduzir uma key
# antiga (ex.: bun-1.3.14-...) ou literal, falha aqui com a mensagem do diff,
# mesmo que o working tree global já esteja migrado. Node puro, <1s.
node scripts/check-bun-mirror.mjs --staged

# Mutation-jobs STAGED — avalia o par de cobertura de mutation tests no que
# está STAGED (git diff --cached, escopo scripts/ E .github/workflows/) ANTES
# do guard global: se o commit introduzir um script de mutation test sem wire
# em NENHUM job/matriz (forward) OU um run: de workflow novo apontando para
# script inexistente (reverse), falha aqui com a mensagem do diff, mesmo que o
# working tree global já esteja consistente. Espelho do bun-mirror --staged.
# Node puro, <1s.
node scripts/check-mutation-jobs.mjs --staged

# Unused-deps STAGED — detecta dep órfã INTRODUZIDA pelo commit (adicionada no
# package.json do git diff --cached sem referência no ÍNDICE) ANTES do guard
# global (CI): o scan completo é ~850ms (1057 arquivos) e não roda no
# pre-commit; o --staged custa ~290ms (caso comum, sem diff do package.json)
# e ~150-500ms com deps novas (1-2 git grep --cached por dep). O import em
# arquivo NÃO staged não conta (o commit não o carrega). Node puro, <1s.
node scripts/check-unused-deps.mjs --staged

# Mutation-timing contract STAGED — valida que os markers do mutation-coord
# (job/step do seed-guards.yml) estão consistentes no que está STAGED (git
# diff --cached — lê o ÍNDICE, não o working tree) ANTES do guard global: um
# PR que renomeia o job/step no seed-guards.yml sem atualizar os outros 3
# locais (medidor/mutation test/unit test) de forma COORDENADA falha aqui,
# mesmo que o working tree global já esteja migrado (estágio parcial).
# Espelho do check-bun-mirror --staged. Node puro, <1s.
node scripts/check-mutation-timing-contract.mjs --staged

# 15 guards de encoding/CI compartilhados com o pre-push (fonte única —
# adicionar um guard novo = editar scripts/run-encoding-guards.sh em UM lugar)
bash scripts/run-encoding-guards.sh

# Barrel lint — valida imports diretos (barrels) E headers de scripts
# (Usage + Exit code nas 50 primeiras linhas). Roda ANTES do lint-staged
# para que a violação de header seja pega com arquivo:linha cedo, sem o
# prettier já ter reformatado o working tree (o lint-staged roda por último
# na cadeia de formatação — se o barrel falhasse depois, o dev corrigiria
# sobre arquivos já modificados).
bun run barrel-lint

# Prettier check STAGED — feedback local de formatação ANTES do lint-staged
# (padrão do barrel-lint: o erro é pego com arquivo:linha cedo, não
# silenciosamente corrigido). Escopo = arquivos do commit (staged) — o
# repo-wide é responsabilidade do job lint-guard no CI (prettier --check
# sobre TODO o repo a cada PR). Arquivos não-formatados que o lint-staged
# corrigiria agora FALHAM o commit: rode `npx prettier --write <arquivo>`
# e re-stage.
STAGED_FORMAT=$(git diff --cached --name-only --diff-filter=ACMR | grep -vE '\.(png|jpg|gif|svg|ico|webp|pdf|lock|snap)$' || true)
if [ -n "$STAGED_FORMAT" ]; then
  # O --check lê o working tree, não o índice: com git add -p o conteúdo
  # checado pode diferir do que será commitado — caso raro no repo, aceito.
  npx prettier --check --ignore-unknown $STAGED_FORMAT
fi

bun x lint-staged

# Direct RTL import check — impede import de @testing-library/react
# em arquivos .test.* (devem usar @/__tests__/test-utils)
bun run check:direct-rtl-import

# Runner oficial E2E — impede reintrodução de `npx playwright` em
# docs/scripts/package.json (npx quebra no Windows; use bunx playwright)
bun run check:no-npx-playwright

# Fetch timeout — impede reintrodução de `fetch(` SEM signal de timeout em src/
# (fecha a classe de hangs quando o serviço aceita TCP mas nunca responde)
bun run check:fetch-timeout

# Timeout envs docs — impede env de timeout em src/ sem doc consistente
# (README tabela Fetch timeouts + .env.example + composes; default divergente
# da doc = operação tunando valor errado — o guard deriva do código)
bun run check:timeout-envs

# Worklog integrity — cada Task ID do worklog.md com o formato mínimo
# (Task ID/Agent/Task/Work Log) e IDs únicos; entradas sem contexto de
# auditoria ou IDs duplicados falham o commit
bun run check:worklog

# Worklog TOC — todo Task ID/Stage do worklog.md com linha no índice
# (âncora + resumo) e todo link do índice resolvendo para a entrada real;
# entrada nova sem linha no TOC (ou link stale) falha o commit
bun run check:worklog-toc

# Cache patterns — CACHE_PATTERNS do seed sincronizado com os prefixes reais
# de withCache/withCachedGeo/cacheInvalidate em src/ (prefixo novo esquecido
# do re-seed ou padrão órfão falham o commit)
bun run check:cache-patterns

# Type check — rejeita commit se houver erros de tipo no projeto
bun run typecheck

# Snapshot guard — roda os testes de snapshot quando .snap ou *snapshot*.test.tsx
# forem alterados (staged), impedindo snapshots obsoletos de entrar no commit
STAGED_SNAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.snap$|snapshot[^/]*\.test\.tsx$' || true)
if [ -n "$STAGED_SNAP" ]; then
  echo "📸 Arquivos de snapshot alterados — rodando bun test:snapshots..."
  bun test:snapshots
fi
