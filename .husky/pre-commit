set -euo pipefail

# Bun guard STAGED — detecta cache keys/literais velhos no que está STAGED
# (git diff --cached) ANTES do guard global: se o commit introduzir uma key
# antiga (ex.: bun-1.3.14-...) ou literal, falha aqui com a mensagem do diff,
# mesmo que o working tree global já esteja migrado. Node puro, <1s.
node scripts/check-bun-mirror.mjs --staged

# 10 guards de encoding/CI compartilhados com o pre-push (fonte única —
# adicionar um guard novo = editar scripts/run-encoding-guards.sh em UM lugar)
bash scripts/run-encoding-guards.sh
bun x lint-staged

# Direct RTL import check — impede import de @testing-library/react
# em arquivos .test.* (devem usar @/__tests__/test-utils)
bun run check:direct-rtl-import

# Barrel lint — detecta exports quebrados em arquivos de barrel (index.ts)
bun run barrel-lint

# Type check — rejeita commit se houver erros de tipo no projeto
bun run typecheck

# Snapshot guard — roda os testes de snapshot quando .snap ou *snapshot*.test.tsx
# forem alterados (staged), impedindo snapshots obsoletos de entrar no commit
STAGED_SNAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.snap$|snapshot[^/]*\.test\.tsx$' || true)
if [ -n "$STAGED_SNAP" ]; then
  echo "📸 Arquivos de snapshot alterados — rodando bun test:snapshots..."
  bun test:snapshots
fi
