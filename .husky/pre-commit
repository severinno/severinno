set -eu

# ============================================================================
# Pre-commit hook — Severinno Marketplace
#
# Structured in 3 phases for maximum parallelism:
#   Phase A — Staged-only guards (parallel, ~2s)
#   Phase B — Global guards (parallel, ~3s)
#   Phase C — Sequential checks (state-dependent, ~5s)
#
# Total estimated: ~8-12s (down from ~15-30s serial)
# ============================================================================

# ── Phase A: Staged guards (parallel) ─────────────────────────────────────
# These guards inspect only git diff --cached (staged changes) and are
# completely independent of each other — safe to run in parallel.

node scripts/check-bun-mirror.mjs --staged &
PID_BUN=$!

node scripts/check-mutation-jobs.mjs --staged &
PID_MUT=$!

node scripts/check-unused-deps.mjs --staged &
PID_DEPS=$!

node scripts/check-mutation-timing-contract.mjs --staged &
PID_TIMING=$!

# Wait for all Phase A jobs — fail immediately if any exits non-zero
wait $PID_BUN $PID_MUT $PID_DEPS $PID_TIMING

# ── Phase B: Global guards (parallel) ─────────────────────────────────────
# Encoding guards, barrel lint, and prettier check are read-only and
# independent — safe to run in parallel.

bash scripts/run-encoding-guards.sh &
PID_ENCODING=$!

bun run barrel-lint &
PID_BARREL=$!

# Prettier check STAGED — feedback de formatação ANTES do lint-staged
(
  STAGED_FORMAT=$(git diff --cached --name-only --diff-filter=ACMR | grep -vE '\.(png|jpg|gif|svg|ico|webp|pdf|lock|snap)$' || true)
  if [ -n "$STAGED_FORMAT" ]; then
    bun x prettier --check --ignore-unknown $STAGED_FORMAT
  fi
) &
PID_PRETTIER=$!

wait $PID_ENCODING $PID_BARREL $PID_PRETTIER

# ── Phase C: Sequential checks (state-dependent) ─────────────────────────
# These checks may modify files (lint-staged) or depend on the full project
# state (typecheck), so they run sequentially.

bun x lint-staged

# Direct RTL import check — impede import de @testing-library/react
# em arquivos .test.* (devem usar @/__tests__/test-utils)
bun run check:direct-rtl-import

# Type check — rejeita commit se houver erros de tipo no projeto
bun run typecheck

# Snapshot guard — roda testes de snapshot quando .snap ou *snapshot*.test.tsx
# forem alterados (staged), impedindo snapshots obsoletos de entrar no commit
STAGED_SNAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.snap$|snapshot[^/]*\.test\.tsx$' || true)
if [ -n "$STAGED_SNAP" ]; then
  echo "📸 Arquivos de snapshot alterados — rodando bun test:snapshots..."
  bun test:snapshots
fi
