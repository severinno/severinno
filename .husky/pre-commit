set -eu

# ── Agregação dos guards paralelos ────────────────────────────────────────
# `wait pid1 pid2 ...` devolve o status de APENAS UM dos PIDs — o ÚLTIMO da
# lista. Medido nas duas cascas que o husky usa (dash via `sh -e` e bash via
# Git for Windows): `(exit 3) & a=$!; (exit 0) & b=$!; wait $a $b` sai 0.
# Ou seja: um guard que NÃO seja o último da fase podia reprovar e o commit
# seguia — o comentário prometia "fail immediately if any exits non-zero" e o
# código não cumpria. Aqui esperamos cada PID e devolvemos o PRIMEIRO status
# não-zero, de modo que o exit code do hook seja o do guard que reprovou,
# seja qual for a posição dele na fase.
wait_all() {
  _status=0
  for _pid in "$@"; do
    _code=0
    wait "$_pid" || _code=$?
    if [ "$_code" -ne 0 ] && [ "$_status" -eq 0 ]; then
      _status=$_code
    fi
  done
  return "$_status"
}

# ============================================================================
# Pre-commit hook — Severinno Marketplace
#
# Structured in 3 phases for maximum parallelism:
#   Phase A — Staged-only guards (parallel, ~2s)
#   Phase B — Global guards (parallel, ~3s)
#   Phase C — Sequential checks (state-dependent, ~5s)
#
# Total estimated: ~8-12s (down from ~15-30s serial)
# ============================================================================

# ── Phase A: Staged guards (parallel) ─────────────────────────────────────
# These guards inspect only git diff --cached (staged changes) and are
# completely independent of each other — safe to run in parallel.

node scripts/check-bun-mirror.mjs --staged &
PID_BUN=$!

node scripts/check-mutation-jobs.mjs --staged &
PID_MUT=$!

node scripts/check-unused-deps.mjs --staged &
PID_DEPS=$!

node scripts/check-mutation-timing-contract.mjs --staged &
PID_TIMING=$!

# Sintaxe dos corpos `run:` — RECORTE --staged, declarado em HOOK_DECLARED do
# check-hook-ci-parity: julga os workflows do INDICE, lendo o conteudo do
# commit (`git show :path`), nao o working tree. O corpo quebrado nasce de uma
# reescrita mecanica em massa ANTES do commit e e o COMMIT que o carrega; a
# arvore pode ter WIP que nao faz parte dele. A varredura inteira (480 corpos
# das duas forjas) continua sendo o veredito do CI.
node scripts/check-workflow-run-syntax.mjs --staged &
PID_RUNSYNTAX=$!

# Aguarda os QUATRO SEM REMEDIO e agrega os status deles (wait_all — topo).
#
# O de sintaxe fica FORA desta lista de proposito: o `wait_all` devolve o PRIMEIRO
# status nao-zero, entao ele diz QUE a fase falhou, nao QUAL guard falhou — e o de
# sintaxe e o unico da fase com REMEDIO (o remendo da cicatriz mecanica, abaixo).
# O `||` e obrigatorio aqui: com `set -e` um `wait_all` que devolvesse nao-zero
# ENCERRAVA o hook neste ponto, e as duas linhas abaixo (o remedio e o veredito da
# fase) nunca rodariam — a agregacao continuaria sendo a mesma, mas o codigo
# abaixo dela mentiria sobre o que mede.
FASE_A=0
wait_all $PID_BUN $PID_MUT $PID_DEPS $PID_TIMING || FASE_A=$?

# Espera o de sintaxe ANTES de qualquer pergunta: os cinco ja terminaram e o
# output assentou — um prompt competindo com quatro guards escrevendo e um prompt
# que ninguem le.
SINTAXE=0
wait "$PID_RUNSYNTAX" || SINTAXE=$?

if [ "$SINTAXE" -ne 0 ]; then
  # OFERECE o remendo, com confirmacao explicita: o repositorio reescreve corpo de
  # `run:` por MAQUINA e a cicatriz que sobra e mecanica — o fixer do gate ja sabe
  # remenda-la e ja prova o remendo antes de gravar. Sem este passo o operador
  # reescrevia a mao exatamente a linha que a maquina remenda, com a chance de
  # introduzir um erro NOVO na mesma linha.
  #
  # SEM TERMINAL ele NAO pergunta — imprime o caminho a mao e mantem o commit
  # bloqueado (fail-closed). Ele nao existe no CI (la nao ha operador para confirmar
  # nada): e declarado LOCAL em HOOK_DECLARED.
  #
  # `REMEDIO` NASCE 1 ("nao provou nada") e o `&&` o vira 0 SO com exit 0: e o
  # unico jeito de distinguir "o remedio revalidou o INDICE" de "a chamada sumiu"
  # — o `|| VAR=$?` registra o FRACASSO, nunca o sucesso. O `|| true` mantem o
  # `set -e` fora do caminho: o veredito e a linha de baixo, com o exit do GATE.
  REMEDIO=1
  node scripts/pre-commit-run-syntax-remedy.mjs && REMEDIO=0 || true
  # O veredito da falha e o do GATE (o exit do guard), nao o do remedio — e esta
  # linha e a REDE do caso perigoso: com a chamada acima ausente, `REMEDIO` fica
  # 1 e o commit com o corpo quebrado NAO passa.
  [ "$REMEDIO" -eq 0 ] || exit "$SINTAXE"
fi

# A falha dos quatro sem remedio segue bloqueando o commit — o mesmo veredito de
# antes, agora dito em vez de deixado para o `set -e`.
[ "$FASE_A" -eq 0 ] || exit "$FASE_A"

# ── Phase B: Global guards (parallel) ─────────────────────────────────────
# Encoding guards, barrel lint, and prettier check are read-only and
# independent — safe to run in parallel.

bash scripts/run-encoding-guards.sh &
PID_ENCODING=$!

bun run barrel-lint &
PID_BARREL=$!

# Allowlist de PII em payload de usuário + fonte única do client Prisma.
# Espelha o job `pii-allowlist-guard` do pr-check.yml (e o check:* do CI) —
# falha AQUI evita abrir o PR já sabendo que o gate vai recusar. Read-only e
# rápido (~2s), por isso entra na fase paralela.
bun run check:pii-allowlist &
PID_PII=$!

# Fonte única do registry OCI (imagens da app + mirrors). Node puro, read-only,
# <1s — falha aqui evita abrir um PR que reintroduz `ghcr.io` hardcoded e
# quebra o flip de uma variável. Espelha o step do pr-check.yml.
bun run check:registry-source &
PID_REGISTRY=$!

# Paridade de gates entre a forja (dona do merge) e o espelho do GitHub.
# Node puro, read-only: falha se um invariante do CORE existir em só uma das
# pipelines — o modo silencioso de achar que o PR foi verificado.
bun run check:forge-parity &
PID_FORGE=$!

# Escopo dos guards: nenhum script pode cravar um diretório de forja (é o que
# garante que a pipeline dona do merge não volte a ficar fora da cobertura).
bun run check:forge-workflow-scope &
PID_SCOPE=$!

# Paridade hook ↔ CI: cada comando DESTE arquivo tem de ser o MESMO comando do
# CI (ou um recorte com decisao escrita). O caso real: o pre-push rodava
# `bunx tsc --noEmit` SEM o heap de 4GB do script `typecheck` — o mesmo commit
# estourava a memoria no push e passava no merge. Node puro, ~0.05s: falha aqui
# evitando um commit cujo veredito local nao e o do CI.
node scripts/check-hook-ci-parity.mjs &
PID_HOOKPARITY=$!

# Prettier check STAGED — feedback de formatação ANTES do lint-staged
(
  STAGED_FORMAT=$(git diff --cached --name-only --diff-filter=ACMR | grep -vE '\.(png|jpg|gif|svg|ico|webp|pdf|lock|snap)$' || true)
  if [ -n "$STAGED_FORMAT" ]; then
    bun x prettier --check --ignore-unknown $STAGED_FORMAT
  fi
) &
PID_PRETTIER=$!

wait_all $PID_ENCODING $PID_BARREL $PID_PRETTIER $PID_PII $PID_REGISTRY $PID_FORGE $PID_SCOPE $PID_HOOKPARITY

# ── Phase C: Sequential checks (state-dependent) ─────────────────────────
# These checks may modify files (lint-staged) or depend on the full project
# state (typecheck), so they run sequentially.

bun x lint-staged

# Direct RTL import check — impede import de @testing-library/react
# em arquivos .test.* (devem usar @/__tests__/test-utils)
bun run check:direct-rtl-import

# Type check — rejeita commit se houver erros de tipo no projeto
bun run typecheck

# Snapshot guard — roda testes de snapshot quando .snap ou *snapshot*.test.tsx
# forem alterados (staged), impedindo snapshots obsoletos de entrar no commit
STAGED_SNAP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.snap$|snapshot[^/]*\.test\.tsx$' || true)
if [ -n "$STAGED_SNAP" ]; then
  echo "📸 Arquivos de snapshot alterados — rodando bun test:snapshots..."
  bun test:snapshots
fi
