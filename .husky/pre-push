set -euo pipefail

# stdin do hook (single-read: o stream so pode ser lido UMA vez): capturamos
# tudo de uma vez e derivamos dele (a) o remote sha da 1a linha para o Gate 3
# e (b) a deteccao de push de DELECAO PURA. So quando o stdin NAO e um TTY
# (ou seja, o git chamou o hook de verdade) - invocacao manual interativa
# deixa vazio e o Gate 3 cai para staged + HEAD.
if [ -t 0 ]; then
  PRE_PUSH_REMOTE_SHA=""
  PRE_PUSH_STDIN=""
else
  PRE_PUSH_STDIN="$(cat)"
  # Multi-ref pushes trazem uma linha por branch; usamos o remote sha da 1a
  # linha NAO-delecao (local sha != all-zeros) - em push misto (delecao + ref
  # real), a 1a linha pode ser a delecao e seu remote sha (tip do branch
  # apagado) seria uma base errada para o range do Gate 3. Cai para a 1a
  # linha se nao houver ref real (caso impossivel de alcancar aqui - delecao
  # pura ja saiu acima - mas seguro).
  # awk: guarda o $4 da 1a linha em `first`; qualquer linha NAO-delecao
  # (local sha != all-zeros) seta `real`; no END imprime `real` se existir,
  # senao `first`. SEM `exit` no corpo: exit dispararia o END e imprimiria
  # DUAS linhas ($4 + first) - o comando substitution capturaria um remote
  # sha multi-linha e quebraria o --since do Gate 3.
  PRE_PUSH_REMOTE_SHA="$(printf '%s' "$PRE_PUSH_STDIN" | awk 'NR == 1 { first = $4 } $2 !~ /^0+$/ { real = $4 } END { print (real != "" ? real : first) }')"
fi
export PRE_PUSH_REMOTE_SHA

# ATALHO DE DELECAO PURA (medicao 2026-08, secao 8.4: ~74s por push): um push
# que so apaga branches (`git push origin --delete x` / `:x`) nao transporta
# NENHUM commit novo - rodar a cadeia inteira e testar nada.
# check-push-deletion.mjs exit 0 quando TODAS as refs tem local sha
# all-zeros; pulamos a cadeia com aviso (~74s -> ~0.4s medido, node boot - o
# checker puro custa ~10ms, o caminho do hook ~0.4s). Push MISTO (delecao
# + ref real na mesma chamada) roda os gates normal - carrega codigo. Stdin
# vazio (invocacao manual) tambem roda normal.
if [ -n "$PRE_PUSH_STDIN" ] && printf '%s' "$PRE_PUSH_STDIN" | node scripts/check-push-deletion.mjs; then
  echo "[skip] pre-push: push de delecao pura (sem commits novos) - gates pulados (housekeeping de branches, secao 8.4)"
  exit 0
fi

# Encoding gate unico (UTF-8 + VPS ASCII + ASCII-safe proof + baseline): o
# mesmo gate que o CI roda em PR (pr-check.yml / utf8-check.yml) - um byte
# non-ASCII num .sh/hook nunca chega nem ao push. Custo medido ~1.4s
# (batched, 2 spawns node + 1 python) - node+python3, sem rede.
bash scripts/verify-encoding.sh --dry-run --ci src/

# Docs corruption audit (informational - NEVER blocks): varre todos os .md,
# .css e .html sob git (a superficie completa, nao so src/) com
# scan-non-ascii.mjs --utf8 --report, emitindo warnings em stderr mas SEMPRE
# exit 0. NAO substitua por `bash scripts/check-utf8.sh --ext md --ci`: esse
# comando so varre src/ + dirs fixos, que tem ZERO .md - e --ci seria
# bloqueante. Esta auditoria e informativa e varre a superficie real (75
# .md, 1 .css, 0 .html hoje). Custo medido < 1s.
bash scripts/check-docs-encoding.sh

# Gate de fuzz MAPEADO (adocao da secao 11.11, medicao 2026-08-10): o
# fuzz:ci de 6 spawns custava ~40.4s (71% do push); o runner mapeado roda SO
# as suites cujos alvos foram tocados no diff do push (mesmo escopo do Gate 3)
# e BATCHA numa unica invocacao vitest - tipico ~6-14s, ate o pior caso
# (helper compartilhado = todas as 6) e ~14.5s vs 40.4s. Sem range (primeiro
# push da branch / rodada manual, --since all-zeros) -> fallback para o fuzz
# COMPLETO batched. Zero suites mapeadas (docs/admin/ui) -> skip exit 0.
# O CI continua rodando `bun run fuzz:ci` (run-all-fuzz.mjs --json) em
# checkout fresco como AUTORIDADE inalterada - o runner local nunca mascara o
# CI, so corta o custo. O contrato do scan-push-full-suite.mjs trava este
# comando (positivo) e o fuzz fora do pre-commit (negativo).
node scripts/run-mapped-fuzz.mjs --since "${PRE_PUSH_REMOTE_SHA:-}"

# Gates do CI antes do push (validate-cache-manifest + check-js-budget + testes
# unitarios das areas tocadas) - espelhando o pre-commit: nenhum push pode
# quebrar o que o CI verifica depois de ja estar localmente verde.
# (O stdin do hook ja foi capturado no topo - o PRE_PUSH_REMOTE_SHA exportado
# alimenta o Gate 3 e o atalho de delecao pura acima.)
bun run pre-push:gates