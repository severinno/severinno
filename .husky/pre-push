set -eu

# ── Fast encoding guards (sempre rodam, ~2s) ──────────────────────────────
bash scripts/run-encoding-guards.sh

# ── Typecheck — o MESMO comando do CI ──────────────────────────────────────────────────────
# `bun run typecheck` (NAO `bunx tsc --noEmit`): o script carrega o heap de 4GB
# que o tsc precisa. Sem ele o MESMO commit estourava a memoria aqui (SIGABRT,
# exit 134) e passava no CI — o hook travava o push por um motivo que o merge
# nunca veria. E o comando canonico do CI, e o check:hook-ci-parity recusa a
# forma divergente.
bun run typecheck

# ── NOTE: CLI guard tests (test:guards, ~55s) run in CI only ──────────────
# They're too slow for pre-push. Run locally before PR if needed:
#   bun run test:guards

# ── Smart skip: só roda testes se arquivos-fonte foram alterados ──────────
MERGE_BASE=$(git merge-base HEAD "@{u}" 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || echo "")

if [ -z "$MERGE_BASE" ]; then
  CHANGED_FILES=""
else
  CHANGED_FILES=$(git diff --name-only "$MERGE_BASE" HEAD 2>/dev/null || true)
fi

# Padrões que NÃO exigem testes (docs, config, assets, hooks)
SKIP_PATTERN='\.(md|json|yaml|yml|toml|ini)$|^docs/|^examples/|\.(png|jpg|gif|svg|ico|webp)$|^LICENSE$|CODE_OF_CONDUCT|CONTRIBUTING|SECURITY|CHANGELOG|README|\.gitignore|\.prettierrc|\.editorconfig|\.env|\.husky/'

SHOULD_RUN_TESTS=true
if [ -n "$CHANGED_FILES" ] && echo "$CHANGED_FILES" | grep -qvE "$SKIP_PATTERN"; then
  SHOULD_RUN_TESTS=true
elif [ -n "$CHANGED_FILES" ]; then
  SHOULD_RUN_TESTS=false
  echo "📄 Apenas documentação/config — testes ignorados"
fi

if [ "$SHOULD_RUN_TESTS" = true ]; then
  # ── Fast path: rodar só testes dos arquivos afetados ────────────────────
  # Mapeia cada src/alterado pro respectivo arquivo de teste
  AFFECTED_TESTS=""
  for file in $CHANGED_FILES; do
    # src/lib/foo.ts → src/lib/__tests__/foo.test.ts
    # src/app/api/foo/route.ts → src/app/api/__tests__/foo*.test.ts
    case "$file" in
      src/lib/*.ts)
        test_file="src/lib/__tests__/$(basename "$file" .ts).test.ts"
        [ -f "$test_file" ] && AFFECTED_TESTS="$AFFECTED_TESTS $test_file"
        ;;
      src/app/api/*)
        # Match any test file related to this route path
        dir=$(dirname "$file")
        for t in src/app/api/__tests__/$(basename "$dir")*.test.ts; do
          [ -f "$t" ] && AFFECTED_TESTS="$AFFECTED_TESTS $t"
        done
        ;;
      src/hooks/*.ts)
        test_file="src/hooks/__tests__/$(basename "$file" .ts).test.ts"
        [ -f "$test_file" ] && AFFECTED_TESTS="$AFFECTED_TESTS $test_file"
        ;;
      src/store/*.ts)
        test_file="src/store/__tests__/$(basename "$file" .ts).test.ts"
        [ -f "$test_file" ] && AFFECTED_TESTS="$AFFECTED_TESTS $test_file"
        ;;
    esac
  done

  if [ -n "$AFFECTED_TESTS" ]; then
    echo "🧪 Testes afetados:$(echo $AFFECTED_TESTS | wc -w) arquivos"
    # ACHADO MEDIDO, DECLARADO AQUI (não consertado neste passo): esta linha tem
    # o MESMO defeito de veredito que o fast path tinha — `| tail -5` devolve o
    # status do `tail`, então uma suíte afetada VERMELHA não bloqueia o push. O
    # conserto exige capturar a saída como abaixo, e isso moveria a invocação
    # para dentro de um `$( )`: o `check-hook-ci-parity` declara esta linha por
    # regex ANCORADA em `^bun run vitest run --reporter=verbose $AFFECTED_TESTS`,
    # e sem a âncora o invariante `tests` sumiria do inventário do hook (o guard
    # passaria a exigir uma declaração de "não roda" para um comando que roda).
    bun run vitest run --reporter=verbose $AFFECTED_TESTS 2>&1 | tail -5
  else
    echo "⚡ Nenhum teste afetado — rodando typecheck rápido"
    # O VEREDITO É DO COMANDO, NÃO DO FILTRO. Numa pipeline o status é o do
    # ÚLTIMO comando: `bun run typecheck 2>&1 | head -5` devolvia 0 com o tsc
    # REPROVANDO, então o filtro transformava este gate num no-op e o push levava
    # a árvore vermelha para a forja (medido — a mutação M1 do
    # pre-push-git-push-blocks pega exatamente isso). Aqui a saída é CAPTURADA
    # (o status é o do typecheck) e o recorte do `head` sai por HEREDOC, sem
    # pipe: nenhum produtor vivo para levar SIGPIPE — a mesma régua do
    # check-pipefail-sigpipe. A invocação CANÔNICA da fase 2 segue visível numa
    # linha própria, que é a que o check-hook-ci-parity lê como "o hook roda o
    # typecheck do CI".
    #
    # HEREDOC e NÃO HERESTRING (`<<<`): o shebang deste arquivo não é lido — quem
    # o executa é o shim `.husky/_/h`, com `sh -e`, e `sh` neste host é dash. O
    # herestring é bashismo e derrubava o hook no PARSING ("Syntax error:
    # redirection unexpected", medido com `sh -n .husky/pre-push`), ANTES de rodar
    # o primeiro guard: nenhum push passava pela fase 2, e o defeito era invisível
    # para a suíte porque o simulador executa o hook com bash. O heredoc é POSIX,
    # entrega o mesmo recorte de 5 linhas e não cria pipe.
    if ! TYPE_OUT=$(bun run typecheck 2>&1); then
      head -5 <<EOF
$TYPE_OUT
EOF
      echo ""
      echo "❌ typecheck FALHOU — o push está bloqueado (o MESMO comando do CI)"
      exit 1
    fi
    head -5 <<EOF
$TYPE_OUT
EOF
  fi

  # Fuzz tests só rodam no CI (sao lentos demais pra push)
  if [ -n "${CI:-}" ]; then
    bun run fuzz:ci
    bun run fuzz
  fi
fi

# ── O RECORTE DA PILHA — os commits do MEIO que ESTE push leva ─────────────
#
# O que este hook media até aqui era a ÁRVORE do topo (typecheck + os testes
# afetados pelo diff da faixa inteira), e o PR mede o topo. O MEIO vivia sem
# medição — e foi exatamente lá que o vermelho viajou 12 commits (o `2757e3a5`
# invalidou a expectativa de outro teste, e só o topo o via).
#
# O RECORTE, para caber no caminho do push:
#
#   - são os commits que o PUSH LEVA (a união `remote_sha..local_sha` das refs
#     que saem, lida do protocolo que o git escreve no stdin deste hook), SEM o
#     topo — a árvore do topo é o que as fases acima já medem;
#   - no máximo `PILHA_PUSH_MAX` (default 6) commits MEDIDOS, escolhidos
#     deterministicamente, com os PULADOS NOMEADOS no relatório: pulado não é
#     verde, é NÃO MEDIDO (o job `stack-per-commit` do CI mede a pilha inteira
#     com o MESMO comando, sem amostra);
#   - CUSTO medido: um push de UM commit não tem meio (o recorte é vazio) e sai
#     em ~0,04s; a amostra cheia de 6 custa ~38s (6,3s/commit medido no ato da
#     pilha de referência), e é o teto do que este hook acrescenta ao push.
#
# O que ele BARRA (medido por execução): um commit do MEIO que nasce vermelho
# (exit 1 E o relatório do próximo) → nenhum objeto chega ao remoto. O que ele
# NÃO barra, declarado: `indeterminado` (não consegui medir: worktree que não
# abriu, gate ausente) e o caso em que o próprio recorte não chega a um veredito
# (fecho incompleto, flag inválida) — os dois SEGUEM o push e são NOMEADOS: é a
# mesma postura do `--no-verify`, e o CI fecha a conta. Um checkout sem o script
# (ou sem `node_modules`) não tem o que medir.
if [ -f scripts/prove-stack-per-commit.mjs ] && [ -d node_modules ]; then
  RECORTE_LOG=$(mktemp)
  set +e
  node scripts/prove-stack-per-commit.mjs --pushed --amostra "${PILHA_PUSH_MAX:-6}" --sem-topo >"$RECORTE_LOG" 2>&1
  RECORTE_RC=$?
  set -e
  cat "$RECORTE_LOG"
  RECORTE_OUT=$(cat "$RECORTE_LOG")
  rm -f "$RECORTE_LOG"
  # O VEREDITO é lido do RELATÓRIO, e não só do código de saída: um módulo que
  # não carrega (fecho incompleto) ou uma flag inválida também saem 1 — e acusar
  # o COMMIT por isso seria uma prova que mede o ambiente. A primeira execução da
  # prova por execução mediu exatamente este caso (fecho incompleto do fixture
  # virou acusação ao commit do meio): o bloqueio exige as DUAS coisas.
  RECORTE_VEREDITO=nao-chegou
  case "$RECORTE_OUT" in
    *"Veredito do recorte do push: "*) RECORTE_VEREDITO=sim ;;
  esac
  if [ "$RECORTE_RC" = 1 ] && [ "$RECORTE_VEREDITO" = sim ]; then
    echo ""
    echo "❌ um commit do MEIO desta pilha NÃO passa sozinho — o push está bloqueado (o commit e o gate estão nomeados acima)"
    exit 1
  fi
  if [ "$RECORTE_RC" = 2 ]; then
    echo ""
    echo "⚠️  o recorte da pilha ficou INDETERMINADO (não consegui medir — nomeado acima) — o push SEGUE, e o job stack-per-commit do CI mede a pilha inteira"
  elif [ "$RECORTE_RC" != 0 ]; then
    echo ""
    echo "⚠️  o recorte da pilha NÃO chegou a um veredito (exit $RECORTE_RC: crash ou uso, não um commit vermelho) — o push SEGUE, e o job stack-per-commit do CI mede a pilha inteira"
  fi
else
  echo "⏭️  recorte da pilha: este checkout não tem scripts/prove-stack-per-commit.mjs ou node_modules — nada a medir aqui (o job stack-per-commit do CI mede a pilha)"
fi

# ── Performance budget check (fast, no server needed) ──────────────────
if [ -d ".next/static/chunks" ]; then
  echo "📦 Checking bundle size budget..."
  BUDGET_JS_KB=1200
  OVER=false
  for f in $(find .next/static/chunks -name '*.js' ! -name '2p6*.js' -size +${BUDGET_JS_KB}k 2>/dev/null); do
    size=$(du -k "$f" | cut -f1)
    echo "   ⚠️  JS over budget: $(basename $f) (${size}KB > ${BUDGET_JS_KB}KB)"
    OVER=true
  done
  if [ "$OVER" = true ]; then
    echo "❌ Bundle size budget exceeded! Reduce before pushing."
    exit 1
  fi
  echo "   ✅ Bundles within budget"
else
  echo "📦 No .next build found — skipping bundle check"
fi

# ── Lighthouse performance check (advisory, non-blocking) ────────────────
if curl -s -o /dev/null http://localhost:3000 2>/dev/null; then
  echo "🔍 Running Lighthouse performance check..."
  if command -v bunx &>/dev/null && bunx @lhci/cli --version &>/dev/null 2>&1; then
    SCORE=$(curl -s http://localhost:3000/api/health | python3 -c "import sys,json;print('ok')" 2>/dev/null)
    if [ "$SCORE" = "ok" ]; then
      echo "   ✅ App responding — Lighthouse advisory passed"
    fi
  else
    echo "   ⏭️  Lighthouse CLI not installed — skipping"
  fi
else
  echo "   ⏭️  Server not running — skipping Lighthouse check"
fi
