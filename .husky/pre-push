set -euo pipefail

# stdin do hook (single-read: o stream so pode ser lido UMA vez): o
# check-push-deletion.mjs le o stdin UMA vez e dele deriva (a) o remote sha
# da 1a linha NAO-delecao para o Gate 3 (stdout - o awk inline movido para
# o checker, sec 11.21) e (b) a deteccao de push de DELECAO PURA (exit 0).
# UM spawn node no lugar de cat + awk + node (3 subprocessos -> 1):
# ~0.28s -> ~0.17s warm medido em delecao pura E misto (A/B honesto com a
# fiacao exata do hook, 3 runs cada, sec 11.21). So
# quando o stdin NAO e um TTY (ou seja, o git chamou o hook de verdade) -
# invocacao manual interativa deixa vazio e o Gate 3 cai para staged + HEAD.
if [ -t 0 ]; then
  PRE_PUSH_REMOTE_SHA=""
  PRE_PUSH_PURE_DELETION=1
else
  # Multi-ref pushes trazem uma linha por branch; o checker usa o remote sha
  # da 1a linha NAO-delecao (local sha != all-zeros) - em push misto
  # (delecao + ref real), a 1a linha pode ser a delecao e seu remote sha
  # (tip do branch apagado) seria uma base errada para o range do Gate 3.
  # Cai para a 1a linha se nao houver ref real (caso impossivel de alcancar
  # aqui - delecao pura ja sai como exit 0 - mas seguro). O stdout capturado
  # e o sha APENAS (mensagens vao para o stderr do hook, nao para a
  # substitution) - SEM o footgun do awk antigo de imprimir duas linhas e
  # quebrar o --since do Gate 3.
  # exit 0 do checker = TODAS as refs com local sha all-zeros (delecao
  # pura) -> o atalho abaixo pula os gates; exit 1 = roda normal.
  if PRE_PUSH_REMOTE_SHA="$(node scripts/check-push-deletion.mjs)"; then
    PRE_PUSH_PURE_DELETION=0
  else
    PRE_PUSH_PURE_DELETION=1
  fi
fi
export PRE_PUSH_REMOTE_SHA

# ATALHO DE DELECAO PURA (medicao 2026-08, secao 8.4: ~74s por push): um push
# que so apaga branches (`git push origin --delete x` / `:x`) nao transporta
# NENHUM commit novo - rodar a cadeia inteira e testar nada. O checker ja
# decidiu no spawn acima (exit 0 = delecao pura, sec 11.21); aqui so o echo
# + exit - 1 spawn node total (front path ~0.17s medido vs ~0.28s do
# caminho cat+awk+node antigo, sec 11.21 - o run REAL completo do hook
# mediu 0.21s no total). Push MISTO (delecao + ref real na mesma chamada)
# roda os gates normal - carrega codigo. Stdin vazio (invocacao manual)
# tambem roda normal.
if [ "${PRE_PUSH_PURE_DELETION:-1}" = "0" ]; then
  echo "[skip] pre-push: push de delecao pura (sem commits novos) - gates pulados (housekeeping de branches, secao 8.4)"
  exit 0
fi

# Encoding gate unico (UTF-8 + VPS ASCII + ASCII-safe proof + baseline): o
# mesmo gate que o CI roda em PR (pr-check.yml / utf8-check.yml) - um byte
# non-ASCII num .sh/hook nunca chega nem ao push. Custo medido ~1.4s
# (batched, 2 spawns node + 1 python) - node+python3, sem rede.
bash scripts/verify-encoding.sh --dry-run --ci src/

# Docs corruption audit (informational - NEVER blocks): varre todos os .md,
# .css e .html sob git (a superficie completa, nao so src/) com
# scan-non-ascii.mjs --utf8 --report, emitindo warnings em stderr mas SEMPRE
# exit 0. NAO substitua por `bash scripts/check-utf8.sh --ext md --ci`: esse
# comando so varre src/ + dirs fixos, que tem ZERO .md - e --ci seria
# bloqueante. Esta auditoria e informativa e varre a superficie real (75
# .md, 1 .css, 0 .html hoje). Custo medido < 1s.
bash scripts/check-docs-encoding.sh

# Guard de integridade do node_modules (2026-08, sec. 8.5 do gates-proofs.md):
# o `bun install` COMUM confia no layout existente e NAO repara node_modules
# divergente (reportou "no changes" com react/react-dom duplicados -> 114
# testes vermelhos por invalid hook call, nao por regressao). A classe 8.5 e
# LOCAL (o CI instala do lock fresco em checkout) - este guard roda tambem no
# pre-commit e aqui, ANTES do fuzz mapeado abaixo, para um push nao gastar
# ~53s de fuzz num node_modules divergente. Compara a versao instalada de
# react/react-dom com a resolucao do bun.lock e falha com o comando de cura
# (install limpo) quando divergem. Custo <10ms (2 reads de package.json + 1
# do lock, puro node). O CI nao precisa (checkout fresco instala do lock).
node scripts/check-node-modules-integrity.mjs

# Gate de fuzz MAPEADO (adocao da secao 11.11, medicao 2026-08-10): o
# fuzz:ci de 6 spawns custava ~40.4s (71% do push); o runner mapeado roda SO
# as suites cujos alvos foram tocados no diff do push (mesmo escopo do Gate 3)
# e BATCHA numa unica invocacao vitest - tipico ~6-14s, ate o pior caso
# (helper compartilhado = todas as 6) e ~14.5s vs 40.4s. Sem range (primeiro
# push da branch / rodada manual, --since all-zeros) -> fallback para o fuzz
# COMPLETO batched. Zero suites mapeadas (docs/admin/ui) -> skip exit 0.
# O CI continua rodando `bun run fuzz:ci` (run-all-fuzz.mjs --json) em
# checkout fresco como AUTORIDADE inalterada - o runner local nunca mascara o
# CI, so corta o custo. O contrato do scan-push-full-suite.mjs trava este
# comando (positivo) e o fuzz fora do pre-commit (negativo).
node scripts/run-mapped-fuzz.mjs --since "${PRE_PUSH_REMOTE_SHA:-}"

# Gates do CI antes do push (validate-cache-manifest + check-js-budget + testes
# unitarios das areas tocadas) - espelhando o pre-commit: nenhum push pode
# quebrar o que o CI verifica depois de ja estar localmente verde.
# (O stdin do hook ja foi capturado no topo - o PRE_PUSH_REMOTE_SHA exportado
# alimenta o Gate 3 e o atalho de delecao pura acima.)
bun run pre-push:gates