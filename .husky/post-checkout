#!/usr/bin/env sh
set -euo pipefail

# post-checkout hook
# $1 = previous HEAD SHA, $2 = new HEAD SHA, $3 = 1 (branch) or 0 (file)
#
# Instala dependências automaticamente quando package.json ou o lockfile
# mudam entre checkouts (troca de branch, git pull, etc.).

if [ "$3" = "1" ]; then
  CHANGED=$(git diff --name-only "$1" "$2" 2>/dev/null || echo "")

  # O repo unificou os lockfiles em SÓ bun.lock (removidos package-lock.json
  # e pnpm-lock.yaml em 08/2026) — os padrões antigos (pnpm-lock.yaml,
  # bun.lockb) não disparam mais o install automático quando o lockfile muda.
  if echo "$CHANGED" | grep -qE "^package\.json$|^bun\.lock$"; then
    echo "📦 Dependências alteradas — executando bun install..."
    bun install
    echo "✅ bun install concluído"
  fi
fi
