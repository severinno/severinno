# ── Docker Secrets ──────────────────────────────────────────────────────
# This directory contains Docker secret files for production deployment.
# DO NOT commit actual secrets to git!
#
# HOW TO USE:
#   1. Copy secrets/*.secret.example to secrets/*.secret (without .example)
#   2. Fill in the actual secret values
#   3. Run: docker compose --env-file .env.production up -d
#
# In production (Docker Swarm):
#   docker secret create postgres_password ./secrets/postgres_password.secret
#   docker stack deploy -c docker-compose.prod.yml severinno

# Ignore everything by default
*

# Exception: allow .example files and this .gitignore
!*.example
!.gitignore
!README.md
