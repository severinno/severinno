# =============================================================================
# Severinno — Caddyfile (Production-ready)
# =============================================================================
# Reverse proxy with TLS: local (mkcert) + prod (Let's Encrypt).
#
# Reload:  sudo systemctl reload caddy
# Logs:    journalctl -u caddy -f
# =============================================================================

# ── HTTP → HTTPS redirect ────────────────────────────────────────────────────
http://severinno.local {
	redir https://severinno.local{uri} permanent
}

http://severinno.com {
	redir https://severinno.com{uri} permanent
}

www.severinno.com {
	redir https://severinno.com{uri} permanent
}

# ── Local dev (mkcert TLS) ───────────────────────────────────────────────────
severinno.local {
	tls /etc/caddy/certs/severinno.local+3.pem /etc/caddy/certs/severinno.local+3-key.pem

	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		health_status 200
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
		# CSP removida (09/2026): definida no proxy.ts do Next.js com nonce por-request.
		# Um header estático aqui sobrescreveria os nonces e quebraria os scripts.
	}

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/severinno.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ── Production (Let's Encrypt auto-HTTPS) ────────────────────────────────────
severinno.com {
	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		health_status 200
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
		# CSP removida (09/2026): definida no proxy.ts do Next.js com nonce por-request.
		# Um header estático aqui sobrescreveria os nonces e quebraria os scripts.
	}

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/severinno.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
