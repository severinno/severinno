# =============================================================================
# Severinno — Caddyfile (Production-ready)
# =============================================================================
# Reverse proxy with TLS: local (mkcert) + prod (Let's Encrypt).
#
# Reload:  sudo systemctl reload caddy
# Logs:    journalctl -u caddy -f
# =============================================================================

# ── HTTP → HTTPS redirect ────────────────────────────────────────────────────
http://severinno.local {
	redir https://severinno.local{uri} permanent
}

http://severinno.com {
	redir https://severinno.com{uri} permanent
}

www.severinno.com {
	redir https://severinno.com{uri} permanent
}

# ── Local dev (mkcert TLS) ───────────────────────────────────────────────────
severinno.local {
	tls /etc/caddy/certs/severinno.local+3.pem /etc/caddy/certs/severinno.local+3-key.pem

	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		health_status 200
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://*.tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.tiles.mapbox.com https://api.mapbox.com; font-src 'self' data:; connect-src 'self' http://localhost:* https://*.tiles.mapbox.com https://api.mapbox.com wss://severinno.local ws://severinno.local; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/severinno.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ── Production (Let's Encrypt auto-HTTPS) ────────────────────────────────────
severinno.com {
	reverse_proxy localhost:3000 {
		header_up X-Real-IP {remote_host}
		transport http {
			read_timeout 30s
			write_timeout 30s
			dial_timeout 5s
		}
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		health_status 200
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://*.tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.tiles.mapbox.com https://api.mapbox.com; font-src 'self' data:; connect-src 'self' https://*.tiles.mapbox.com https://api.mapbox.com wss://severinno.com ws://severinno.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	request_body {
		max_size 10MB
	}

	log {
		output file /var/log/caddy/severinno.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
