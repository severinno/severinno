# ============================================================================
# Severinno Marketplace SaaS — Lightweight Worker Dockerfile
# Only includes runtime deps for RabbitMQ consumers (no Next.js build).
# Usage: docker compose --profile workers up -d
# ============================================================================

# Versão do Bun — FONTE ÚNICA: vars.BUN_VERSION (build-arg do deploy.yml).
# Sem literal (oven/bun:1 era tag flutuante) — o guard check-bun-mirror.mjs
# falha se um Dockerfile pinar tag hardcoded.
ARG BUN_VERSION

# As bases são PINADAS POR DIGEST: `:${BUN_VERSION}@sha256:…` é o digest do
# ÍNDICE multi-arch da tag correspondente à versão declarada (resolvido em
# 2026-10-02 com `docker buildx imagetools inspect oven/bun:1.3.14`; hoje
# BUN_VERSION=1.3.14, cf. packageManager/env.gitea.example). O pull é pelo
# digest — imutável — e a tag fica como LEITURA. O digest anda JUNTO com a
# versão: bump da BUN_VERSION sem o digest novo constrói com o Bun ANTIGO em
# silêncio (o digest vence a resolução; a tag não é validada no pull).

# ── Stage 1: Dependencies ──────────────────────────────────────────────────
FROM oven/bun:${BUN_VERSION}@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS deps
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

# ── Stage 2: Build ─────────────────────────────────────────────────────────
FROM oven/bun:${BUN_VERSION}@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY prisma ./prisma

# Generate Prisma client (needs devDeps which we dodge by copying from deps)
RUN bunx prisma generate

# ── Stage 3: Runner ────────────────────────────────────────────────────────
FROM oven/bun:${BUN_VERSION}@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN groupadd --gid 1001 appuser && \
    useradd --uid 1001 --gid 1001 appuser

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
    libvips openssl \
    && rm -rf /var/lib/apt/lists/*

# Prisma client + schema + migrations
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/prisma ./prisma

# Runtime node_modules (production only)
COPY --from=deps /app/node_modules ./node_modules

# O pacote `server-only` lança erro quando importado fora do runtime de React
# Server Components — e os consumers rodam Bun puro (fora do Next). Várias
# libs de src/lib usadas pelos consumers são marcadas server-only
# legitimamente (são código de servidor), então aqui o pacote vira no-op
# APENAS nesta imagem; a imagem do app mantém o guard real.
RUN printf 'module.exports = {};\n' > node_modules/server-only/index.js

# Worker source code
COPY src/queue ./src/queue
COPY src/lib ./src/lib
COPY src/types ./src/types
# O Bun resolve o alias `@/*` pelo tsconfig.json — sem ele, imports como
# `@/lib/db` falham em runtime ("Cannot find module '@/lib/db'").
COPY tsconfig.json ./
COPY package.json ./

RUN chown -R appuser:appuser /app
USER appuser

COPY --chown=appuser:appuser scripts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD bun --eval "process.exit(0)" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
