# =============================================================================
# Severinno Marketplace — Variáveis de Ambiente para STAGING (Homologação)
# =============================================================================
# INSTRUÇÕES DE USO NO AMBIENTE STAGING:
# 1. Copie este arquivo para .env.staging:
#    cp .env.staging.example .env.staging
# 2. Inicie o stack staging com:
#    docker compose -f docker-compose.staging.yml --env-file .env.staging up -d --build
# =============================================================================

NODE_ENV=production
LOG_LEVEL=debug

# ── Domínio & Aplicação Staging ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
REALTIME_URL=http://realtime-staging:3003
# Chave do /emit (fail-closed em staging se NODE_ENV=production). Mesma chave no app.
REALTIME_EMIT_API_KEY=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:3001

# ── Criptografia de Sessão & Cookies (mínimo 32 caracteres) ──────────────────
SESSION_SECRET=staging_session_secret_min_32_chars_long!!

# ── Banco de Dados (PostgreSQL 16 + PostGIS Staging) ─────────────────────────
POSTGRES_USER=severinno_staging
POSTGRES_PASSWORD=severinno_staging_pass
POSTGRES_DB=severinno_staging
DATABASE_URL=postgresql://severinno_staging:severinno_staging_pass@pgbouncer-staging:6432/severinno_staging?schema=public
DIRECT_URL=postgresql://severinno_staging:severinno_staging_pass@postgres-staging:5432/severinno_staging?schema=public

# ── Cache Distribuído & Rate Limit (Redis 7 Staging) ─────────────────────────
REDIS_URL=redis://redis-staging:6379

# ── Fila de Mensagens Assíncronas (RabbitMQ 4 Staging) ──────────────────────
RABBITMQ_DEFAULT_USER=severinno_staging
RABBITMQ_DEFAULT_PASS=severinno_staging_pass
RABBITMQ_URL=amqp://severinno_staging:severinno_staging_pass@rabbitmq-staging:5672

# ── Armazenamento de Arquivos S3 (MinIO Staging) ─────────────────────────────
S3_ENDPOINT=http://minio-staging:9000
S3_REGION=auto
S3_ACCESS_KEY=minio_staging_key
S3_SECRET_KEY=minio_staging_secret_key
S3_BUCKET=severinno-staging-uploads
S3_PUBLIC_URL=http://localhost:9000/severinno-staging-uploads

# ── Roteamento Geoespacial OSRM ──────────────────────────────────────────────
OSRM_BASE_URL=http://osrm-staging:5000

# ── Notificações Push Staging ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=staging_vapid_public_key_mock
VAPID_PRIVATE_KEY=staging_vapid_private_key_mock
VAPID_SUBJECT=mailto:staging@severinno.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=staging_vapid_public_key_mock

# ── Gateway de Pagamento Lytex (Sandbox) ─────────────────────────────────────
LYTEX_ENV=sandbox
LYTEX_BASE_URL=https://sandbox.api-pay.lytex.com.br
LYTEX_CLIENT_ID=staging_mock_client_id
LYTEX_CLIENT_SECRET=staging_mock_client_secret
PAYMENT_WEBHOOK_SECRET=staging_mock_webhook_secret

# ── Cron Jobs & Telemetria ──────────────────────────────────────────────────
CRON_SECRET=staging_cron_secret_mock
OTEL_ENABLED=true
OTEL_SERVICE_NAME=severinno-staging
