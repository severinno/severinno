# =============================================================================
# Severinno — Environment Variables Reference (.env.example)
#
# 1) cp .env.example .env
# 2) Fill in the real values (NEVER commit actual secrets)
# All variables are REQUIRED unless marked [optional].
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/severinno
DB_PASSWORD=

# ── Redis (cache + queues) ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RabbitMQ (async workers) ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://localhost:5672

# ── Realtime / WebSocket ─────────────────────────────────────────────────────
REALTIME_URL=http://localhost:3000

# ── S3-compatible storage (photos / uploads) ─────────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=severinno
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── SMTP (email) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Severinno <no-reply@example.com>

# ── VAPID (web push notifications) ───────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@severinno.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Auth / Security ──────────────────────────────────────────────────────────
# SESSION_SECRET must be at least 32 characters
SESSION_SECRET=change-me-to-a-random-32-char-secret
CRON_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ── External APIs ────────────────────────────────────────────────────────────
# Geolocation / routing
OSRM_BASE_URL=http://router.project-osrm.org

# WhatsApp integration
WHATSAPP_API_URL=https://api.whatsapp.example.com
WHATSAPP_API_KEY=

# AI (LLM) — Groq / OpenAI-compatible endpoint
AI_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

# Lytex (document generation) [optional]
LYTEX_BASE_URL=
LYTEX_ENV=
LYTEX_CLIENT_ID=
LYTEX_CLIENT_SECRET=

# ── Observability (Glitchtip — Sentry-compatible) [optional] ────────────────
GLITCHTIP_DSN=
GLITCHTIP_INTERNAL_URL=
GLITCHTIP_SECRET=
NEXT_PUBLIC_GLITCHTIP_DSN=
