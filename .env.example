# =============================================================================
# .env.example — template de envs NÃO-secretas (timeouts de clientes HTTP/TCP)
#
# Rastreado de propósito (exceção no .gitignore, como o .env.glitchtip.example):
# o guard scripts/check-timeout-envs.mjs exige que todo `*_TIMEOUT_MS` usado em
# src/ esteja documentado AQUI (com o mesmo default em ms), na tabela "Fetch
# timeouts" do README e nos composes (docker-compose.yml + prod). Alterar um
# default em src/ sem atualizar estes 3 lugares falha o guard.
#
# Valores em milissegundos. Segredos NÃO entram aqui — vivem em
# secrets/*.secret.example e são injetados via docker secrets.
# =============================================================================

# ── Fetch/HTTP timeouts (ms) ──────────────────────────────────────────────
API_TIMEOUT_MS=15000
UPLOAD_TIMEOUT_MS=60000
OSRM_TIMEOUT_MS=5000
SLACK_TIMEOUT_MS=10000
WHATSAPP_TIMEOUT_MS=10000
LYTEX_TIMEOUT_MS=10000
EVOLUTION_TIMEOUT_MS=10000
GLITCHTIP_TIMEOUT_MS=5000
ALERT_WEBHOOK_TIMEOUT_MS=5000
REALTIME_EMIT_TIMEOUT_MS=3000
# Porta do realtime mini-service (fallback 3003). Smoke de boot em porta
# alternativa: REALTIME_PORT=3199 bun mini-services/realtime/index.ts
REALTIME_PORT=3003
# Escala horizontal do realtime (N réplicas): o serviço attacha o
# @socket.io/redis-adapter (rooms/broadcasts compartilhados) quando REDIS_URL
# está presente — o mesmo Redis usado pelo app. Sem REDIS_URL → single-node
# (fail-open). Em multi-réplica, o gateway precisa de STICKY SESSIONS no
# /socket.io/* (Caddyfile.prod: lb_policy cookie severinno_realtime) porque a
# conexão socket.io é estado in-memory do engine.io da réplica que a aceitou.
REDIS_URL=
# Intervalo do sweep de TTL do cookie no realtime (ms; default 60000; clamp
# >= 1000). Baixo em dev/CI acelera o spec e2e/realtime-ttl-sweep.spec.ts.
# Limite de sessoes simultaneas por usuario: default global
# (REALTIME_MAX_SESSIONS_PER_USER), override POR ROLE (JSON) e override POR
# PLANO/TENANT (JSON — plano do usuario lido do banco no join, fail-open).
# Ex.: REALTIME_MAX_SESSIONS_PER_ROLE='{"CLIENT":1,"PROVIDER":2,"ADMIN":5}'
#      REALTIME_MAX_SESSIONS_PER_PLAN='{"FREE":1,"PREMIUM":5}'
# Intervalo do sweep de TTL do cookie no realtime (ms; default 60000; clamp
# >= 1000). Baixo em dev/CI acelera o spec e2e/realtime-ttl-sweep.spec.ts.
REALTIME_TTL_SWEEP_MS=
# Threshold de SPIKE do TTL sweep no /health do realtime: mais que N sockets
# encerrados com session_expired num MESMO minuto acende o flag spike — sinal
# de ataque de sessoes stale (lote de cookies vencendo juntos) ou bug de
# rotatividade (session:renew nao propagando). Default 50/min; 0/negativo/NaN
# → default.
REALTIME_EXPIRED_SPIKE_THRESHOLD=

# ── TTL do cookie de sessao do app (segundos) ────────────────────────────
# SESSION_COOKIE_MAX_AGE_SECONDS: TTL global (default 30d; clamp >= 60).
# SESSION_COOKIE_MAX_AGE_PER_ROLE: TTL POR ROLE (JSON; override do global;
# role sem override usa o global). Ex.:
#   SESSION_COOKIE_MAX_AGE_PER_ROLE='{"CLIENT":1296000,"PROVIDER":2592000,"ADMIN":604800}'
# O realtime NAO le estas envs — o sweep usa o expiresAt embutido e assinado
# no cookie de cada socket, entao variar o TTL por role nunca dessincroniza.
SESSION_COOKIE_MAX_AGE_SECONDS=
SESSION_COOKIE_MAX_AGE_PER_ROLE=
GEO_CEP_TIMEOUT_MS=10000

# ── Job de alerta de sockets órfãos persistidos ──────────────────────────
# Cron GET /api/cron/realtime-orphan-alert (Bearer CRON_SECRET, a cada ~5min).
# Lê a flag realtime:telemetry:multi:flag + os N buckets de minuto: o alerta
# (GlitchTip/Sentry + email para ADMIN_EMAIL) dispara só quando sockets órfãos
# persistirem por N minutos seguidos.
ORPHAN_ALERT_MINUTES=5
# Cooldown entre alertas REAIS (ms); dry-run e runs limpos não marcam.
ORPHAN_ALERT_COOLDOWN_MS=3600000
# Destinatário do email do job (sem valor → só Sentry/GlitchTip).
ADMIN_EMAIL=

# ── Piso global do fetch + clientes de dados (ms) ─────────────────────────
GLOBAL_FETCH_TIMEOUT_MS=60000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=10000
S3_REQUEST_TIMEOUT_MS=30000
