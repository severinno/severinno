# Severinno Marketplace — Environment Variables (template)
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores.
# As vars marcadas com NEXT_PUBLIC_ são expostas ao cliente (não coloque
# segredos nelas).
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
# URL pública do site (usada em emails, sitemap, OG tags, etc.)
NEXT_PUBLIC_APP_URL=https://severinno.com.br

# Chave secreta para criptografar cookies de sessão (mínimo 32 caracteres)
SESSION_SECRET=your-secret-at-least-32-chars-long

# Nível de log: trace | debug | info | warn | error
LOG_LEVEL=info

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DATABASE_URL=postgresql://severinno:severinno@localhost:5432/severinno

# ── Cache (Redis) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Queue (RabbitMQ) ────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://severinno:severinno@localhost:5672

# ── Storage (S3-compatible — MinIO / AWS S3) ───────────────────────────────
# MinIO (self-hosted, dev default):
#   Endpoint: http://localhost:9000
#   Access/Secret: severinno / severinno_minio_dev (dev) ou severinno_minio_secret (prod)
#   Console UI: http://localhost:9001 (login com as mesmas credenciais)
#
# Para R2/AWS S3, mantenha S3_ENDPOINT e S3_PUBLIC_URL apontando para o serviço.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=severinno
S3_SECRET_KEY=severinno_minio_dev
S3_BUCKET=severinno
# Deixe vazio para usar o endpoint direto. Em produção, aponte para seu CDN.
S3_PUBLIC_URL=

# ── Realtime (Socket.io) ────────────────────────────────────────────────────
# URL do servidor WebSocket (mini-services/realtime)
REALTIME_URL=http://localhost:3003

# ── OSRM (Routing — cálculo de distância entre coordenadas) ─────────────────
OSRM_BASE_URL=http://localhost:5000

# ── AI Chat (Assistente Virtual) ────────────────────────────────────────────
# Chave da API Groq (https://console.groq.com/keys) — modelo gratuito disponível
GROQ_API_KEY=gsk_your_groq_api_key_here

# URL base da API de IA (OpenAI-compatible). Padrão: https://api.groq.com/openai/v1
# Altere para outro provedor (OpenAI, Anthropic via API compatível, etc.)
AI_BASE_URL=https://api.groq.com/openai/v1

# ── Push Notifications (Web Push / VAPID) ───────────────────────────────────
# Gerar par de chaves: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@severinno.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# ── SMTP (Transactional Email — Hostinger / outros) ─────────────────────────
SMTP_HOST=smtp.hostinger.com.br
SMTP_PORT=465
SMTP_USER=severinno@severinno.com.br
SMTP_PASS=your-password
SMTP_FROM=severinno@severinno.com.br

# ── Lytex Pagamentos (PIX / gateway de pagamento) ───────────────────────────
# Ambiente: sandbox | production (padrão)
LYTEX_ENV=production
LYTEX_BASE_URL=https://api-pay.lytex.com.br
LYTEX_CLIENT_ID=your-lytex-client-id
LYTEX_CLIENT_SECRET=your-lytex-client-secret
LYTEX_PARTNER_ID=your-partner-id-optional

# Secret para validar webhooks do Lytex (pode ser configurado também no
# painel admin > Configurações se não for definido aqui)
PAYMENT_WEBHOOK_SECRET=your-webhook-signing-secret

# ── Cron (Tarefas agendadas) ────────────────────────────────────────────────
# Protege os endpoints /api/cron/* contra chamadas externas não autorizadas
CRON_SECRET=change-me-to-a-random-secret

# ── Monitoring (GlitchTip — self-hosted error tracking, MIT license) ──────
# GlitchTip DSN (self-hosted). Create DSN via GlitchTip UI at:
#   http://localhost:8000 (dev) or https://severinno.com.br/errors (prod)
# After first login, create a project and copy the DSN from the project settings.
#
# IMPORTANT: Both client and server need access:
#   - NEXT_PUBLIC_GLITCHTIP_DSN: exposed to the browser (public)
#   - GLITCHTIP_DSN: server-side only (same value, but not required to be public)
#
# Temporary DSN for testing (replace after first GlitchTip setup):
#   http://public-key@glitchtip:8000/project-id
#
NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_DSN=
# Internal URL for the tunnel proxy (Docker network — not exposed to browser)
GLITCHTIP_INTERNAL_URL=http://glitchtip:8000
# Secret key for GlitchTip Django app (generate with: openssl rand -hex 32)
GLITCHTIP_SECRET=change-me-to-a-random-64-char-secret
# Override auto-detected release (default: severinno@0.2.0)
SENTRY_RELEASE=

# ── SEO / Google ────────────────────────────────────────────────────────────
# Código de verificação do Google Search Console
GOOGLE_VERIFICATION=

# ── WhatsApp (Evolution API — Gateway Open Source) ──────────────────────────
# URL da Evolution API (Docker: http://evolution-api:8080, local: http://localhost:8080)
WHATSAPP_API_URL=http://localhost:8080
# Chave de autenticação da Evolution API (definida no docker-compose.yml)
WHATSAPP_API_KEY=severinno_evolution_key

# ── Docker (compose) ────────────────────────────────────────────────────────
# Senha do banco PostgreSQL usada no docker-compose.yml
DB_PASSWORD=severinno
