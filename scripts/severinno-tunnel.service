[Unit]
Description=Severinno — Cloudflare Named Tunnel
Documentation=https://developers.cloudflare.com/cloudflare-one/connections/connect-apps/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=severinno
Group=severinno
ExecStart=/home/severinno/cloudflared tunnel --config /home/severinno/.cloudflared/config.yml run
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Environment
Environment=HOME=/home/severinno

[Install]
WantedBy=multi-user.target
