0"/><link rel="shortcut icon" href="/favicon/favicon-16x16.ico"/><link rel="icon" href="/favicon/favicon-32x32.ico"/><link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png"/><script src="/_next/static/chunks/0cz1d0mv5g_q7.js" noModule=""></script></head><body class="flex flex-col min-h-screen font-sans bg-black text-white inter_2d5484bc-module__zjbEJG__variable jetbrains_mono_d445f811-module__kZeNpG__variable"><div hidden=""><!--$--><!--/$--></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Freebuff","url":"https://freebuff.com","logo":"https://freebuff.com/logo-icon.png","sameAs":["https://github.com/CodebuffAI/codebuff","https://codebuff.com"]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"Freebuff","url":"https://freebuff.com","potentialAction":{"@type":"SearchAction","target":"https://freebuff.com/blog?q={search_term_string}","query-input":"required name=search_term_string"}}</script><script type="application/json">((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=["light","dark"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c="class"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&"system"===a?window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light":a;k(d)}catch(a){}})("class","theme","system","dark",["light","dark"],null,true,true)</script><div class="flex-grow"><script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareApplication","name":"Freebuff","alternateName":["Freebuff CLI","Freebuff Web"],"applicationCategory":"DeveloperApplication","operatingSystem":"macOS, Windows, Linux","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.9","ratingCount":"512","bestRating":"5"},"description":"Freebuff is a free CLI coding agent and a free full-stack app builder. The free alternative to Claude Code, Cursor, OpenAI Codex, Lovable, Replit Agent, Bolt.new, Windsurf, Emergent, and Devin.","url":"https://freebuff.com","softwareVersion":"1.0","downloadUrl":"https://freebuff.com","installUrl":"https://freebuff.com/get-started","featureList":["Free CLI coding agent for the terminal","Free full-stack web app builder (Freebuff Web)","9 specialized subagents including code review and browser testing","No subscription or credit card required"],"sameAs":["https://codebuff.com","https://www.npmjs.com/package/freebuff"]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How can it be free?","acceptedAnswer":{"@type":"Answer","text":"Freebuff is supported by text ads."}},{"@type":"Question","name":"What models do you use?","acceptedAnswer":{"@type":"Answer","text":"Freebuff offers a curated choice of leading models. In full mode, the regular picker includes:\n\n- GPT-5.6 Luna: Strong all-around.\n- DeepSeek V4 Flash 07/31: Smart & Fast. May use data for AI training.\n- MiMo 2.5: Balanced.\n- GLM 5.3 Flash: Deep reasoning.\n\nGPT-5.6 Luna is the default on CLI, Desktop, Web, and Cloud. Limited mode uses MiMo 2.5.\n\nGLM 5.2 is available through earned sessions, while Gemini 3.1 Flash Lite handles specialist tasks such as file finding and research."}},{"@type":"Question","name":"Which countries is Freebuff available in?","acceptedAnswer":{"@type":"Answer","text":"All countries. Freebuff is available in \"full\" or \"limited\" mode. The following countries have full access:\n\nUnited States, Canada, United Kingdom, Australia, New Zealand, Norway, Sweden, Netherlands, Denmark, Germany, France, Italy, Spain, Portugal, Finland, Belgium, Luxembourg, Liechtenstein, Switzerland, Austria, Singapore, Malta, Israel, Ireland, and Iceland.\n\nIf you are outside those countries or using a VPN, Freebuff still works in limited mode."}},{"@type":"Question","name":"What is limited mode?","acceptedAnswer":{"@type":"Answer","text":"Limited mode lets you use Freebuff outside the full-access countries, or while using a VPN. It includes MiMo 2.5, with 3 one-hour sessions per day, and you can earn up to 7 by engaging with promoted posts on the Earn page."}},{"@type":"Question","name":"Does Freebuff collect my data?","acceptedAnswer":{"@type":"Answer","text":"Freebuff is supported by text ads. We do not collect your traces or files unless the model provider does. Currently, this applies only to DeepSeek models."}},{"@type":"Question","name":"What else is cool in Freebuff?","acceptedAnswer":{"@type":"Answer","text":"Freebuff comes with 9 specialized subagents:\n- file-picker finds relevant files across your codebase\n- code-reviewer gives critical feedback on your changes\n- browser-use lets the AI control a real browser to test your app\n- thinker does deep reasoning\n- and more.\n\nAfter every response, it generates 3 clickable follow-up suggestions so you always know what to do next.\n\nFor big tasks, try the commands /interview → /plan → (implement) → /review to go from idea to polished code."}}]}</script><div class="dark relative min-h-screen bg-black font-paragraph font-light text-white"><header class="lp-gpu fixed inset-x-0 top-0 z-50" style="opacity:0;transform:translateY(-10px)"><div aria-hidden="true" style="opacity:0" class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/90 via-black/55 to-transparent"></div><div style="transform:none" class="relative flex min-w-0 items-center justify-between gap-2 sm:gap-3 mx-auto max-w-6xl px-6 py-4 sm:px-10 lg:px-12"><div style="transform:none" class="flex min-w-0 flex-1 items-center gap-1 sm:gap-2 lg:gap-3"><a class="group flex flex-shrink-0 items-center gap-2.5 opacity-65 transition-opacity duration-200 hover:opacity-100" href="/"><img alt="Freebuff" loading="laz