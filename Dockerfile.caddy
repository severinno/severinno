# ============================================================================
# Dockerfile.caddy — Caddy com os plugins que o Caddyfile.prod exige
# ============================================================================
# O Caddyfile.prod usa `rate_limit` (mholt/caddy-ratelimit) e o encoder
# `format transform` (caddyserver/transform-encoder — CLF para o fail2ban).
# NENHUM dos dois existe na imagem stock caddy:2-alpine: com ela, o parse
# inteiro crasha no boot ("unrecognized directive: rate_limit", provado com
# caddy validate em 2026-10-02). Este build custom é OBRIGATÓRIO para o
# serviço caddy do docker-compose.prod.yml.
#
# Tudo PINADO (lição do check-runner-tag: quem decide a versão é a IMAGEM):
#   - base Caddy v2.11.4 (a versão que o caddy:2-alpine entregava em 10/2026)
#   - caddy-ratelimit v0.1.0
#   - transform-encoder v0.0.0-20260423033309-ba4124974830
#
# Fluxo: o job `build` do deploy.yml PUBLICA esta imagem no registry
# (${REGISTRY}/${IMAGE_NAME}:caddy-2.11.4-plugins + :caddy-<sha> para
# rollback) e o `deploy` puxa/sobe o serviço — a VPS NUNCA compila xcaddy.
# Rebuild local (após mudar o Caddyfile ou as versões):
#   docker compose build caddy && docker compose up -d caddy
#
# Prova de parse com os plugins (o validate do arquivo INTEIRO passa):
#   docker compose build caddy
#   docker compose run --rm --no-deps --entrypoint caddy caddy \
#     validate --adapter caddyfile --config /etc/caddy/Caddyfile
# ============================================================================

FROM caddy:2.11.4-builder-alpine AS builder

RUN xcaddy build v2.11.4 \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --with github.com/caddyserver/transform-encoder@v0.0.0-20260423033309-ba4124974830

FROM caddy:2.11.4-alpine

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
