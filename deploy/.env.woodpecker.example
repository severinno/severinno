# =============================================================================
# .env.woodpecker — Variáveis de Ambiente para Woodpecker CI
# =============================================================================
# Copie este arquivo para .env.woodpecker e preencha com seus valores.
# =============================================================================

# ── Woodpecker Server ──────────────────────────────────────────────────────
# URL pública do Woodpecker (ex: https://ci.severinno.com ou http://IP:8000)
WOODPECKER_HOST=http://severinno.cloud:8000

# ── GitHub OAuth App ───────────────────────────────────────────────────────
# Crie um OAuth App em: https://github.com/settings/developers
# 1. Clique em "New OAuth App"
# 2. Application name: Severinno CI
# 3. Homepage URL: http://severinno.cloud:8000
# 4. Authorization callback URL: http://severinno.cloud:8000/api/auth
# 5. Copie Client ID e Client Secret
WOODPECKER_GITHUB_CLIENT=your_github_client_id
WOODPECKER_GITHUB_SECRET=your_github_client_secret

# ── Agent Secret ───────────────────────────────────────────────────────────
# Gere um secret aleatório: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=your_agent_secret

# ── GitHub Container Registry (para push de imagens) ──────────────────────
# Crie um Personal Access Token com permissão write:packages
GHCR_USERNAME=severinno
GHCR_TOKEN=your_ghcr_token

# ── Deploy VPS ─────────────────────────────────────────────────────────────
# Credenciais SSH para deploy no VPS
DEPLOY_HOST=severinno.cloud
DEPLOY_USER=deploy
DEPLOY_KEY=your_ssh_private_key

# ── Notificações (opcional) ────────────────────────────────────────────────
# Telegram Bot Token e Chat ID para notificações
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
