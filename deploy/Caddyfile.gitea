# =============================================================================
# Caddyfile.gitea — HTTPS Reverse Proxy para Gitea Self-Hosted
# =============================================================================
# HTTPS automatico via Let's Encrypt / ZeroSSL.
# O Caddy faz proxy reverso para o Gitea (porta 3000) e suporta
# SSE para Gitea Actions.
#
# Uso: Montar como volume no docker-compose.gitea.yml
# =============================================================================

{
  email admin@severinno.com
  admin 0.0.0.0:2019
  # ocsp_stapling removido (28/09/2026): a diretiva não existe mais no Caddy 2.8+
  # (stapling automático) e o parse dela crasha o container no arranque.
  # storage removido (29/09/2026): `storage file:///data/caddy` não é sintaxe
  # válida de Caddyfile (o módulo seria file_system) e é redundante — /data/caddy
  # já é o default da imagem oficial; o parse dela crasha o arranque.
}

# =============================================================================
# DOMINIO PRINCIPAL — git.severinno.com (Gitea Web UI)
# (28/09/2026: o domínio severinno.cloud EXPIROU e foi liberado — a forja
# migra para o subdomínio do domínio VIVO; o A record git.severinno.com →
# 187.127.16.136 é condição do HTTPS automático)
# =============================================================================
git.severinno.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
    -X-Powered-By
  }

  # Health check interno
  handle /health {
    respond "OK" 200 {
      close
    }
  }

  # Registry OCI (imagens das actions) — leitura pública, escrita só via
  # 127.0.0.1:5000 na VPS (o registry NÃO publica porta de escrita).
  # `route` garante a ordem escrita: o bloqueio de escrita roda ANTES do proxy
  # (o `respond` solto era atropelado pela ordenação de diretivas do Caddy).
  handle /v2/* {
    route {
      @v2escrita method PUT POST DELETE PATCH
      respond @v2escrita "Forbidden" 403
      reverse_proxy registry:5000
    }
  }

  # Gitea Actions SSE (Server-Sent Events) — streaming
  handle /api/actions/* {
    reverse_proxy gitea:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      flush_interval -1
    }
  }

  # Tudo o mais → Gitea
  handle {
    reverse_proxy gitea:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}

      health_uri /
      health_interval 30s
      health_timeout 5s
      health_status 200
    }
  }

  log {
    output file /var/log/caddy/gitea-access.log {
      roll_size 50mb
      roll_keep 3
      roll_keep_for 720h
    }
    # `transform` não existe no Caddy 2.8 (era plugin): json é o formato canônico
    format json
    level INFO
  }

  handle_errors {
    @4xx {
      expression {http.error.status_code} >= 400
      expression {http.error.status_code} < 500
    }
    handle @4xx {
      respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
    handle {
      respond "Service Unavailable" 503
    }
  }
}
