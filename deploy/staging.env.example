# =============================================================================
# Severinno Marketplace — Staging Environment Configuration
# =============================================================================
# Copy this file to .env.staging and fill in the values.
#
# Usage:
#   cp deploy/staging.env.example .env.staging
#   # Edit .env.staging with real values
#   docker compose -f docker-compose.staging.yml --env-file .env.staging up -d
# =============================================================================

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
NEXT_PUBLIC_APP_URL=https://staging.severinno.com.br
LOG_LEVEL=info

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=severinno_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=severinno_staging
DATABASE_URL=postgresql://severinno_staging:CHANGE_ME_STRONG_PASSWORD@pgbouncer:6432/severinno_staging
DIRECT_URL=postgresql://severinno_staging:CHANGE_ME_STRONG_PASSWORD@postgres:5432/severinno_staging

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=severinno_staging
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_URL=amqp://severinno_staging:CHANGE_ME_STRONG_PASSWORD@rabbitmq:5672

# ── S3/MinIO ──────────────────────────────────────────────────────────────
S3_ACCESS_KEY=staging_access_key
S3_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_BUCKET=severinno-staging-uploads
S3_PUBLIC_URL=https://staging.severinno.com.br/api/uploads
NEXT_PUBLIC_UPLOADS_BASE_URL=/api/uploads

# ── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_32_CHARACTERS_MINIMUM_SESSION_SECRET

# ── Payments (Lytex) ──────────────────────────────────────────────────────
LYTEX_CLIENT_ID=CHANGE_ME
LYTEX_CLIENT_SECRET=CHANGE_ME
LYTEX_ENV=sandbox
LYTEX_API_URL=https://sandbox-api.lytex.com.br/v1

# ── Web Push (VAPID) ──────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:staging@severinno.com.br
NEXT_PUBLIC_VAPID_PUBLIC_KEY=CHANGE_ME

# ── SMTP ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@staging.severinno.com.br

# ── WhatsApp (Evolution API) ──────────────────────────────────────────────
EVOLUTION_API_URL=CHANGE_ME
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_INSTANCE=severinno-staging

# ── Error Monitoring ──────────────────────────────────────────────────────
SENTRY_DSN=CHANGE_ME
GLITCHTIP_DSN=CHANGE_ME

# ── Routing (OSRM) ───────────────────────────────────────────────────────
OSRM_BASE_URL=http://osrm:5000

# ── Search (OpenSearch) ──────────────────────────────────────────────────
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=CHANGE_ME

# ── Tracing (OpenTelemetry) ──────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OTEL_SERVICE_NAME=severinno-staging
OTEL_SAMPLE_RATE=1.0

# ── Cron Secret ───────────────────────────────────────────────────────────
CRON_SECRET=CHANGE_ME_RANDOM_STRING

# ── Lytex Webhook Secret ─────────────────────────────────────────────────
LYTEX_WEBHOOK_SECRET=CHANGE_ME

# ── Rate Limiting ─────────────────────────────────────────────────────────
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ── Feature Flags ─────────────────────────────────────────────────────────
NOMINATIM_ENABLED=true
VIACEP_ENABLED=true
DEMO_ACCOUNTS_ENABLED=true
