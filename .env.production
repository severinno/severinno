# =============================================================================
# .env.production — Severinno Marketplace
# =============================================================================
# Copie este arquivo para .env.production e preencha os valores reais.
# NUNCA commite este arquivo com valores reais de producao!
#
# Uso:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Para gerar senhas fortes:
#   openssl rand -base64 32
#
# Para gerar chaves VAPID (Web Push):
#   npx web-push generate-vapid-keys
# =============================================================================


# ═══════════════════════════════════════════════════════════════════════════════
# 1. APP — Configuracoes gerais
# ═══════════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# URL publica do site (usada em emails, redirects, CSP)
NEXT_PUBLIC_APP_URL=https://severinno.com.br

# Secret para sessao — minimo 32 caracteres!
# Gerar: openssl rand -base64 32
SESSION_SECRET=<MUDE_AQUI_MINIMO_32_CARACTERES>

# Nivel de log: trace, debug, info, warn, error
LOG_LEVEL=info

# Porta interna do Next.js (nao alterar — o Caddy faz o proxy)
PORT=3000


# ═══════════════════════════════════════════════════════════════════════════════
# 2. DATABASE — PostgreSQL com PostGIS
# ═══════════════════════════════════════════════════════════════════════════════
# Em producao, recomenda-se usar um banco gerenciado (RDS, Cloud SQL, etc.).
# Se usar o container local (postgres), a senha e resolvida via Docker Secret.
#
# NOTA: ${POSTGRES_PASSWORD} e interpolacao do Docker Compose para nao dar
# warning. O valor REAL vem de ./secrets/postgres_password.secret via entrypoint.

POSTGRES_USER=severinno
POSTGRES_PASSWORD=<MUDE_AQUI>
POSTGRES_DB=severinno

# URL de conexao via PgBouncer (pooler) — usada pelo Prisma em runtime
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}

# URL direta ao PostgreSQL (sem pooler) — usada pelo Prisma para migrations
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Senha do PostgreSQL (tambem usada como fallback se Docker Secret falhar)
# Deve ter o MESMO valor de POSTGRES_PASSWORD
DB_PASSWORD=<MESMO_VALOR_DE_POSTGRES_PASSWORD>


# ═══════════════════════════════════════════════════════════════════════════════
# 3. CACHE — Redis
# ═══════════════════════════════════════════════════════════════════════════════
# NOTA: Em producao (docker-compose), o REDIS_URL e hardcoded como
# redis://redis:6379 diretamente no servico. O valor abaixo e usado
# pelo app quando roda fora do Docker (next dev).

REDIS_URL=redis://redis:6379


# ═══════════════════════════════════════════════════════════════════════════════
# 4. QUEUE — RabbitMQ (Message Broker)
# ═══════════════════════════════════════════════════════════════════════════════
# Necessario para workers de email, notificacao e search-index.
# ${RABBITMQ_PASS} e resolvida via Docker Secret (./secrets/rabbitmq_pass.secret)

RABBITMQ_USER=severinno
RABBITMQ_PASS=<MUDE_AQUI>
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672


# ═══════════════════════════════════════════════════════════════════════════════
# 5. STORAGE — S3-compatible (MinIO / Cloudflare R2 / AWS S3)
# ═══════════════════════════════════════════════════════════════════════════════
# S3_SECRET_KEY e resolvida via Docker Secret (./secrets/s3_secret_key.secret).
# ${S3_SECRET_KEY} abaixo e apenas para interpolacao do Docker Compose.

S3_ENDPOINT=http://minio:9000
S3_REGION=auto
S3_ACCESS_KEY=<MUDE_AQUI>
S3_SECRET_KEY=<MUDE_AQUI>
S3_BUCKET=severinno-uploads

# URL publica para acessar arquivos (se diferente do S3_ENDPOINT)
# Ex: https://cdn.severinno.com.br
S3_PUBLIC_URL=

# URL base para uploads no frontend (default: /api/uploads)
NEXT_PUBLIC_UPLOADS_BASE_URL=/api/uploads

# Tamanho maximo de upload em bytes (default: 10MB = 10485760)
MAX_UPLOAD_SIZE=10485760


# ═══════════════════════════════════════════════════════════════════════════════
# 6. REALTIME — WebSocket (Socket.io)
# ═══════════════════════════════════════════════════════════════════════════════
# REALTIME_URL = URL interna (dentro da rede Docker, http://)
# NEXT_PUBLIC_WS_URL = URL externa (exposta ao navegador, wss://)

REALTIME_URL=http://realtime:3003
NEXT_PUBLIC_WS_URL=wss://severinno.com.br


# ═══════════════════════════════════════════════════════════════════════════════
# 7. SEARCH — OpenSearch (Full-text search)
# ═══════════════════════════════════════════════════════════════════════════════

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════════
# 8. ROUTING — OSRM (Open Source Routing Machine)
# ═══════════════════════════════════════════════════════════════════════════════

OSRM_BASE_URL=http://osrm:5000


# ═══════════════════════════════════════════════════════════════════════════════
# 9. WEB PUSH (VAPID) — Notificacoes Push no Navegador
# ═══════════════════════════════════════════════════════════════════════════════
# Gerar: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY e resolvida via Docker Secret (./secrets/vapid_private_key.secret)

NEXT_PUBLIC_VAPID_PUBLIC_KEY=<GERAR_COM_NPX_WEB_PUSH>
VAPID_PUBLIC_KEY=<MESMA_CHAVE_DA_NEXT_PUBLIC_VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<GERAR_COM_NPX_WEB_PUSH>
VAPID_SUBJECT=mailto:admin@severinno.com.br


# ═══════════════════════════════════════════════════════════════════════════════
# 10. SMTP — Email (SendGrid / Mailgun / SES / SMTP proprio)
# ═══════════════════════════════════════════════════════════════════════════════
# SMTP_PASS e resolvida via Docker Secret (./secrets/smtp_pass.secret)
# ${SMTP_PASS} abaixo e apenas para interpolacao do Docker Compose.

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=<MUDE_AQUI>
SMTP_FROM=noreply@severinno.com.br


# ═══════════════════════════════════════════════════════════════════════════════
# 11. PAYMENTS — Lytex (Gateway de Pagamento)
# ═══════════════════════════════════════════════════════════════════════════════
# LYTEX_CLIENT_SECRET e resolvido via Docker Secret
# (./secrets/lytex_client_secret.secret)

LYTEX_ENV=production
LYTEX_CLIENT_ID=<MUDE_AQUI>
LYTEX_CLIENT_SECRET=<MUDE_AQUI>
LYTEX_API_URL=https://api.lytex.com.br/v1
LYTEX_BASE_URL=https://pay.lytex.com.br
PAYMENT_WEBHOOK_SECRET=<MUDE_AQUI>


# ═══════════════════════════════════════════════════════════════════════════════
# 12. WHATSAPP — Evolution API
# ═══════════════════════════════════════════════════════════════════════════════

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=severinno


# ═══════════════════════════════════════════════════════════════════════════════
# 13. ERROR MONITORING — GlitchTip / Sentry
# ═══════════════════════════════════════════════════════════════════════════════
# DSN publico (exposto ao frontend - NEXT_PUBLIC_)
# DSN interno (server-side - sem prefixo)

NEXT_PUBLIC_GLITCHTIP_DSN=
GLITCHTIP_DSN=
GLITCHTIP_INTERNAL_URL=http://glitchtip-web:8000

# Legacy Sentry (fallback se nao usar GlitchTip self-hosted)
SENTRY_DSN=
SENTRY_RELEASE=v0.4.0
NEXT_PUBLIC_SENTRY_DSN=


# ═══════════════════════════════════════════════════════════════════════════════
# 14. CRON — Agendamento de tarefas automatizadas
# ═══════════════════════════════════════════════════════════════════════════════
# CRON_SECRET e resolvido via Docker Secret (./secrets/cron_secret.secret).
# Usado para autenticar chamadas de cron jobs externos (ex: push agendado).

CRON_SECRET=<MUDE_AQUI>


# ═══════════════════════════════════════════════════════════════════════════════
# 15. SEARCH INDEX — Workers (polling e batch)
# ═══════════════════════════════════════════════════════════════════════════════

POLL_INTERVAL_MS=5000
BATCH_SIZE=50


# ═══════════════════════════════════════════════════════════════════════════════
# 16. SENTRY — CI/CD (usado no build Docker pelo GitHub Actions)
# ═══════════════════════════════════════════════════════════════════════════════
# Estas variaveis sao usadas APENAS no build do Docker (GitHub Actions),
# nao em runtime. Configuradas como Secrets do GitHub.

SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. Secrets gerenciados via Docker Secrets:
#    Os valores abaixo sao lidos de /run/secrets/ dentro do container
#    (NUNCA passados via .env.production). As entradas aqui sao apenas
#    para interpolacao do Docker Compose nao reclamar:
#
#    ./secrets/.secret          Uso
#    ─────────────────────────────────────────────────────
#    postgres_password.secret   POSTGRES_PASSWORD
#    session_secret.secret      SESSION_SECRET
#    s3_secret_key.secret       S3_SECRET_KEY
#    rabbitmq_pass.secret       RABBITMQ_PASS
#    vapid_private_key.secret   VAPID_PRIVATE_KEY
#    smtp_pass.secret           SMTP_PASS
#    cron_secret.secret         CRON_SECRET
#    lytex_client_secret.secret LYTEX_CLIENT_SECRET
#    evolution_api_key.secret   EVOLUTION_API_KEY
#    glitchtip_db_password.secret    GLITCHTIP_DB_PASSWORD
#    glitchtip_s3_secret_key.secret  GLITCHTIP_S3_SECRET_KEY
#
# 2. Variaveis do GlitchTip ficam em .env.glitchtip separado:
#    cp .env.glitchtip.example .env.glitchtip
#    docker compose --profile glitchtip --env-file .env.glitchtip up -d
#
# 3. Para gerar .secret files a partir dos templates:
#    for f in secrets/*.example; do
#      cp "$f" "${f%.example}"
#    done
#    # Depois edite cada .secret com o valor real
#
# 4. Para verificar se todas as variaveis estao definidas:
#    docker compose -f docker-compose.prod.yml config 2>&1 | head -20
# =============================================================================
