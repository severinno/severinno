// Severinno Marketplace SaaS — Prisma schema
// Stack: PostgreSQL 16 + PostGIS (via Prisma `postgresql` provider).
// Enum-like fields are `String` with a comment listing allowed values;
// validation is enforced at runtime via Zod (see src/lib/validators.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER — base account for CLIENT | PROVIDER | ADMIN
// ============================================================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  // role: "CLIENT" | "PROVIDER" | "ADMIN"
  role         String   @default("CLIENT")
  cpfCnpj      String?
  whatsapp     String?
  phone        String?
  avatarUrl    String?
  bio          String?
  coverUrl     String?
  // Geolocation of the provider's operating base (or client home)
  lat          Float?
  lng          Float?
  // Operating radius (km) — providers only; null for clients/admins
  radiusKm     Float?
  // PostGIS spatial geography column — managed via SQL trigger (sync_user_location)
  // READ-ONLY via Prisma: all spatial access uses $queryRaw (see src/lib/postgis.ts)
  location     Unsupported("geography(Point, 4326)")?
  // Brazilian address fields
  cep          String?
  street       String?
  number       String?
  complement   String?
  district     String?
  city         String?
  state        String?
  slug         String?  @unique
  verified     Boolean  @default(false)
  active       Boolean  @default(true)
  deletedAt    DateTime?
  // Denormalized fields for performance (see migration SQL for sync triggers)
  avgRating    Float    @default(0)
  reviewCount  Int      @default(0)
  favoriteCount Int     @default(0)
  // Lytex Pagamentos recipient ID for split payments
  lytexRecipientId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  services           Service[]
  availability       ProviderAvailability[]
  dateBlocks         DateBlock[]
  quotesAsClient     QuoteRequest[]   @relation("QuoteRequestClient")
  quotesAsProvider   QuoteRequest[]   @relation("QuoteRequestProvider")
  resetTokens        ResetToken[]
  quoteItems         QuoteItem[]
  bookingsAsClient   Booking[]        @relation("BookingClient")
  bookingsAsProvider Booking[]        @relation("BookingProvider")
  reviewsGiven       Review[]         @relation("ReviewClient")
  reviewsReceived    Review[]         @relation("ReviewProvider")
  favorites          Favorite[]       @relation("FavoriteClient")
  favoritedBy        Favorite[]       @relation("FavoriteProvider")
  messagesFrom       Message[]        @relation("MessageFrom")
  messagesTo         Message[]        @relation("MessageTo")
  notifications      Notification[]
  settings           Setting[]
  pushSubscriptions  PushSubscription[]
  walletTransactions  WalletTransaction[]
  notificationPreferences NotificationPreference[]
  settlementProviders ProviderSettlement[]
  pushSendLogs        PushSendLog[]
  pushAnalytics      PushAnalytics[]

  @@index([role, active, verified])
  @@index([city])
  @@index([city, active, verified])
  @@index([lat, lng])
}

// ============================================================================
// CATEGORY — 3-level tree (pai → filha → subcategoria)
// ============================================================================
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  description String?  // SEO description for category pages
  level       Int      @default(0) // 0=pai, 1=filha, 2=subcategoria
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  search_vector Unsupported("tsvector")?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  services Service[]

  @@index([parentId])
  @@index([slug])
  @@index([level])
}

// ============================================================================
// SERVICE — provider's offering under a subcategoria
// ============================================================================
model Service {
  id          String   @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String
  basePrice   Float
  // unit: "UNIDADE" | "METRO_LINEAR" | "METRO_QUADRADO" | "METRO_CUBICO"
  unit        String   @default("UNIDADE")
  // photos: JSON array of url strings (max 4)
  photos      Json     @default("[]")
  // duration in minutes (e.g. 60, 120, 180)
  duration    Int?
  search_vector Unsupported("tsvector")?
  active      Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider  User       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews   Review[]
  quoteItems QuoteItem[]
  bookings  Booking[]

  @@index([providerId])
  @@index([categoryId])
  @@index([active])
  @@index([categoryId, active])
}

// ============================================================================
// PROVIDER AVAILABILITY — weekly time windows
// ============================================================================
model ProviderAvailability {
  id         String  @id @default(cuid())
  providerId String
  dayOfWeek  Int     // 0=Sunday ... 6=Saturday
  startTime  String  // "HH:mm"
  endTime    String  // "HH:mm"
  active     Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([dayOfWeek])
}

// ============================================================================
// QUOTE REQUEST — client asks one or more providers for prices
// ============================================================================
model QuoteRequest {
  id         String   @id @default(cuid())
  clientId   String
  providerId String   // primary provider
  // status: "PENDING" | "RESPONDED" | "APPROVED" | "REJECTED" | "EXPIRED"
  status     String   @default("PENDING")
  address    String
  cep        String
  lat        Float
  lng        Float
  // PostGIS spatial column — managed via SQL trigger (sync_quoterequest_location)
  // READ-ONLY via Prisma: all spatial access uses $queryRaw (see src/lib/postgis.ts)
  location     Unsupported("geography(Point, 4326)")?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User        @relation("QuoteRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User        @relation("QuoteRequestProvider", fields: [providerId], references: [id], onDelete: Cascade)
  items    QuoteItem[]
  bookings Booking[] @relation("BookingQuote")

  @@index([clientId])
  @@index([providerId])
  @@index([status])
}

model QuoteItem {
  id           String   @id @default(cuid())
  requestId    String
  providerId   String
  serviceId    String
  description  String
  quantity     Float
  // unit: "UNIDADE" | "METRO_LINEAR" | "METRO_QUADRADO" | "METRO_CUBICO"
  unit         String   @default("UNIDADE")
  photos       Json     @default("[]")
  price        Float?   // provider's offer
  providerNote String?
  // status: "PENDING" | "QUOTED" | "ACCEPTED" | "REJECTED"
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  request  QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([providerId])
  @@index([serviceId])
}

// ============================================================================
// BOOKING — scheduled service execution
// ============================================================================
model Booking {
  id            String   @id @default(cuid())
  clientId      String
  providerId    String
  serviceId     String
  scheduledAt   DateTime
  // status: "PENDING" | "CONFIRMED" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  status        String   @default("PENDING")
  address       String
  cep           String
  lat           Float
  lng           Float
  // PostGIS spatial column — managed via SQL trigger (sync_booking_location)
  // READ-ONLY via Prisma: all spatial access uses $queryRaw (see src/lib/postgis.ts)
  location     Unsupported("geography(Point, 4326)")?
  amount        Float
  // paymentMethod: "CARD" | "PIX"
  paymentMethod String   @default("PIX")
  // paymentStatus: "PENDING" | "PAID" | "REFUNDED"
  paymentStatus String   @default("PENDING")
  notes         String?
  // Quote request that originated this booking
  quoteId       String?  @unique
  // Completion confirmation PIN code
  completionPin String?
  // Timestamp for automated reminders
  reminderSentAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client   User        @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User        @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  service  Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quote    QuoteRequest? @relation("BookingQuote", fields: [quoteId], references: [id], onDelete: SetNull)
  reviews  Review[]
  payment  Payment?
  pushAnalytics PushAnalytics[]

  @@index([clientId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
  @@index([providerId, status, scheduledAt])
  @@index([clientId, status, scheduledAt])
}

// ============================================================================
// REVIEW — one per booking, by client about provider
// ============================================================================
model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  clientId   String
  providerId String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client    User    @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider  User    @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId String?

  @@index([providerId])
  @@index([providerId, createdAt])
  @@index([clientId])
  @@index([rating])
}

// ============================================================================
// FAVORITE — client bookmarks provider
// ============================================================================
model Favorite {
  id         String   @id @default(cuid())
  clientId   String
  providerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User @relation("FavoriteClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User @relation("FavoriteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([clientId, providerId])
  @@index([providerId])
}

// ============================================================================
// MESSAGE — direct messaging between users (optionally tied to a booking)
// ============================================================================
model Message {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  content   String
  read      Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toUser   User @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([fromId, toId, createdAt])
  @@index([bookingId])
  @@index([read])
}

// ============================================================================
// NOTIFICATION — in-app notification center
// ============================================================================
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // e.g. "BOOKING_CONFIRMED", "QUOTE_RECEIVED", "MESSAGE"
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([read])
}

// ============================================================================
// PAYMENT — one per booking
// ============================================================================
model Payment {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  amount        Float
  // method: "CARD" | "PIX"
  method        String   @default("PIX")
  // status: "PENDING" | "PAID" | "REFUNDED"
  status        String   @default("PENDING")
  transactionId String?
  // Lytex Pagamentos integration fields
  lytexId       String?  @unique // ID da cobrança no Lytex
  lytexStatus   String?          // Status no Lytex (pending|waitingPayment|paid|canceled|refunded|expired|failed)
  qrCode        String?          // PIX QR Code copia-e-cola
  qrCodeImage   String?          // PIX QR Code image URL
  cardLastDigits String?         // Últimos 4 dígitos do cartão
  cardBrand     String?          // Bandeira do cartão
  installments  Int?             // Número de parcelas
  paidAt        DateTime?        // Data do pagamento efetivo
  lytexRawResponse Json?         // Raw response do Lytex (para debug)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lytexId])
  @@index([lytexStatus])
}

// ============================================================================
// SETTLEMENT PERIOD — automatic settlement cycles (weekly/monthly)
// ============================================================================
model SettlementPeriod {
  id              String   @id @default(cuid())
  // type: "WEEKLY" | "MONTHLY"
  type            String   @default("WEEKLY")
  // status: "PENDING" | "FINALIZED"
  status          String   @default("PENDING")
  startDate       DateTime
  endDate         DateTime
  totalCommission Float    @default(0)
  totalNet        Float    @default(0)
  totalAmount     Float    @default(0)
  providerCount   Int      @default(0)
  transactionCount Int     @default(0)
  notes           String?
  finalizedAt     DateTime?
  finalizedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  providers ProviderSettlement[]

  @@index([status])
  @@index([startDate, endDate])
}

// ============================================================================
// PROVIDER SETTLEMENT — per-provider amounts within a settlement period
// ============================================================================
model ProviderSettlement {
  id              String   @id @default(cuid())
  periodId        String
  providerId      String
  // status: "PENDING" | "PAID"
  status          String   @default("PENDING")
  totalAmount     Float    @default(0)
  commission      Float    @default(0)
  netAmount       Float    @default(0)
  transactionCount Int     @default(0)
  paidAt          DateTime?
  paidBy          String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  period   SettlementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  provider User             @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([periodId, providerId])
  @@index([periodId])
  @@index([providerId])
  @@index([status])
}

// ============================================================================
// SETTING — admin dynamic config (.env-like editor at runtime)
// ============================================================================
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  createdAt DateTime @default(now())
  updatedBy String?
  user      User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}

// ============================================================================
// RESET TOKEN — password reset tokens
// ============================================================================
model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================================================
// DATE BLOCK — provider blocks specific dates (vacations, holidays)
// ============================================================================
model DateBlock {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime @db.Date
  allDay     Boolean  @default(true)
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([date])
  @@unique([providerId, date, startTime, endTime])
}

// ============================================================================
// PUSH SUBSCRIPTION — Web Push notification subscriptions
// ============================================================================
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// SCHEDULED PUSH NOTIFICATION — admin schedules push for future delivery
// ============================================================================
// status: "PENDING" | "SENT" | "CANCELLED" | "FAILED"
model ScheduledPushNotification {
  id          String   @id @default(cuid())
  scheduledAt DateTime
  status      String   @default("PENDING")
  title       String
  body        String?
  pushUrl     String   @default("/")
  type        String   @default("ADMIN_MANUAL")
  userIds     Json     @default("[]")
  // Results after sending
  sentCount   Int      @default(0)
  errorCount  Int      @default(0)
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Recurring schedule reference (if this was generated by a recurring rule)
  recurringId String?

  @@index([status])
  @@index([scheduledAt])
  @@index([recurringId])
}

// ============================================================================
// RECURRING PUSH SCHEDULE — notificações push que se repetem
// ============================================================================
// Permite criar notificações push que disparam automaticamente em intervalos
// regulares: diário, semanal, mensal.
//
// frequency: "daily" | "weekly" | "monthly"
//   daily:   dispara todo dia no horário definido em time
//   weekly:  dispara toda semana no dia da semana (dayOfWeek) no horário
//   monthly: dispara todo mês no dia (dayOfMonth) no horário
//
// time: "HH:mm" no formato 24h (ex: "09:00", "18:30")
// dayOfWeek: 0=domingo ... 6=sábado (apenas para frequency=weekly)
// dayOfMonth: 1..31 (apenas para frequency=monthly)
//
// status: "ACTIVE" | "PAUSED" | "ARCHIVED"
//
// O cron job /api/cron/push-scheduled:
//   1. Busca todos os ACTIVE
//   2. Para cada um, verifica se já deve disparar hoje
//   3. Cria um ScheduledPushNotification avulso e dispara
//   4. Atualiza lastSentAt
model RecurringPushSchedule {
  id          String   @id @default(cuid())
  // Recurrence config
  frequency   String   // "daily" | "weekly" | "monthly"
  time        String   // "HH:mm"
  dayOfWeek   Int?     // 0-6, apenas para weekly
  dayOfMonth  Int?     // 1-31, apenas para monthly
  timezone    String   @default("America/Sao_Paulo")
  // Content
  title       String
  body        String?
  pushUrl     String   @default("/")
  type        String   @default("RECURRING")
  targetRoles Json     @default("[\"CLIENT\",\"PROVIDER\"]")
  // Filters (opcional) — filtra usuários por critérios
  filterCity  String?  // Cidade específica (opcional)
  // Status
  status      String   @default("ACTIVE")
  lastSentAt  DateTime?
  totalSent   Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, frequency])
  @@index([status, time])
}

// ============================================================================
// EVENT WEBHOOK — configurable auto push triggers for system events
// ============================================================================
// Stores rules that define when and to whom to send automatic push notifications
// when system events (booking created, review received, etc.) occur.
// event: "booking.created" | "booking.confirmed" | "booking.cancelled" |
//        "booking.completed" | "review.created" | "quote.received" |
//        "quote.responded" | "payment.confirmed" | "message.sent" |
//        "provider.registered"
// targetRoles: JSON array of roles that receive the notification
//   e.g. ["PROVIDER", "CLIENT"]
model EventWebhook {
  id          String   @id @default(cuid())
  event       String
  title       String   // supports {{variables}}
  body        String?  // supports {{variables}}
  pushUrl     String   @default("/")
  targetRoles Json     @default("[\"PROVIDER\"]")
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executionLogs WebhookExecutionLog[]

  @@unique([event, title])
  @@index([event, active])
}

// ============================================================================
// PUSH ANALYTICS — delivery metrics for push notifications
// ============================================================================
// Registra cada tentativa de envio de push para métricas de entrega.
// source: "manual" | "auto" | "webhook" | "scheduled" | "cron"
// status: "sent" | "delivered" | "clicked" | "bounced" | "failed"
// action: "accept" | "reject" | "view" (preenchido quando o usuário clica
//   em um botão de ação na notificação push)
// actionResult: resultado da ação ("CONFIRMED", "CANCELLED", etc.)
model PushAnalytics {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String?
  type      String   @default("ADMIN_MANUAL")
  source    String   @default("manual")
  status    String   @default("sent")
  // Device info
  deviceCount Int    @default(0)
  // Timing
  latencyMs    Int?
  clickedAt    DateTime?
  errorMessage String?
  // Action tracking — preenchido quando o usuário executa uma ação
  // na notificação push (ex: Aceitar, Recusar, Visualizar)
  action       String?  // "accept" | "reject" | "view"
  actionResult String?  // resultado: "CONFIRMED" | "CANCELLED" | "viewed"
  bookingId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@index([source])
  @@index([action])
  @@index([bookingId])
}

// ============================================================================
// WALLET TRANSACTION — provider withdrawal history
// ============================================================================
model WalletTransaction {
  id          String   @id @default(cuid())
  providerId  String
  amount      Float
  status      String   @default("pending")  // "pending" | "completed" | "failed" | "cancelled"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
}

// ============================================================================
// NOTIFICATION PREFERENCE — per-user per-type notification toggles
// ============================================================================
model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String
  type           String
  pushEnabled    Boolean @default(true)
  emailEnabled   Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  soundEnabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ============================================================================
// PUSH SEND LOG — audit trail for push notification batches
// ============================================================================
// Registra cada operação de envio de push (manual, agendado, recorrente)
// para auditoria: quem enviou, quando, para quantos, resultado.
//
// action: "manual_send" | "manual_schedule" | "scheduled_send" | "recurring_send"
//
// Metadata armazena detalhes adicionais como:
//   - scheduleId / recurringId (se aplicável)
//   - lista parcial de userIds (primeiros N para amostra)
//   - erros individuais (se houver)
//   - tempo total de processamento
model PushSendLog {
  id              String   @id @default(cuid())
  adminId         String
  action          String   // "manual_send" | "manual_schedule" | "scheduled_send" | "recurring_send"
  title           String
  body            String?
  pushUrl         String   @default("/")
  notificationType String  @default("ADMIN_MANUAL")
  // Results
  recipientCount  Int      @default(0)
  sentCount       Int      @default(0)
  errorCount      Int      @default(0)
  directPushCount Int      @default(0)  // fallback direto quando RabbitMQ indisponível
  metadata        Json?    // detalhes adicionais (scheduleId, recurringId, sample userIds, etc.)
  createdAt       DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@index([notificationType])
}

// ============================================================================
// WEBHOOK EXECUTION LOG — audit trail for event webhook firings
// ============================================================================
// Registra cada execução de uma regra de webhook de evento.
// Criado automaticamente pelo event-hub.ts fireEvent() sempre que
// um evento do sistema dispara notificações push via webhook.
//
// status: "success" | "partial" | "failed"
//   success  → todos os sends foram bem-sucedidos
//   partial  → alguns sends falharam
//   failed   → todos os sends falharam
model WebhookExecutionLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String   // denormalized: "booking.created", etc.
  title        String   // template rendered (denormalized)
  body         String?
  pushUrl      String?
  targetRoles  Json?    // snapshot of targetRoles at execution time

  webhook EventWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  // Results
  usersFound   Int      @default(0)   // total users matching role + scoped filters
  usersSent    Int      @default(0)   // successfully sent
  usersFailed  Int      @default(0)   // push failed
  errorMessage String?  // primeiro erro (se houver)
  status       String   @default("success")
  // Metadata
  context      Json?    // snapshot of EventContext variables
  executionMs  Int?     // total execution time in ms
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@index([status])
}

// ============================================================================
// SEARCH REINDEX QUEUE — async queue for OpenSearch reindexing
// ============================================================================
model SearchReindexQueue {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}
