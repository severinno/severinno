generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS (PostgreSQL Native)
// ============================================================================

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  PIX
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  HELD
  PAID
  REFUNDED
  FAILED
}

enum QuoteStatus {
  PENDING
  RESPONDED
  APPROVED
  REJECTED
  EXPIRED
}

enum QuoteItemStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
}

enum ServiceUnit {
  UNIDADE
  METRO_LINEAR
  METRO_QUADRADO
  METRO_CUBICO
  HORA
}

// ============================================================================
// USER — base account for CLIENT | PROVIDER | ADMIN
// ============================================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role      @default(CLIENT)
  cpfCnpj          String?
  whatsapp         String?
  phone            String?
  avatarUrl        String?
  bio              String?
  coverUrl         String?
  lat              Float?
  lng              Float?
  location         Unsupported("geography(Point, 4326)")?
  radiusKm         Float?
  cep              String?
  street           String?
  number           String?
  complement       String?
  district         String?
  city             String?
  state            String?
  slug             String?   @unique
  soundEnabled     Boolean   @default(true)
  vibrateEnabled   Boolean   @default(true)
  verified         Boolean   @default(false)
  active           Boolean   @default(true)
  deletedAt        DateTime?
  avgRating        Float     @default(0)
  reviewCount      Int       @default(0)
  favoriteCount    Int       @default(0)
  lytexRecipientId String?
  // Identity verification (KYC)
  identityDocUrl    String?
  identitySelfieUrl String?
  identityVerifiedAt DateTime?
  identityStatus    String?
  // Advanced Geolocation
  servicePolygon    Json?
  travelFeePolicy   Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  services           Service[]
  availability       ProviderAvailability[]
  quotesAsClient     QuoteRequest[]         @relation("QuoteRequestClient")
  quotesAsProvider   QuoteRequest[]         @relation("QuoteRequestProvider")
  quoteItems         QuoteItem[]
  bookingsAsClient   Booking[]              @relation("BookingClient")
  bookingsAsProvider Booking[]              @relation("BookingProvider")
  reviewsGiven       Review[]               @relation("ReviewClient")
  reviewsReceived    Review[]               @relation("ReviewProvider")
  favorites          Favorite[]             @relation("FavoriteClient")
  favoritedBy        Favorite[]             @relation("FavoriteProvider")
  messagesFrom       Message[]              @relation("MessageFrom")
  messagesTo         Message[]              @relation("MessageTo")
  notifications      Notification[]
  settings           Setting[]
  dateBlocks         DateBlock[]
  walletTransactions WalletTransaction[]
  pushSubscriptions  PushSubscription[]
  resetTokens        ResetToken[]
  notificationPrefs  NotificationPreference[]
  pushAnalytics      PushAnalytics[]
  pushSendLogs       PushSendLog[]
  scheduledPushes    ScheduledPushNotification[]
  settlements        ProviderSettlement[]

  @@index([role, active, verified])
  @@index([city])
  @@index([city, active, verified])
  @@index([lat, lng])
  @@index([location], type: Gist)
}

// ============================================================================
// CATEGORY — 3-level tree (pai → filha → subcategoria)
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  parentId    String?
  description String?
  level       Int       @default(0)
  icon        String?
  order       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  services Service[]

  @@index([parentId])
  @@index([slug])
  @@index([level])
}

// ============================================================================
// SERVICE — provider's offering under a subcategoria
// ============================================================================

model Service {
  id          String      @id @default(cuid())
  providerId  String
  categoryId  String
  title       String
  description String
  basePrice   Float
  unit        ServiceUnit @default(UNIDADE)
  photos      Json        @default("[]")
  duration    Int?
  active      Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  provider   User        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews    Review[]
  quoteItems QuoteItem[]
  bookings   Booking[]

  @@index([providerId])
  @@index([categoryId])
  @@index([categoryId, active])
  @@index([active])
}

// ============================================================================
// DATE BLOCK — provider blocks specific dates
// ============================================================================

model DateBlock {
  id         String   @id @default(cuid())
  providerId String
  date       DateTime @db.Date
  allDay     Boolean  @default(true)
  startTime  String?
  endTime    String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date, startTime, endTime])
  @@index([providerId])
  @@index([date])
}

// ============================================================================
// PROVIDER AVAILABILITY — weekly time windows
// ============================================================================

model ProviderAvailability {
  id         String   @id @default(cuid())
  providerId String
  dayOfWeek  Int
  startTime  String
  endTime    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([dayOfWeek])
}

// ============================================================================
// QUOTE REQUEST — client asks one or more providers for prices
// ============================================================================

model QuoteRequest {
  id         String      @id @default(cuid())
  clientId   String
  providerId String
  status     QuoteStatus @default(PENDING)
  address    String
  cep        String
  lat        Float
  lng        Float
  location   Unsupported("geography(Point, 4326)")?
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  client   User        @relation("QuoteRequestClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User        @relation("QuoteRequestProvider", fields: [providerId], references: [id], onDelete: Cascade)
  items    QuoteItem[]
  bookings Booking[]

  @@index([clientId])
  @@index([providerId])
  @@index([status])
}

model QuoteItem {
  id           String          @id @default(cuid())
  requestId    String
  providerId   String
  serviceId    String
  description  String
  quantity     Float
  unit         ServiceUnit     @default(UNIDADE)
  photos       Json            @default("[]")
  price        Float?
  providerNote String?
  status       QuoteItemStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  request  QuoteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider User         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([providerId])
  @@index([serviceId])
}

// ============================================================================
// BOOKING — scheduled service execution
// ============================================================================

model Booking {
  id                String        @id @default(cuid())
  clientId          String
  providerId        String
  serviceId         String
  quoteId           String?       @unique
  scheduledAt       DateTime
  status            BookingStatus @default(PENDING)
  address           String
  cep               String
  lat               Float
  lng               Float
  location          Unsupported("geography(Point, 4326)")?
  amount            Float
  paymentMethod     PaymentMethod @default(PIX)
  paymentStatus     PaymentStatus @default(PENDING)
  notes             String?
  completionPin     String?
  reminderSentAt    DateTime?
  deletedAt         DateTime?
  escrowReleasedAt  DateTime?
  escrowDisputeReason String?
  beforePhotos      Json          @default("[]")
  afterPhotos       Json          @default("[]")
  completionNote    String?
  geofenceAlertSentAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  client   User     @relation("BookingClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User     @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  quote    QuoteRequest? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  reviews  Review[]
  payment  Payment?
  disputes Dispute[]

  @@index([clientId])
  @@index([providerId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
  @@index([paymentStatus])
  @@index([providerId, status, scheduledAt])
  @@index([clientId, status, scheduledAt])
}

// ============================================================================
// REVIEW — one per booking, by client about provider
// ============================================================================

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  clientId   String
  providerId String
  rating     Int
  comment    String?
  serviceId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client    User     @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider  User     @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([providerId, createdAt])
  @@index([clientId])
  @@index([rating])
}

// ============================================================================
// FAVORITE — client bookmarks provider
// ============================================================================

model Favorite {
  id         String   @id @default(cuid())
  clientId   String
  providerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   User @relation("FavoriteClient", fields: [clientId], references: [id], onDelete: Cascade)
  provider User @relation("FavoriteProvider", fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([clientId, providerId])
  @@index([providerId])
}

// ============================================================================
// MESSAGE — direct messaging between users
// ============================================================================

model Message {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  content   String
  read      Boolean  @default(false)
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toUser   User @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
  @@index([fromId, toId, createdAt])
  @@index([bookingId])
  @@index([read])
  @@index([toId, read])
}

// ============================================================================
// NOTIFICATION — in-app notification center
// ============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([read])
}

// ============================================================================
// PAYMENT — one per booking (Lytex integration)
// ============================================================================

model Payment {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  amount          Float
  method          PaymentMethod @default(PIX)
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  lytexId         String?       @unique
  lytexStatus     String?
  qrCode          String?
  qrCodeImage     String?
  cardLastDigits  String?
  cardBrand       String?
  installments    Int?
  paidAt          DateTime?
  lytexRawResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([lytexId])
  @@index([lytexStatus])
}

// ============================================================================
// WALLET TRANSACTION — simulated withdrawals from provider wallet
// ============================================================================

model WalletTransaction {
  id          String   @id @default(cuid())
  providerId  String
  amount      Float
  status      String   @default("pending")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider User @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([providerId, createdAt])
}

// ============================================================================
// SETTING — admin dynamic config
// ============================================================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy String?

  user User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}

// ============================================================================
// RESET TOKEN — password reset
// ============================================================================

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================================================
// PUSH SUBSCRIPTION — Web Push subscriptions
// ============================================================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// SCHEDULED PUSH NOTIFICATION — admin schedules push for future delivery
// ============================================================================

model ScheduledPushNotification {
  id            String   @id @default(cuid())
  scheduledAt   DateTime
  status        String   @default("PENDING")
  title         String
  body          String?
  pushUrl       String   @default("/")
  type          String   @default("ADMIN_MANUAL")
  userIds       Json     @default("[]")
  sentCount     Int      @default(0)
  errorCount    Int      @default(0)
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  recurringId   String?
  recurring     RecurringPushSchedule? @relation(fields: [recurringId], references: [id])
  user          User? @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([recurringId])
}

// ============================================================================
// RECURRING PUSH SCHEDULE — push notifications that repeat
// ============================================================================

model RecurringPushSchedule {
  id          String   @id @default(cuid())
  frequency   String
  time        String
  dayOfWeek   Int?
  dayOfMonth  Int?
  timezone    String   @default("America/Sao_Paulo")
  title       String
  body        String?
  pushUrl     String   @default("/")
  type        String   @default("RECURRING")
  targetRoles Json     @default("[\"CLIENT\",\"PROVIDER\"]")
  filterCity  String?
  status      String   @default("ACTIVE")
  lastSentAt  DateTime?
  totalSent   Int      @default(0)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scheduledPushes ScheduledPushNotification[]

  @@index([status, frequency])
  @@index([status, time])
}

// ============================================================================
// EVENT WEBHOOK — configurable auto push triggers for system events
// ============================================================================

model EventWebhook {
  id          String   @id @default(cuid())
  event       String
  title       String
  body        String?
  pushUrl     String   @default("/")
  targetRoles Json     @default("[\"PROVIDER\"]")
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executionLogs WebhookExecutionLog[]

  @@unique([event, title])
  @@index([event, active])
}

// ============================================================================
// PUSH ANALYTICS — delivery metrics for push notifications
// ============================================================================

model PushAnalytics {
  id           String    @id @default(cuid())
  userId       String
  title        String
  body         String?
  type         String    @default("ADMIN_MANUAL")
  source       String    @default("manual")
  status       String    @default("sent")
  deviceCount  Int       @default(0)
  latencyMs    Int?
  clickedAt    DateTime?
  errorMessage String?
  action       String?
  actionResult String?
  bookingId    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@index([source])
  @@index([action])
  @@index([bookingId])
}

// ============================================================================
// PUSH SEND LOG — audit trail for push notification batches
// ============================================================================

model PushSendLog {
  id               String   @id @default(cuid())
  adminId          String
  action           String
  title            String
  body             String?
  pushUrl          String   @default("/")
  notificationType String   @default("ADMIN_MANUAL")
  recipientCount   Int      @default(0)
  sentCount        Int      @default(0)
  errorCount       Int      @default(0)
  directPushCount  Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@index([notificationType])
}

// ============================================================================
// WEBHOOK EXECUTION LOG — audit trail for event webhook firings
// ============================================================================

model WebhookExecutionLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  title        String
  body         String?
  pushUrl      String?
  targetRoles  Json?
  usersFound   Int      @default(0)
  usersSent    Int      @default(0)
  usersFailed  Int      @default(0)
  errorMessage String?
  status       String   @default("success")
  context      Json?
  executionMs  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  webhook EventWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([event])
  @@index([createdAt])
  @@index([status])
}

// ============================================================================
// NOTIFICATION PREFERENCE — per-user per-type notification toggles
// ============================================================================

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String
  type            String
  pushEnabled     Boolean @default(true)
  emailEnabled    Boolean @default(true)
  whatsappEnabled Boolean @default(true)
  soundEnabled    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// ============================================================================
// SEARCH REINDEX QUEUE — async queue for OpenSearch reindexing
// ============================================================================

model SearchReindexQueue {
  id         BigInt   @id @default(autoincrement())
  entityType String
  entityId   String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

// ============================================================================
// SETTLEMENT PERIOD — batch settlement for providers
// ============================================================================

model SettlementPeriod {
  id                String   @id @default(cuid())
  type              String   @default("WEEKLY")
  status            String   @default("PENDING")
  startDate         DateTime
  endDate           DateTime
  totalCommission   Float    @default(0)
  totalNet          Float    @default(0)
  totalAmount       Float    @default(0)
  providerCount     Int      @default(0)
  transactionCount  Int      @default(0)
  notes             String?
  finalizedAt       DateTime?
  finalizedBy       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  providers ProviderSettlement[] @relation("SettlementProviders")

  @@index([status])
  @@index([startDate, endDate])
}

model ProviderSettlement {
  id               String   @id @default(cuid())
  periodId         String
  providerId       String
  status           String   @default("PENDING")
  totalAmount      Float    @default(0)
  commission       Float    @default(0)
  netAmount        Float    @default(0)
  transactionCount Int      @default(0)
  paidAt           DateTime?
  paidBy           String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  period   SettlementPeriod @relation("SettlementProviders", fields: [periodId], references: [id], onDelete: Cascade)
  provider User            @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([periodId, providerId])
  @@index([periodId])
  @@index([providerId])
  @@index([status])
}

// ============================================================================
// DISPUTE — escrow dispute for bookings
// ============================================================================

model Dispute {
  id         String    @id @default(cuid())
  bookingId  String
  reason     String
  status     String    @default("OPEN")
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

// ============================================================================
// MV_PROVIDER_STATS — Materialized View (not managed by Prisma migrations)
// ============================================================================

model MvProviderStats {
  providerId            String @id @map("provider_id")
  avgRating             Float  @map("avg_rating")
  reviewCount           Int    @map("review_count")
  completedBookingCount Int    @map("completed_booking_count")
  favoriteCount         Int    @map("favorite_count")

  @@map("mv_provider_stats")
}
