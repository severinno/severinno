# ═══════════════════════════════════════════════════════════════════════════
# Caddyfile — Severinno Marketplace (Produção)
# ═══════════════════════════════════════════════════════════════════════════
# HTTPS automático via Let's Encrypt / ZeroSSL.
# Basta apontar o DNS do domínio para o IP do servidor.
#
# Uso no Docker Compose:
#   - Porta 80  → HTTP (redireciona para HTTPS)
#   - Porta 443 → HTTPS (automático)
#   - Porta 2019 → Admin API (monitoramento interno)
# ═══════════════════════════════════════════════════════════════════════════

{
  # ── Global settings ──────────────────────────────────────────────────
  # Email obrigatório para registro ACME (Let's Encrypt / ZeroSSL)
  email {$ACME_EMAIL:admin@severinno.com.br}

  # Admin API — apenas para monitoramento interno via Docker network
  admin 0.0.0.0:2019

  # OCSP stapling: mantém certificados frescos sem viagens extras de ida/volta
  # (medido em 28/09/2026: `ocsp_stapling` foi REMOVIDO do Caddy 2.8+ — a
  # stapling passou a ser automática/incondicional, e a diretiva crasha o
  # container no parse: `invalid argument 'on'`)

  # ZeroSSL como CA (mais confiável que Let's Encrypt em alguns cenários)
  # Remova esta linha para usar Let's Encrypt
  acme_ca https://acme.zerossl.com/v2/DV90

  # Armazenamento persistente de certificados (volume Docker caddy_data).
  # FIX (2026-10-02): a forma `storage file:///data/caddy` não é um módulo
  # registrado — crasha o parse do Caddy inteiro no boot (provado com
  # `caddy validate` na imagem caddy:2-alpine). A forma correta do Caddyfile
  # é o módulo `file_system` + caminho.
  storage file_system /data/caddy
}

# ═══════════════════════════════════════════════════════════════════════════
# DOMÍNIO PRINCIPAL — {$DOMAIN:severinno.com.br}
# ═══════════════════════════════════════════════════════════════════════════

{$DOMAIN:severinno.com.br}, www.{$DOMAIN:severinno.com.br} {
  # ── Compressão (zstd prioritário, fallback gzip) ──────────────────────
  encode zstd gzip

  # ── Security Headers ─────────────────────────────────────────────────
  header {
    # HSTS: força HTTPS por 1 ano, incluindo subdomínios
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Previne MIME sniffing
    X-Content-Type-Options "nosniff"
    # Previne clickjacking
    X-Frame-Options "DENY"
    # Referrer policy — envia apenas a origem em cross-origin
    Referrer-Policy "strict-origin-when-cross-origin"
    # Previne XSS em navegadores antigos (IE/Edge legacy)
    X-XSS-Protection "1; mode=block"
    # Permissions policy — desabilita recursos não utilizados
    Permissions-Policy "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
    # Remove headers que revelam tecnologia do servidor
    -Server
    -X-Powered-By
    -X-AspNet-Version
  }

  # ── Content Security Policy ──────────────────────────────────────────
  # NOTA (hardening 09/2026): a CSP AUTORITATIVA é a do proxy.ts (com nonce
  # por-request + strict-dynamic). O header aqui NÃO define script-src com
  # 'unsafe-inline' nem unpkg — quando este bloco define CSP, ele SOBRESCREVE
  # a do app e destruiria os nonces. Portanto este header NÃO inclui CSP:
  # o proxy.ts do Next.js é a fonte única (ver src/lib/csp.ts).
  # Se um dia for preciso mover a CSP para cá, o Caddy precisa repassar o
  # header x-nonce do upstream e montar o nonce dinâmico (não suportado
  # nativamente) — mantenha no proxy.ts.

  # ── Healthcheck interno (Docker HEALTHCHECK) ────────────────────────
  # Responde 200 OK em /health para o Docker verificar se o Caddy está
  # funcionando. Usa a porta 80 (principal) em vez de uma separada.
  # NOTA: /health != /api/health (que vai para o Next.js).
  handle /health {
    respond "OK" 200 {
      close
    }
  }

  # ── Rate limiting (prevenção básica contra abuso) ────────────────────
  # RESOLVIDO (2026-10-02): `rate_limit` exige o plugin mholt/caddy-ratelimit
  # — o serviço caddy do compose agora builda a imagem custom
  # (Dockerfile.caddy, versões pinadas). Prova: caddy validate do arquivo
  # INTEIRO = "Valid configuration" na imagem custom.
  rate_limit {
    zone dynamic {
      key {remote_host}
      events 100
      window 1m
    }
  }

  # ── WebSocket (Socket.io) — Caddy detecta upgrade automático ─────────
  handle_path /socket.io/* {
    reverse_proxy realtime:3003 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      flush_interval -1
    }
  }

  # ── API e App (Next.js) ─────────────────────────────────────────────
  handle {
    reverse_proxy app:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}

      # Health check pass-through (Caddy monitora saúde do backend)
      health_uri /api/health
      health_interval 30s
      health_timeout 5s
      health_status 200

      # Circuit breaker: remove backend do pool após 3 falhas consecutivas
      max_fails 3
      fail_duration 30s
    }
  }

  # ── Access & Error Logs ──────────────────────────────────────────────
  # Formato common log para compatibilidade com fail2ban.
  # Os logs são parseados pelo fail2ban para detectar:
  #   - Força bruta (401/403) via caddy-access jail
  #   - Bots/scanners maliciosos via caddy-badbots jail
  #   - Varredura de diretórios (404) via caddy-404-scan jail
  log {
    output file /var/log/caddy/severinno-access.log {
      roll_size 100mb     # Rotaciona a cada 100MB
      roll_keep 5          # Mantém 5 arquivos rotacionados
      roll_keep_for 720h   # Remove após 30 dias
    }
    # Combined Log Format (CLF + User-Agent) — necessário para fail2ban parsear
    # Formato: <host> - - [date] "method path proto" status size "referrer" "user-agent"
    # O fail2ban precisa deste formato para os filters:
    #   caddy-access  → detecta 401/403 (força bruta)
    #   caddy-badbots → detecta paths sensíveis (.env, wp-admin) e user-agents maliciosos
    #   caddy-404-scan→ detecta varredura de diretórios (muitos 404)
    # RESOLVIDO (2026-10-02): o encoder `transform` (caddyserver/
    # transform-encoder) vem na imagem custom do compose (Dockerfile.caddy).
    # Template explícito (compatível com qualquer versão do Caddy v2):
    format transform "{request>remote_ip} - {request>user_id} [{ts}] \"{request>method} {request>uri} {request>proto}\" {status} {size} \"{request>headers>Referer}\" \"{request>headers>User-Agent}\""
    level INFO
  }

  # ── Error pages (não vazar stack traces para o cliente) ──────────────
  handle_errors {
    @4xx {
      expression {http.error.status_code} >= 400
      expression {http.error.status_code} < 500
    }
    @5xx {
      expression {http.error.status_code} >= 500
    }

    handle @4xx {
      respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
    }
    handle @5xx {
      respond "Service Unavailable" 503
    }
  }
}

# ═════════════════════════════════════════════════════════════════════
# SUBDOMÍNIO — s3 (bucket público de uploads — MinIO self-hosted)
# ═════════════════════════════════════════════════════════════════════
# Serve os objetos do bucket público em path-style: o app monta as URLs como
# {S3_PUBLIC_URL}/{chave} (src/lib/storage.ts; prefixo real dos uploads é
# uploads/ — src/lib/s3.ts) e o reprocess-svg-uploads.ts guarda os SVG
# remediados em quarantine/svg-legacy/.
#
# DEFESA EM PROFUNDIDADE contra SVG armazenado: SVG é XML ativo (<script>,
# onload=, <foreignObject>) e foi REMOVIDO da allowlist de upload
# (src/lib/file-signature.ts, 09/2026) — mas objetos legados anteriores ao
# bloqueio podem existir no bucket (censo/remediação no
# scripts/reprocess-svg-uploads.ts). Mesmo que um SVG escape (legado
# esquecido, falha de upload, vendador), este bloco REJEITA qualquer resposta
# com Content-Type image/svg+xml — o browser nunca o renderiza (403; sem
# MIME sniffing pelo X-Content-Type-Options acima).
#
# Por que matcher de RESPOSTA (handle_response avaliado no header da
# resposta) e não de pedido (path *.svg): a detecção da remediação é PELO
# CONTEÚDO — um .jpg pode ser um SVG renomeado; o que decide é o Content-Type
# que o MinIO vai de fato servir.
#
# Requer DNS de s3.severinno.com.br apontando para este servidor. O domínio
# é placeholder PLANO (não aninhado com {$DOMAIN:...} — placeholders aninhados
# não parseiam; provado com caddy validate: "invalid port"). Para um domínio
# diferente, defina S3_DOMAIN no env do Caddy.
{$S3_DOMAIN:s3.severinno.com.br} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
    -X-Powered-By
  }

  reverse_proxy minio:9000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}

    # Matcher avaliado contra a RESPOSTA do upstream (Caddy 2.7+).
    # TEM de ser declarado DENTRO do reverse_proxy: response matchers têm
    # namespace próprio — um @matcher no nível do site não é visível aqui e o
    # Caddy crasha no boot (provado e2e: "no named response matcher defined
    # with name ..."). Prova de comportamento: SVG servido → 403; PNG → 200.
    @s3_svg_response {
      header Content-Type image/svg+xml
    }

    # Se o MinIO for servir um SVG dos prefixos de upload/quarantine,
    # a resposta é abortada AQUI — nada de SVG chega ao browser.
    handle_response @s3_svg_response {
      respond "Blocked: SVG content is not served from this bucket" 403
    }
  }

  # ── Logs (formato DEFAULT json — o CLF do fail2ban é o log do site
  #    principal; este bloco novo não entra nas jails existentes) ────────
  log {
    output file /var/log/caddy/s3-access.log {
      roll_size 100mb
      roll_keep 5
      roll_keep_for 720h
    }
    level INFO
  }

  handle_errors {
    respond "Service Unavailable" 503
  }
}

# ═══════════════════════════════════════════════════════════════════════════
# SUBDOMÍNIO — GlitchTip (Error Monitoring — Self-hosted Sentry)
# ═══════════════════════════════════════════════════════════════════════════
# Para ativar:
#   1. Aponte glitchtip.severinno.com para o IP do servidor
#   2. Inicie com: docker compose --profile glitchtip --env-file .env.glitchtip up -d
#   3. ./scripts/glitchtip-setup.sh create-admin
#   4. ./scripts/glitchtip-setup.sh create-project
#   5. Copie o DSN para o .env.production
# ═══════════════════════════════════════════════════════════════════════════

glitchtip.{$DOMAIN:severinno.com.br} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    -Server
    -X-Powered-By
  }

  # Limite de 50MB para upload de source maps via GlitchTip
  request_body {
    max_size 52428800
  }

  reverse_proxy glitchtip-web:8000 {
    header_up Host {host}
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
  }

  # ── Logs em Combined Log Format (compatível com fail2ban) ───────────
  log {
    output file /var/log/caddy/glitchtip-access.log {
      roll_size 100mb
      roll_keep 5
      roll_keep_for 720h
    }
    # Combined Log Format para compatibilidade com fail2ban (jail caddy-glitchtip)
    format transform "{request>remote_ip} - {request>user_id} [{ts}] \"{request>method} {request>uri} {request>proto}\" {status} {size} \"{request>headers>Referer}\" \"{request>headers>User-Agent}\""
    level INFO
  }

  # Error handling específico para GlitchTip
  handle_errors {
    @5xx {
      expression {http.error.status_code} >= 500
    }
    handle @5xx {
      respond "GlitchTip temporarily unavailable" 503
    }
  }
}

# ═══════════════════════════════════════════════════════════════════════════
